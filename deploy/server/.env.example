# DRIFT — .env cho server production (dùng với deploy/server/docker-compose.yml).
# Đổi tên thành .env, cùng thư mục với docker-compose.yml, rồi điền. chmod 600 .env. KHÔNG commit file .env.
# Ở đây chỉ để chỗ trống / ví dụ; giá trị thật (mật khẩu, SMTP key) chỉ nằm trong .env trên server.
#
# Sinh giá trị ngẫu nhiên:
#   openssl rand -hex 24       → POSTGRES_PASSWORD, SIGNER_DB_PASSWORD, VAULT_TOKEN
#   openssl rand -base64 32    → API_TOTP_ENC_KEY
# Bốn giá trị đó đặt MỘT LẦN trước lần chạy đầu. Đổi sau khi đã chạy = database / Vault / 2FA không mở được.

# ============================================================================
# 1. Image (build bằng infra/deploy/build-push.sh trên máy dev)
# ============================================================================
# Repo private trên Docker Hub. Server cần `docker login` bằng token Read-only.
DRIFT_IMAGE=docker.io/lthuangiang/drift
# "latest" = bản build gần nhất của mỗi app. Muốn cố định / rollback: điền mã build script in ra, ví dụ 20261029101530
DRIFT_TAG=20261029094455

# ============================================================================
# 2. Tên miền và HTTPS
# ============================================================================
# Tên miền trỏ bản ghi A về IP server. Chưa có tên miền: <ip-gạch-nối>.sslip.io (ví dụ 64-177-47-62.sslip.io)
APP_HOST=drift.junxcrypto.xyz
# Email nhận thông báo của Let's Encrypt (chứng chỉ sắp hết hạn)
ACME_EMAIL=lthuangiang@gmail.com

# ============================================================================
# 3. Database và Vault (sinh mới cho prod, xem đầu file)
# ============================================================================
POSTGRES_PASSWORD=f0380896c5aaed5ae5e5ddeb4c0c8754
SIGNER_DB_PASSWORD=4e77431fede5ee98427d4a296f8f30bc
# Token signer dùng để mã hoá / giải mã kết nối SoDEX trong Vault. vault-init tự tạo token này lần đầu.
VAULT_TOKEN=9681a9c0ab70809dd8eedf3e9e4c81ad

# ============================================================================
# 4. API
# ============================================================================
# Khoá mã hoá secret 2FA của người dùng (base64 32 byte)
API_TOTP_ENC_KEY=+D5ZyLgXI9u48i6jGKD1gsAaFLRrP3fK0AXvF9okA5Q=

# Đăng nhập dùng email + mật khẩu (DEC-76), không cần email. SMTP chỉ dùng cho email thông báo;
# chưa có thì để SMTP_URL=log. Khi có SMTP thật, ví dụ Brevo:
#   smtp://<login>%40smtp-brevo.com:<smtp-key>@smtp-relay.brevo.com:587
# Ký tự đặc biệt trong user/pass phải mã hoá URL (@ → %40, : → %3A, / → %2F).
# Chưa có SMTP: đặt SMTP_URL=log → không gửi email, mã đăng nhập in ra `docker compose logs api` để tự chép
# cho người dùng (DEC-75). Ai đọc được log là đăng nhập được: chỉ dùng cho app cá nhân.
SMTP_URL=smtp://c0818a001%40smtp-brevo.com:BREVO_SMTP_KEY@smtp-relay.brevo.com:587
MAIL_FROM="DRIFT <info@drift.junxcrypto.xyz>"


# ============================================================================
# 5. SoDEX (giống máy dev)
# ============================================================================
# Bắt buộc, số nguyên dương
DRIFT_BUILDER_ADDRESS=0x4E1e4796c10C637EDAB56461450BD8D02EFb29Db
DRIFT_BUILDER_ID=1645
# Mặc định mainnet; chỉ đổi khi SoDEX đổi địa chỉ gateway
SODEX_REST_URL=https://mainnet-gw.sodex.dev
SODEX_WS_URL=wss://mainnet-gw.sodex.dev/ws

# ============================================================================
# 6. Khác
# ============================================================================
# debug | info | warn | error
LOG_LEVEL=info

# ============================================================================
# Biến có trong .env dev nhưng KHÔNG cần ở đây (để vào cũng không sao, compose bỏ qua):
#   NODE_ENV, API_COOKIE_SECURE   compose prod ghi cứng production / true (HTTPS)
#   SODEX_CHAIN                   ghi cứng mainnet
#   SODEX_CONNECT_ENABLED         ghi cứng true
#   VOLUME_MAKER_ENABLED          ghi cứng false (chờ SoDEX xác nhận, DEC-43)
#   VAULT_DEV_TOKEN, VAULT_ROLE_ID, VAULT_SECRET_ID   chỉ dùng cho Vault dev; prod dùng VAULT_TOKEN
#   PUBLIC_API_URL, PUBLIC_WS_URL web gọi /api và /ws cùng tên miền, để trống như dev
#   WALLETCONNECT_PROJECT_ID      nhúng vào web lúc build trên máy dev (build-push.sh đọc từ .env dev)
#   COMPOSE_PROJECT_NAME          file compose tự đặt name: drift
# ============================================================================
