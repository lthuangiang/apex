# 🚀 DRIFT — Multi-Bot Trading System Configuration
# Copy this file to .env and fill in your values.
# ⚠️  Never commit .env to git — it contains secrets.

# ============================================================================
# 🛡️ SECURITY & ENCRYPTION
# ============================================================================
# Required for encrypting API keys stored in the fleet registry.
MASTER_ENCRYPTION_KEY=your_32_byte_hex_key_here

# ============================================================================
# 📱 DASHBOARD SETTINGS
# ============================================================================
DASHBOARD_PORT=3000
DASHBOARD_PASSCODE=                        # Leave empty to disable auth (local dev only)

# ============================================================================
# 🤖 TELEGRAM NOTIFICATIONS
# ============================================================================
TELEGRAM_ENABLED=true                      # Set to 'false' to disable Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here     # From @BotFather
TELEGRAM_CHAT_ID=your_chat_id_here        # Your Telegram user/group ID

# ============================================================================
# 🧠 AI SIGNAL LAYER
# ============================================================================
LLM_PROVIDER=openai                        # 'openai' or 'anthropic'
OPENAI_API_KEY=sk-...                      # Required if LLM_PROVIDER=openai
ANTHROPIC_API_KEY=sk-ant-...               # Required if LLM_PROVIDER=anthropic
SOSOVALUE_API_KEY=SOSO-...                 # SoSoValue API key for Fear & Greed signal

# ============================================================================
# 🧠 AGENT LAYER — Autonomous Orchestration (Wave 3)
# ============================================================================
AGENT_ENABLED=true                         # Enable/disable Agent Layer autonomous cycles
AGENT_CYCLE_INTERVAL_SECS=30               # How often the Agent evaluates (seconds)
AGENT_EXPOSURE_CAP_USD=500                 # Max total open notional (USD) across all bots
AGENT_CONSECUTIVE_LOSS_HALT=3              # Consecutive losses before cooldown triggers
AGENT_LOSS_COOLDOWN_MINS=10                # Cooldown duration after consecutive losses (minutes)
AGENT_FARM_CAPITAL_RATIO=0.6               # When BOTH strategies active: farm gets 60%, trade gets 40%
AGENT_DRY_RUN=false                        # true = log decisions without emitting orders
AGENT_MAX_LOSS_USD=5                       # Session loss threshold to halt all entries
AGENT_STATE_PATH=./agent-state.json        # Where AgentState is persisted

# ============================================================================
# 📊 DATA PERSISTENCE
# ============================================================================
# All persistent data (trades, state, logs) is stored under DATA_DIR.
# Docker: mount this directory as a volume to survive container restarts.
DATA_DIR=./data
TRADE_LOG_BACKEND=json                     # 'json' or 'sqlite'
TRADE_LOG_PATH=./data/trades.json          # Path to log file or SQLite DB
STATE_STORE_PATH=./data/bot_state.json     # Bot state persistence
AGENT_STATE_PATH=./data/agent-state.json   # Agent layer state

# Trading Memory AI — service URLs (auto-set by docker-compose, override for local dev)
CHROMA_URL=http://localhost:8000           # ChromaDB vector store
OLLAMA_URL=http://localhost:11434          # Ollama local LLM

# LLM Reasoning Agent — generates human-readable trade explanations via Ollama
LLM_REASONING_ENABLED=false               # Set to 'true' to enable LLM reasoning (requires Ollama)
OLLAMA_MODEL=llama3                        # Ollama model to use (llama3, mistral, etc.)
LLM_REASONING_TIMEOUT_MS=4000             # Max wait time for LLM response (ms); falls back to rule-based on timeout

# ============================================================================
# 🔧 EXCHANGE CREDENTIALS (Single-operator / local dev mode only)
# ============================================================================
# In multi-wallet SaaS mode, credentials are submitted per-bot via the API
# and stored encrypted in ./data/{walletAddress}/credentials/{botId}.enc.json
# These env vars are only used when running WITHOUT TenantRegistry (legacy mode).

# --- SoDEX -------------------------------------------------------------------
SODEX_API_KEY=your_sodex_api_key
SODEX_API_SECRET=0x...                     # Wallet private key for EIP-712 signing
SODEX_SUBACCOUNT=0x...                     # Subaccount address
SODEX_SOPOINTS_TOKEN=
                      # Bearer token for SoPoints summary API (optional)

# --- Decibel (Aptos) ---------------------------------------------------------
# Three-tier model: Login Wallet → API Wallet (pays gas) → Trading Account (Subaccount)
DECIBELS_PRIVATE_KEY=ed25519-priv-0x...    # Ed25519 private key of the API wallet
DECIBELS_NODE_API_KEY=aptoslabs_...        # Aptos node API key (from aptoslabs.com)
DECIBELS_SUBACCOUNT=0x...                  # Trading subaccount address
DECIBELS_BUILDER_ADDRESS=                  # Leave empty to disable builder fee
DECIBELS_GAS_STATION_API_KEY=             # Optional: leave empty to self-pay gas (requires APT)
DECIBEL_DEBUG=false                        # Set to 'true' to log all Decibel HTTP requests/responses
DECIBEL_POINTS_API_KEY=AG-...              # Bearer token for Decibel Points API (optional)
DECIBEL_POINTS_OWNER=0x...                 # Primary account address for points lookup (optional)

# --- Dango -------------------------------------------------------------------
DANGO_PRIVATE_KEY=...                      # Secp256k1 private key (no 0x prefix)
DANGO_USER_ADDRESS=0x...                   # Wallet address
DANGO_NETWORK=mainnet                      # 'mainnet' or 'testnet'

# --- Hibachi PerpDex ---------------------------------------------------------
# Hibachi supports two account types: Trustless (ECDSA) and Exchange Managed (HMAC-SHA256).
# Set HIBACHI_ACCOUNT_TYPE to 'trustless' or 'exchange_managed'.
#
# Required for ALL account types:
HIBACHI_API_KEY=                           # Your Hibachi API key (Authorization header value)
HIBACHI_ACCOUNT_TYPE=trustless             # 'trustless' or 'exchange_managed'
#
# Required ONLY for accountType=trustless (ECDSA signing):
HIBACHI_PRIVATE_KEY=0x...                  # EVM private key — 0x-prefixed 64-char hex (32 bytes)
#
# Required ONLY for accountType=exchange_managed (HMAC-SHA256 signing):
HIBACHI_SECRET_KEY=                        # HMAC-SHA256 secret provided by Hibachi

# --- OndoPerps ---------------------------------------------------------------
# Auth uses HMAC-SHA256 signing (ONDO-KEY-ID, ONDO-TIMESTAMP, ONDO-SIGN headers).
# Generate API keys from the OndoPerps dashboard: app.ondoperps.xyz → API Keys.
ONDOPERPS_API_KEY_ID=ondoKeyId_...         # API Key ID (includes "ondoKeyId_" prefix)
ONDOPERPS_API_KEY_SECRET=ondoApiSecret_... # API Secret (includes "ondoApiSecret_" prefix) — treat as password
ONDOPERPS_BASE_URL=https://api.ondoperps.xyz  # Base URL (no trailing /v1)

# ============================================================================
# 🕯️ FARM MICRO SIGNAL ENGINE (Candle Microstructure Mode)
# ============================================================================
# When enabled, FARM mode uses 1-minute candles + market microstructure
# (orderbook imbalance, trade pressure) instead of AISignalEngine/LLM/SoSoValue.
# Designed for the 2-5 minute hold horizon. Default: disabled (safe rollout).
#
FARM_MICRO_ENABLED=false                   # Set to 'true' to activate candle micro mode for FARM
FARM_MICRO_SYMBOLS=BTC-USD,BTC-PERP,BTCUSDT  # Comma-separated symbols eligible for micro mode
FARM_MICRO_INTERVAL=1m                     # Candle interval (1m recommended for FARM hold time)
FARM_MICRO_CANDLE_LIMIT=30                 # Number of candles to request from exchange
FARM_MICRO_CACHE_SECS=10                   # Signal cache TTL (seconds); invalidated on entry
FARM_MICRO_LONG_THRESHOLD=0.60             # Composite score >= this → LONG candidate
FARM_MICRO_SHORT_THRESHOLD=0.40            # Composite score <= this → SHORT candidate
FARM_MICRO_MIN_CONFIDENCE=0.55             # Minimum confidence to act (normal regime)
FARM_MICRO_HIGH_VOL_MIN_CONFIDENCE=0.65    # Minimum confidence in HIGH_VOLATILITY/UNKNOWN regime
FARM_MICRO_TREND_COUNTER_THRESHOLD=0.70    # Score required for counter-trend entry
FARM_MICRO_MAX_CANDLE_AGE_SECS=120         # Skip if newest completed candle > this age
FARM_MICRO_FEE_SAFETY_MULT=1.5            # Edge must cover fees × this multiplier to enter
