# Sao chép thành .env và điền giá trị. Không commit .env (CODING_STANDARDS C12).
NODE_ENV=development
LOG_LEVEL=info

# Data
POSTGRES_PASSWORD=
SIGNER_DB_PASSWORD=

# SoDEX: mọi môi trường dùng mainnet, tiền thật (DEC-23)
SODEX_REST_URL=https://mainnet-gw.sodex.dev
# Client nối thêm /spot hoặc /perps
SODEX_WS_URL=wss://mainnet-gw.sodex.dev/ws
SODEX_CHAIN=mainnet
# Bắt buộc, số nguyên dương. Điền khi chạy; không có giá trị mặc định (DEC-24)
# Ví builder của DRIFT (đọc số dư để đối soát builder revenue, DEC-41). Trống thì bỏ qua đối soát.
DRIFT_BUILDER_ADDRESS=
DRIFT_BUILDER_ID=
# false: account builder cũng bị thu builder fee và phải approve (DEC-124). Mặc định true (miễn, DEC-47).
DRIFT_BUILDER_ACCOUNT_EXEMPT=true

# Edge / web
APP_HOST=localhost
PUBLIC_API_URL=
PUBLIC_WS_URL=

# Vault (dev mode chỉ dùng ở profile dev)
VAULT_DEV_TOKEN=
# signer: dev đặt bằng VAULT_DEV_TOKEN; môi trường khác để trống và dùng AppRole
VAULT_TOKEN=
VAULT_ROLE_ID=
VAULT_SECRET_ID=

# API (DEC-28, DEC-29)
# 32 byte base64, mã hoá secret TOTP: openssl rand -base64 32
API_TOTP_ENC_KEY=
# Chỉ đặt false khi chạy http://localhost
API_COOKIE_SECURE=true
# Dev dùng Mailpit trong compose; production điền SMTP thật
SMTP_URL=smtp://mailpit:1025
MAIL_FROM=
# Bật luồng kết nối SoDEX sau khi kiểm chứng mặt nạ 14 trên mainnet (SODEX.md mục 5.2)
SODEX_CONNECT_ENABLED=false
# Bản đồ thanh lý ở màn tạo bot (IMP-05, DEC-91). Chỉ có `none` (tab ẩn) cho tới khi chọn nhà cung cấp có
# giấy phép hiển thị lại. URL và key chỉ ở server.
# none | hyperliquid (quét dữ liệu công khai của Hyperliquid, DEC-92)
LIQUIDATION_PROVIDER=none
# Copy Trade (DEC-161): chu kỳ đọc lại ví leader và số WS leader tối đa (SoDEX: 10 user mỗi IP)
LEADER_SYNC_MS=30000
LEADER_MAX_STREAMS=8
# Copy Trading v1 (DEC-163): tính lại leaderboard Hyperliquid mỗi đêm (scheduler), giờ bắt đầu (UTC).
COPY_LEADERBOARD_ENABLED=false
COPY_LEADERBOARD_HOUR_UTC=1
# Cảnh báo "big move" ở Following: notional tối thiểu (USD). Để trống = tắt (OPEN_QUESTIONS 21a).
COPY_BIG_MOVE_MIN_USD=50000
# LIQUIDATION_API_URL=
# LIQUIDATION_API_KEY=


# WalletConnect Cloud (Reown) Project ID cho lựa chọn WalletConnect (ví trên điện thoại). Trống thì ẩn.
WALLETCONNECT_PROJECT_ID=

# Telegram (DEC-170, docs/NOTIFICATIONS.md). Token và webhook secret: production đặt trong Vault.
TELEGRAM_ENABLED=false
DRIFT_TELEGRAM_BOT_USERNAME=desklabsbot
DRIFT_TELEGRAM_BOT_TOKEN=
DRIFT_TELEGRAM_WEBHOOK_SECRET=
# Morning brief qua Telegram (N4): chỉ chạy khi TELEGRAM_ENABLED=true. TELEGRAM_BRIEF_LLM=true thì gọi LLM tạo brief
# cho user chưa mở AI Desk hôm đó (tốn phí); mặc định false = câu mẫu.
TELEGRAM_BRIEF_ENABLED=true
TELEGRAM_BRIEF_LLM=false

# Desk AI (DEC-165, DEC-188): key Claude API (Claude Console) cho api. Trống = LLM tắt, Desk AI trả lời
# bằng câu mẫu. Không log, không commit.
DESK_AI_API_KEY=

# MCP (DEC-167, docs/MCP.md): gốc URL của apps/mcp (token OAuth gắn với <gốc>/mcp và <gốc>/team/mcp) và shared secret
# cho introspect nội bộ apps/mcp → api (sinh: openssl rand -hex 32). Trống = introspect tắt. Không log, không commit.
MCP_PUBLIC_URL=https://mcp.localhost
MCP_INTROSPECT_SECRET=
# Tên miền Traefik của service mcp (khớp host của MCP_PUBLIC_URL).
MCP_HOST=mcp.localhost

# Binance guard của Market Making (một phần của Smart quoting): ngưỡng lệch Binance / SoDEX (bp), 0 = tắt.
MM_GUARD_BP=0.75
MM_GUARD_HOLD_MS=500
