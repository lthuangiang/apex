# Production 1 host (DEC-70). Chép thành /opt/drift/.env TRÊN VPS, chmod 600. Không commit, không đưa lên GitHub.
# Sinh secret: openssl rand -base64 32   (password: openssl rand -hex 24)
COMPOSE_PROJECT_NAME=drift
NODE_ENV=production
LOG_LEVEL=info

# Image: MỘT repo private trên Docker Hub (free chỉ có 1), tag `<app>-<sha>`. DRIFT_TAG do deploy.sh tự ghi.
DRIFT_IMAGE=docker.io/<user>/drift
DRIFT_TAG=

# Edge
APP_HOST=desklabs.xyz
# Tên miền cũ chuyển hướng 301 sang APP_HOST (DEC-150); để trống nếu không có.
OLD_APP_HOST=
OLD_APP_HOST_2=
ACME_EMAIL=
PUBLIC_API_URL=
PUBLIC_WS_URL=
API_COOKIE_SECURE=true

# Data
POSTGRES_PASSWORD=
SIGNER_DB_PASSWORD=

# SoDEX mainnet (DEC-23)
SODEX_REST_URL=https://mainnet-gw.sodex.dev
SODEX_WS_URL=wss://mainnet-gw.sodex.dev/ws
SODEX_CHAIN=mainnet
DRIFT_BUILDER_ID=
DRIFT_BUILDER_ADDRESS=
# false: account builder cũng bị thu builder fee và phải approve (DEC-124). Mặc định true (miễn, DEC-47).
DRIFT_BUILDER_ACCOUNT_EXEMPT=true
SODEX_CONNECT_ENABLED=true

# Vault (profile prod): token của signer, chỉ có quyền transit. Đặt một lần, không đổi.
VAULT_TOKEN=
VAULT_DEV_TOKEN=
VAULT_ROLE_ID=
VAULT_SECRET_ID=
# mTLS api/engine ↔ signer: CERT_DAYS=1095 sh infra/certs/gen-dev-certs.sh /opt/drift/certs
SIGNER_CERTS_DIR=/opt/drift/certs

# API
API_TOTP_ENC_KEY=
# SMTP thật (Resend, Postmark, SES…): smtp(s)://user:pass@host:port
SMTP_URL=smtp://c0818a001%40smtp-brevo.com:BREVO_SMTP_KEY@smtp-relay.brevo.com:587
MAIL_FROM="DeskLabs <info@desklabs.xyz>"

WALLETCONNECT_PROJECT_ID=

# Backup ra ngoài VPS (tuỳ chọn): khoá công khai `age` (age-keygen) + remote của rclone (rclone config)
BACKUP_AGE_RECIPIENT=
RCLONE_REMOTE=

# Telegram (DEC-170, docs/NOTIFICATIONS.md). Token và webhook secret: production đặt trong Vault.
TELEGRAM_ENABLED=false
DRIFT_TELEGRAM_BOT_USERNAME=desklabsbot
DRIFT_TELEGRAM_BOT_TOKEN=
DRIFT_TELEGRAM_WEBHOOK_SECRET=

# Desk AI (DEC-165, DEC-188): key Claude API (Claude Console) cho api. Trống = LLM tắt, Desk AI trả lời
# bằng câu mẫu. Không log, không commit.
DESK_AI_API_KEY=
# MCP (DEC-167): shared secret cho introspect nội bộ apps/mcp → api (openssl rand -hex 32). Trống = MCP tắt.
MCP_PUBLIC_URL=https://mcp.desklabs.xyz
MCP_INTROSPECT_SECRET=
