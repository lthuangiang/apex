{
  "name": "@drift/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:migrate": "pnpm --filter @drift/db db:migrate",
    "start": "tsx src/main.ts",
    "set-password": "tsx src/cli/set-password.ts"
  },
  "dependencies": {
    "@drift/db": "workspace:*",
    "@drift/runtime": "workspace:*",
    "@drift/shared": "workspace:*",
    "@drift/sodex": "workspace:*",
    "@drift/strategies": "workspace:*",
    "@fastify/cookie": "11.1.5",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "ioredis": "6.0.0",
    "nodemailer": "10.2.1",
    "otpauth": "9.5.2",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "uuid": "14.0.3",
    "viem": "2.57.12",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@drift/sodex-mock": "workspace:*",
    "@testcontainers/postgresql": "11.14.0",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "vitest": "5.0.5"
  }
}
