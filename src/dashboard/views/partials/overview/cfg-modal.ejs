<!-- ── Config Settings Modal ──────────────────────────────────────────── -->
<div class="cfg-overlay" id="cfg-overlay" onclick="if(event.target===this)closeCfgModal()">
  <div class="cfg-modal">
    <div class="cfg-modal-header">
      <h2>⚙️ Bot Settings</h2>
      <button class="cfg-close" onclick="closeCfgModal()">✕</button>
    </div>
    <div class="cfg-sections">

      <!-- Bot Identity — only shown in multi-bot mode (BOT_CONTEXT set) -->
      <div class="cfg-section" id="bot-identity-section" style="display:none">
        <div class="cfg-section-title">🤖 Bot Identity</div>
        <div class="cfg-fields">
          <div class="cfg-field">
            <label>Bot Name</label>
            <div class="cfg-hint">Display name shown in dashboard</div>
            <input type="text" id="cfg-bot-name" placeholder="e.g. SoDEX Bot"/>
          </div>
          <div class="cfg-field">
            <label>Symbol</label>
            <div class="cfg-hint">Trading pair (e.g. BTC-USD)</div>
            <input type="text" id="cfg-bot-symbol" placeholder="e.g. BTC-USD"/>
          </div>
        </div>
        <div style="margin-top:.75rem;display:flex;align-items:center;gap:.6rem;">
          <button class="cb g" onclick="updateBotIdentity()">✓ Save</button>
          <span id="identity-toast" style="font-size:.72rem;opacity:0;transition:opacity .3s;"></span>
        </div>
      </div>

      <!-- ── General ── -->
      <div class="cfg-section">
        <div class="cfg-section-title">📦 General</div>
        <div class="cfg-fields">
          <div class="cfg-field">
            <label>Min Order Size (BTC)</label>
            <div class="cfg-hint">Smallest order size per entry</div>
            <input type="number" id="cfg-ORDER_SIZE_MIN" step="any" min="0" placeholder="e.g. 0.002"/>
          </div>
          <div class="cfg-field">
            <label>Max Order Size (BTC)</label>
            <div class="cfg-hint">Largest order size per entry</div>
            <input type="number" id="cfg-ORDER_SIZE_MAX" step="any" min="0" placeholder="e.g. 0.005"/>
          </div>
          <div class="cfg-field">
            <label>Min Position Value ($)</label>
            <div class="cfg-hint">Skip closing if position is below this USD value</div>
            <input type="number" id="cfg-MIN_POSITION_VALUE_USD" step="1" min="1" placeholder="e.g. 20"/>
          </div>
        </div>
      </div>

      <!-- ── Farm Mode ── -->
      <div class="cfg-section" id="cfg-section-farm">
        <div class="cfg-section-title">🚜 Farm Mode</div>

        <!-- Profile toggles -->
        <div class="cfg-fields" style="grid-template-columns:1fr;margin-bottom:.5rem">
          <div class="cfg-field" style="grid-column:1/-1;display:flex;align-items:center;gap:.75rem;">
            <label style="margin:0;min-width:0">Reverse Signal</label>
            <label class="cfg-toggle" style="margin:0">
              <input type="checkbox" id="cfg-FARM_REVERSE_SIGNAL_ENABLED"/>
              <span class="cfg-toggle-slider"></span>
            </label>
            <div class="cfg-hint" style="margin:0">Flip long ↔ short after filters pass (farm-only, for testing)</div>
          </div>
          <div class="cfg-field" style="grid-column:1/-1;display:flex;align-items:center;gap:.75rem;">
            <label style="margin:0;min-width:0">Dynamic Sizing</label>
            <label class="cfg-toggle" style="margin:0">
              <input type="checkbox" id="cfg-FARM_USE_DYNAMIC_SIZING"/>
              <span class="cfg-toggle-slider"></span>
            </label>
            <div class="cfg-hint" style="margin:0">Use confidence + performance multipliers to scale farm order size</div>
          </div>
        </div>

        <!-- Hold / exit basics -->
        <div class="cfg-fields">
          <div class="cfg-field">
            <label>Min Hold (secs)</label>
            <div class="cfg-hint">Minimum hold time after fill</div>
            <input type="number" id="cfg-FARM_MIN_HOLD_SECS" step="1" min="0" placeholder="e.g. 120"/>
          </div>
          <div class="cfg-field">
            <label>Max Hold (secs)</label>
            <div class="cfg-hint">Force exit after this many seconds</div>
            <input type="number" id="cfg-FARM_MAX_HOLD_SECS" step="1" min="0" placeholder="e.g. 480"/>
          </div>
          <div class="cfg-field">
            <label>Take Profit ($)</label>
            <div class="cfg-hint">Exit when profit ≥ this USD amount</div>
            <input type="number" id="cfg-FARM_TP_USD" step="any" min="0" placeholder="e.g. 0.5"/>
          </div>
          <div class="cfg-field">
            <label>Stop Loss %</label>
            <div class="cfg-hint">Hard stop (0.05 = 5%)</div>
            <input type="number" id="cfg-FARM_SL_PERCENT" step="any" min="0" max="1" placeholder="e.g. 0.05"/>
          </div>
          <div class="cfg-field">
            <label>Early Exit After (secs)</label>
            <div class="cfg-hint">Can exit early if held this long and profitable</div>
            <input type="number" id="cfg-FARM_EARLY_EXIT_SECS" step="1" min="0" placeholder="e.g. 60"/>
          </div>
          <div class="cfg-field">
            <label>Min Profit USD</label>
            <div class="cfg-hint">Min profit in USD to exit early (0.15 for SoDEX, 0.001 for free fee)</div>
            <input type="number" id="cfg-FARM_MIN_PROFIT_FEE_MULT" step="0.01" min="0" placeholder="e.g. 0.15"/>
          </div>
          <div class="cfg-field">
            <label>Extra Wait (secs)</label>
            <div class="cfg-hint">After hold expires, wait this long if still profitable</div>
            <input type="number" id="cfg-FARM_EXTRA_WAIT_SECS" step="1" min="0" placeholder="e.g. 30"/>
          </div>
          <div class="cfg-field">
            <label>Cooldown (secs)</label>
            <div class="cfg-hint">Fixed pause after each farm trade</div>
            <input type="number" id="cfg-FARM_COOLDOWN_SECS" step="1" min="0" placeholder="e.g. 30"/>
          </div>
          <div class="cfg-field" style="grid-column:1/-1">
            <label>Blocked Hours UTC</label>
            <div class="cfg-hint">Comma-separated UTC hours to skip. Empty = no block. e.g. 7,8,9,18,19</div>
            <input type="text" id="cfg-FARM_BLOCKED_HOURS" placeholder="e.g. 7,8,9,10,11 (empty = no block)"/>
          </div>
        </div>
      </div>

      <!-- ── Trade Mode ── -->
      <div class="cfg-section" id="cfg-section-trade">
        <div class="cfg-section-title">📈 Trade Mode</div>
        <div class="cfg-fields">
          <div class="cfg-field">
            <label>Score Threshold</label>
            <div class="cfg-hint">Min |score| to enter a direction (0.65 = 65%)</div>
            <input type="number" id="cfg-TRADE_SCORE_THRESHOLD" step="any" min="0" max="1" placeholder="e.g. 0.65"/>
          </div>
          <div class="cfg-field">
            <label>Min Confidence</label>
            <div class="cfg-hint">Min LLM confidence to confirm entry (0.65 = 65%)</div>
            <input type="number" id="cfg-TRADE_MIN_CONFIDENCE" step="any" min="0" max="1" placeholder="e.g. 0.65"/>
          </div>
          <div class="cfg-field">
            <label>Take Profit %</label>
            <div class="cfg-hint">Exit on profit (0.05 = 5%)</div>
            <input type="number" id="cfg-TRADE_TP_PERCENT" step="any" min="0" max="1" placeholder="e.g. 0.05"/>
          </div>
          <div class="cfg-field">
            <label>Stop Loss %</label>
            <div class="cfg-hint">Exit on loss (0.05 = 5%)</div>
            <input type="number" id="cfg-TRADE_SL_PERCENT" step="any" min="0" max="1" placeholder="e.g. 0.05"/>
          </div>
          <div class="cfg-field">
            <label>Min Cooldown (mins)</label>
            <div class="cfg-hint">Adaptive cooldown minimum</div>
            <input type="number" id="cfg-COOLDOWN_MIN_MINS" step="1" min="0" placeholder="e.g. 2"/>
          </div>
          <div class="cfg-field">
            <label>Max Cooldown (mins)</label>
            <div class="cfg-hint">Adaptive cooldown ceiling</div>
            <input type="number" id="cfg-COOLDOWN_MAX_MINS" step="1" min="0" placeholder="e.g. 5"/>
          </div>
        </div>
      </div>

      <!-- Daily Budget Reset — only shown in multi-bot mode (BOT_CONTEXT set) -->
      <div class="cfg-section" id="daily-reset-section" style="display:none">
        <div class="cfg-section-title">📅 Daily Budget Reset</div>
        <div class="cfg-fields" style="grid-template-columns:1fr 1fr;">
          <div class="cfg-field" style="grid-column:1/-1;display:flex;align-items:center;gap:.75rem;">
            <label style="margin:0;min-width:0">Enable Daily Reset</label>
            <label class="cfg-toggle" style="margin:0">
              <input type="checkbox" id="cfg-daily-budget-reset"/>
              <span class="cfg-toggle-slider"></span>
            </label>
            <div class="cfg-hint" style="margin:0">Auto-restart bot with fresh budget each day</div>
          </div>
          <div class="cfg-field">
            <label>Max Loss / day ($)</label>
            <div class="cfg-hint">Bot stops when loss reaches this. 0 = unlimited</div>
            <input type="number" id="cfg-daily-max-loss-usd" step="0.5" min="0" placeholder="e.g. 5"/>
          </div>
          <div class="cfg-field">
            <label>Target Volume / day ($)</label>
            <div class="cfg-hint">Bot stops when volume reaches this. 0 = unlimited</div>
            <input type="number" id="cfg-daily-target-volume-usd" step="100" min="0" placeholder="e.g. 5000"/>
          </div>
          <div class="cfg-field">
            <label>Reset Hour (UTC)</label>
            <div class="cfg-hint">Hour to reset each day (0–23). 0 = 7am Vietnam</div>
            <input type="number" id="cfg-daily-reset-hour-utc" step="1" min="0" max="23" placeholder="e.g. 0"/>
          </div>
          <div class="cfg-field" style="display:flex;align-items:flex-end;">
            <div class="cfg-hint" id="daily-reset-tz-hint" style="color:#aaa;font-size:.72rem;padding-bottom:.25rem;"></div>
          </div>
        </div>
        <div style="margin-top:.75rem;display:flex;align-items:center;gap:.6rem;">
          <button class="cb g" onclick="saveDailyReset()">✓ Save</button>
          <span id="daily-reset-toast" style="font-size:.72rem;opacity:0;transition:opacity .3s;"></span>
        </div>
      </div>

      <!-- Exchange-specific token section — shown/hidden by JS based on exchange -->
      <div class="cfg-section" id="sopoints-cfg-section">
        <div class="cfg-section-title">🔑 SoDEX SoPoints Token</div>
        <div class="cfg-fields" style="grid-template-columns:1fr;">
          <div class="cfg-field">
            <label>API Token</label>
            <div class="cfg-hint">Paste new token when expired — no restart needed</div>
            <input type="password" id="sopoints-token-input" placeholder="Paste new token..."/>
          </div>
        </div>
        <div style="margin-top:0.75rem;display:flex;align-items:center;gap:0.6rem;">
          <button class="cb g" onclick="updateSoPointsToken()">✓ Update Token</button>
          <span id="sopoints-token-toast" style="font-size:0.72rem;opacity:0;transition:opacity 0.3s;"></span>
        </div>
      </div>

      <div class="cfg-section" id="decibel-cfg-section" style="display:none">
        <div class="cfg-section-title">🎵 Decibel AMPS Token</div>
        <div class="cfg-fields" style="grid-template-columns:1fr;">
          <div class="cfg-field">
            <label>Authorization Token</label>
            <div class="cfg-hint">Bearer token from Decibel — used to fetch AMPS points</div>
            <input type="password" id="decibel-token-input" placeholder="AG-XXXXXXXXXXXXXXXXXXXX"/>
          </div>
          <div class="cfg-field">
            <label>Owner Address (0x...)</label>
            <div class="cfg-hint">Aptos wallet address of your Decibel account</div>
            <input type="text" id="decibel-owner-input" placeholder="0x5941634d4ec6f9733c..."/>
          </div>
        </div>
        <div style="margin-top:0.75rem;display:flex;align-items:center;gap:0.6rem;">
          <button class="cb g" onclick="updateDecibelToken()">✓ Update</button>
          <span id="decibel-token-toast" style="font-size:0.72rem;opacity:0;transition:opacity 0.3s;"></span>
        </div>
      </div>

    </div>
    <div class="cfg-actions">
      <button class="cb g" id="cfg-apply-btn" onclick="applyConfig()">✓ Apply</button>
      <button class="cb" id="cfg-reset-btn" onclick="resetConfig()">↺ Reset to Defaults</button>
      <span class="cfg-toast" id="cfg-toast"></span>
    </div>
  </div>
</div>
