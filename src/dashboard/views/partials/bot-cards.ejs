<style>
  /* Wave 3: Beautiful Empty State Styles - Theme aware */
  .empty-state-hero {
    text-align: center;
    padding: 4rem 2rem;
    background: linear-gradient(135deg, var(--bg-primary, #f8fafc) 0%, var(--bg-secondary, #e2e8f0) 100%);
    border: 1px solid var(--border-color, #cbd5e1);
    border-radius: 16px;
    grid-column: 1 / -1;
    animation: fadeIn 0.5s ease-out;
    color: var(--text-primary, #1e293b);
  }
  body.dark .empty-state-hero,
  body[data-theme="dark"] .empty-state-hero {
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
    border-color: #334155;
    color: #e2e8f0;
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .empty-state-icon {
    font-size: 4rem;
    margin-bottom: 1rem;
    animation: bounce 2s infinite;
  }
  @keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }
  .empty-state-title {
    font-size: 1.8rem;
    margin: 0.5rem 0;
    background: linear-gradient(90deg, #60a5fa, #a78bfa);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .empty-state-desc {
    color: var(--text-secondary, #64748b);
    margin: 1rem auto;
    max-width: 500px;
    line-height: 1.6;
  }
  body.dark .empty-state-desc,
  body[data-theme="dark"] .empty-state-desc {
    color: #94a3b8;
  }
  .empty-state-features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    max-width: 800px;
    margin: 2rem auto;
  }
  .empty-feature {
    background: var(--bg-card, #ffffff);
    border: 1px solid var(--border-color, #e2e8f0);
    border-radius: 12px;
    padding: 1rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    transition: transform 0.2s, border-color 0.2s;
  }
  .empty-feature:hover {
    transform: translateY(-2px);
    border-color: #3b82f6;
  }
  body.dark .empty-feature,
  body[data-theme="dark"] .empty-feature {
    background: #1e293b;
    border-color: #334155;
  }
  body.dark .empty-feature:hover,
  body[data-theme="dark"] .empty-feature:hover {
    border-color: #60a5fa;
  }
  .empty-feature-icon {
    font-size: 2rem;
    flex-shrink: 0;
  }
  .empty-feature-text {
    display: flex;
    flex-direction: column;
    text-align: left;
  }
  .empty-feature-text strong {
    color: var(--text-primary, #1e293b);
    font-size: 0.95rem;
  }
  .empty-feature-text span {
    color: var(--text-secondary, #64748b);
    font-size: 0.8rem;
  }
  body.dark .empty-feature-text strong,
  body[data-theme="dark"] .empty-feature-text strong { color: #e2e8f0; }
  body.dark .empty-feature-text span,
  body[data-theme="dark"] .empty-feature-text span { color: #94a3b8; }
  .empty-state-cta {
    background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);
    color: white;
    border: none;
    padding: 0.85rem 2rem;
    border-radius: 10px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
    box-shadow: 0 4px 12px rgba(59, 130, 246, 0.4);
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .empty-state-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(59, 130, 246, 0.5);
  }
  .empty-state-filter {
    text-align: center;
    padding: 3rem 2rem;
    background: #1e293b;
    border: 1px dashed #334155;
    border-radius: 12px;
    grid-column: 1 / -1;
  }
  /* Wave 3: Mode badges - Dark mode (default) */
  .mode-badge.mode-farm {
    background: rgba(34, 197, 94, 0.15);
    color: #16a34a;
    border: 1px solid rgba(34, 197, 94, 0.3);
  }
  .mode-badge.mode-trade {
    background: rgba(59, 130, 246, 0.15);
    color: #2563eb;
    border: 1px solid rgba(59, 130, 246, 0.3);
  }
  /* Wave 3: Intelligence badges - Dark mode (default) */
  .intel-badge.intel-auto {
    background: linear-gradient(135deg, rgba(139, 92, 246, 0.15), rgba(59, 130, 246, 0.15));
    color: #7c3aed;
    border: 1px solid rgba(139, 92, 246, 0.4);
    box-shadow: 0 0 8px rgba(139, 92, 246, 0.15);
  }
  .intel-badge.intel-manual {
    background: rgba(100, 116, 139, 0.15);
    color: #64748b;
    border: 1px solid rgba(100, 116, 139, 0.3);
  }

  /* Dark mode adjustments — when body has dark class or system prefers dark */
  @media (prefers-color-scheme: dark) {
    .mode-badge.mode-farm { color: #4ade80; }
    .mode-badge.mode-trade { color: #60a5fa; }
    .intel-badge.intel-auto { color: #a78bfa; }
    .intel-badge.intel-manual { color: #94a3b8; }
  }
  body.dark .mode-badge.mode-farm,
  body[data-theme="dark"] .mode-badge.mode-farm { color: #4ade80; }
  body.dark .mode-badge.mode-trade,
  body[data-theme="dark"] .mode-badge.mode-trade { color: #60a5fa; }
  body.dark .intel-badge.intel-auto,
  body[data-theme="dark"] .intel-badge.intel-auto { color: #a78bfa; }
  body.dark .intel-badge.intel-manual,
  body[data-theme="dark"] .intel-badge.intel-manual { color: #94a3b8; }
  /* Loading state - faster, less annoying */
  .state-loading {
    text-align: center;
    padding: 3rem;
    color: #94a3b8;
    grid-column: 1 / -1;
  }
  .state-loading .spinner {
    width: 32px;
    height: 32px;
    border: 3px solid #334155;
    border-top-color: #60a5fa;
    border-radius: 50%;
    margin: 0 auto 1rem;
    animation: spin 0.8s linear infinite;
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
</style>

<div class="bot-grid" id="bot-cards">
  <div class="state-loading">
    <div class="spinner"></div>
    <div>Loading bots...</div>
  </div>
</div>

<!-- Bot Card Template (rendered by manager-dashboard.js) -->
<template id="bot-card-template">
  <div class="bot-card {cardClass}" data-bot-id="{id}" data-status="{status}">
    <div class="card-header">
      <div class="card-identity">
        <div class="card-name">{name}</div>
        <div class="card-meta">
          <span class="exchange-badge">{exchange}</span>
          {strategyTags}
        </div>
      </div>
      <div class="status-pill {status}">
        <div class="status-dot"></div>
        {statusText}
      </div>
    </div>

    <!-- Wave 3: Mode + Intelligence Badge Row -->
    <div style="display:flex;gap:0.5rem;flex-wrap:wrap;margin:0.75rem 0;align-items:center">
      <span class="mode-badge mode-{mode}" style="display:inline-flex;align-items:center;gap:4px;padding:4px 10px;border-radius:6px;font-size:0.75rem;font-weight:600;text-transform:uppercase;">
        {modeIcon} {modeLabel}
      </span>
      <span class="intel-badge intel-{intelligenceMode}" style="display:inline-flex;align-items:center;gap:4px;padding:4px 10px;border-radius:6px;font-size:0.75rem;font-weight:600;">
        {intelIcon} {intelLabel}
      </span>
    </div>

    <div class="ai-strip" id="ai-signal-{id}">
      <div class="ai-strip-title">🧠 SoSoValue Intelligence</div>
      <div class="ai-row">
        <div class="ai-pill"><span class="ai-pill-label">Regime</span><span class="ai-pill-val">{regime}</span></div>
        <div class="ai-pill"><span class="ai-pill-label">Macro</span><span class="ai-pill-val">{macro}</span></div>
        <div class="ai-pill"><span class="ai-pill-label">Size ×</span><span class="ai-pill-val">{sizeMult}</span></div>
        <div class="ai-pill"><span class="ai-pill-label">Direction</span><span class="ai-pill-val">{direction}</span></div>
      </div>
      <div class="conf-bar-wrap">
        <span class="conf-label">Confidence</span>
        <div class="conf-track"><div class="conf-fill" style="width:{confidence}%;background:#BA7517;"></div></div>
        <span class="conf-pct" style="color:#BA7517;">{confidenceText}</span>
      </div>
      <div class="decision-log">
        <div class="log-header"><span>Signal pipeline</span><span class="log-timestamp">last tick —</span></div>
        <!-- Log rows injected by renderAIStrip() -->
      </div>
    </div>

    <div class="sparkline-wrap" id="sparkline-{id}">
      <div class="sparkline-empty">No trade history yet</div>
    </div>

    <div class="pnl-hero">
      <span class="pnl-value {pnlClass}">{pnlSign}${pnl}</span>
      <span class="pnl-label">PnL</span>
    </div>

    <div class="card-stats">
      <div class="stat-item">
        <span class="stat-item-label">Start Balance</span>
        <span class="stat-item-value">${startBalance}</span>
      </div>
      <div class="stat-item">
        <span class="stat-item-label">Current Balance</span>
        <span class="stat-item-value">${currentBalance}</span>
      </div>
      <div class="stat-item">
        <span class="stat-item-label">Volume</span>
        <span class="stat-item-value">${volume}</span>
      </div>
      <div class="stat-item">
        <span class="stat-item-label">Efficiency</span>
        <span class="stat-item-value {effClass}">{efficiency} bps</span>
      </div>
      <div class="stat-item">
        <span class="stat-item-label">Uptime</span>
        <span class="stat-item-value">{uptime}m</span>
      </div>
    </div>

    <div class="card-actions">
      <button class="btn btn-primary btn-start-bot" data-bot-id="{id}" style="display:{startDisplay}">
        ▶ Start Bot
      </button>
      <button class="btn btn-danger btn-stop-bot" data-bot-id="{id}" style="display:{stopDisplay}">
        ■ Stop
      </button>
      <a href="/bots/{id}" class="btn btn-ghost">Details →</a>
      <button class="btn btn-ghost btn-delete-bot" data-bot-id="{id}" data-bot-name="{name}" title="Delete bot" style="padding:0.55rem 0.65rem;color:var(--red);border-color:var(--red-border)">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
      </button>
    </div>
  </div>
</template>
