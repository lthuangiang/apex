<div class="bot-grid" id="bot-cards">
  <div class="state-loading">
    <div class="spinner"></div>
    Loading bots...
  </div>
</div>

<!-- Bot Card Template (rendered by manager-dashboard.js) -->
<template id="bot-card-template">
  <div class="bot-card {cardClass}" data-bot-id="{id}" data-status="{status}">
    <div class="card-header">
      <div class="card-identity">
        <div class="card-name">{name}</div>
        <div class="card-meta">
          <span class="exchange-badge">{exchange}</span>
          {strategyTags}
        </div>
      </div>
      <div class="status-pill {status}">
        <div class="status-dot"></div>
        {statusText}
      </div>
    </div>

    <div class="sparkline-wrap" id="sparkline-{id}">
      <div class="sparkline-empty">No trade history yet</div>
    </div>

    <div class="pnl-hero">
      <span class="pnl-value {pnlClass}">{pnlSign}${pnl}</span>
      <span class="pnl-label">PnL</span>
    </div>

    <div class="card-stats">
      <div class="stat-item">
        <span class="stat-item-label">Start Balance</span>
        <span class="stat-item-value">${startBalance}</span>
      </div>
      <div class="stat-item">
        <span class="stat-item-label">Current Balance</span>
        <span class="stat-item-value">${currentBalance}</span>
      </div>
      <div class="stat-item">
        <span class="stat-item-label">Volume</span>
        <span class="stat-item-value">${volume}</span>
      </div>
      <div class="stat-item">
        <span class="stat-item-label">Efficiency</span>
        <span class="stat-item-value {effClass}">{efficiency} bps</span>
      </div>
      <div class="stat-item">
        <span class="stat-item-label">Uptime</span>
        <span class="stat-item-value">{uptime}m</span>
      </div>
    </div>

    <div class="card-actions">
      <button class="btn btn-primary btn-start-bot" data-bot-id="{id}" style="display:{startDisplay}">
        ▶ Start Bot
      </button>
      <button class="btn btn-danger btn-stop-bot" data-bot-id="{id}" style="display:{stopDisplay}">
        ■ Stop
      </button>
      <a href="/bots/{id}" class="btn btn-ghost">Details →</a>
      <button class="btn btn-ghost btn-delete-bot" data-bot-id="{id}" data-bot-name="{name}" title="Delete bot" style="padding:0.55rem 0.65rem;color:var(--red);border-color:var(--red-border)">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
      </button>
    </div>
  </div>
</template>
