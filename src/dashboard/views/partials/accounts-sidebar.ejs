<!-- Accounts Sidebar Panel — populated dynamically by accounts.js -->
<style>
  .accounts-sidebar {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
    margin-bottom: 1.5rem;
    box-shadow: var(--shadow-sm);
  }

  .accounts-sidebar-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.875rem;
  }

  .accounts-sidebar-title {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-tertiary);
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .accounts-sidebar-title-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  .accounts-sidebar-count {
    font-size: 0.68rem;
    color: var(--text-tertiary);
    font-weight: 500;
  }

  .accounts-sidebar-list {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .accounts-sidebar-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.625rem 0.75rem;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    transition: border-color 0.15s, box-shadow 0.15s;
  }

  .accounts-sidebar-item:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-sm);
  }

  .accounts-sidebar-icon {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    flex-shrink: 0;
    background: var(--accent-light);
    color: var(--accent);
  }

  .accounts-sidebar-icon.exchange-sodex { background: rgba(245,166,35,0.12); color: #f5a623; }
  .accounts-sidebar-icon.exchange-decibel { background: rgba(59,130,246,0.12); color: #3b82f6; }
  .accounts-sidebar-icon.exchange-dango { background: rgba(168,85,247,0.12); color: #a855f7; }
  .accounts-sidebar-icon.exchange-hibachi { background: rgba(249,115,22,0.12); color: #f97316; }
  .accounts-sidebar-icon.exchange-ondoperps { background: rgba(147,51,234,0.12); color: #9333ea; }
  .accounts-sidebar-icon.exchange-perpl { background: rgba(34,211,238,0.12); color: #22d3ee; }

  .accounts-sidebar-info {
    flex: 1;
    min-width: 0;
    overflow: hidden;
  }

  .accounts-sidebar-label {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .accounts-sidebar-key {
    font-size: 0.65rem;
    font-family: 'SF Mono', 'Fira Code', monospace;
    color: var(--text-tertiary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .accounts-sidebar-balance {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--green);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .accounts-sidebar-balance-group {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.1rem;
    flex-shrink: 0;
  }

  .accounts-sidebar-change {
    font-size: 0.65rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .accounts-sidebar-change.positive { color: var(--green); }
  .accounts-sidebar-change.negative { color: var(--red); }

  .accounts-sidebar-delete-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 4px;
    border: none;
    background: transparent;
    color: var(--text-tertiary);
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.15s, background 0.15s, color 0.15s;
    flex-shrink: 0;
    margin-left: 0.25rem;
  }

  .accounts-sidebar-item:hover .accounts-sidebar-delete-btn {
    opacity: 1;
  }

  .accounts-sidebar-delete-btn:hover {
    background: rgba(239, 68, 68, 0.12);
    color: #ef4444;
  }

  .accounts-sidebar-empty {
    text-align: center;
    padding: 1.25rem 0.75rem;
    color: var(--text-tertiary);
  }

  .accounts-sidebar-empty-icon {
    font-size: 1.5rem;
    margin-bottom: 0.4rem;
    opacity: 0.5;
  }

  .accounts-sidebar-empty-text {
    font-size: 0.72rem;
    line-height: 1.5;
    color: var(--text-tertiary);
  }

  .accounts-sidebar-connect-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    width: 100%;
    margin-top: 0.875rem;
    padding: 0.55rem 0.75rem;
    border-radius: var(--radius-sm);
    border: 1.5px dashed var(--border-strong);
    background: transparent;
    color: var(--text-secondary);
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s;
  }

  .accounts-sidebar-connect-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--accent-light);
  }

  .accounts-sidebar-loading {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    gap: 0.5rem;
    color: var(--text-tertiary);
    font-size: 0.75rem;
  }

  .accounts-sidebar-loading .spinner {
    width: 16px;
    height: 16px;
  }

  @media (max-width: 600px) {
    .accounts-sidebar {
      padding: 0.75rem;
      margin-bottom: 1rem;
    }

    .accounts-sidebar-item {
      padding: 0.5rem 0.625rem;
    }
  }
</style>

<div class="accounts-sidebar" id="accounts-sidebar">
  <div class="accounts-sidebar-header">
    <div class="accounts-sidebar-title">
      <span class="accounts-sidebar-title-dot"></span>
      Connected Accounts
    </div>
    <span class="accounts-sidebar-count" id="accounts-sidebar-count"></span>
  </div>

  <!-- Loading state -->
  <div class="accounts-sidebar-loading" id="accounts-sidebar-loading">
    <div class="spinner"></div>
    Loading accounts...
  </div>

  <!-- Account list (populated by accounts.js) -->
  <div class="accounts-sidebar-list" id="accounts-sidebar-list" style="display:none;"></div>

  <!-- Empty state -->
  <div class="accounts-sidebar-empty" id="accounts-sidebar-empty" style="display:none;">
    <div class="accounts-sidebar-empty-icon">🔗</div>
    <div class="accounts-sidebar-empty-text">
      No accounts connected yet.<br>
      Connect once, reuse across all bots.
    </div>
  </div>

  <!-- Connect Account button -->
  <button class="accounts-sidebar-connect-btn" id="accounts-sidebar-connect-btn" onclick="openConnectModal('cex')">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="12" y1="5" x2="12" y2="19"></line>
      <line x1="5" y1="12" x2="19" y2="12"></line>
    </svg>
    Connect Account
  </button>
</div>
