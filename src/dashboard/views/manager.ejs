<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>DRIFT — Bot Manager</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg: #0d0f14;
      --surface: #141820;
      --surface-2: #1a2030;
      --border: #1e2535;
      --border-strong: #28334a;
      --text-primary: #e8edf5;
      --text-secondary: #8a9bb5;
      --text-tertiary: #4a5a72;
      --accent: #f5a623;
      --accent-light: rgba(245,166,35,0.12);
      --accent-hover: #ffb83d;
      --green: #1db954;
      --green-bg: rgba(29,185,84,0.12);
      --green-border: rgba(29,185,84,0.3);
      --red: #e8404a;
      --red-bg: rgba(232,64,74,0.12);
      --red-border: rgba(232,64,74,0.3);
      --yellow: #f5a623;
      --shadow-sm: 0 1px 4px rgba(0,0,0,0.4), 0 1px 2px rgba(0,0,0,0.3);
      --shadow-md: 0 4px 16px rgba(0,0,0,0.5), 0 2px 4px rgba(0,0,0,0.3);
      --shadow-lg: 0 10px 32px rgba(0,0,0,0.65), 0 4px 8px rgba(0,0,0,0.4);
      --radius: 12px;
      --radius-sm: 8px;
      --radius-xs: 6px;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Inter', 'Segoe UI', sans-serif;
      background: var(--bg);
      color: var(--text-primary);
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
    }

    .topnav {
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      padding: 0 2rem;
      height: 56px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 100;
      box-shadow: var(--shadow-sm);
    }
    .topnav-brand { display: flex; align-items: center; gap: 0.6rem; font-size: 1rem; font-weight: 700; color: var(--text-primary); letter-spacing: -0.02em; min-width: 0; overflow: hidden; flex: 1; }
    .topnav-brand .brand-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); }
    .topnav-right { display: flex; align-items: center; gap: 0.5rem; flex-shrink: 0; }
    .topnav-link { font-size: 0.8rem; font-weight: 600; color: var(--text-secondary); text-decoration: none; padding: 0.4rem 0.75rem; border-radius: var(--radius-xs); transition: all 0.15s; }
    .topnav-link:hover { color: var(--text-primary); background: var(--surface-2); }
    .live-indicator { display: flex; align-items: center; gap: 0.45rem; background: var(--surface-2); border: 1px solid var(--border); border-radius: 20px; padding: 0.3rem 0.75rem 0.3rem 0.55rem; font-size: 0.78rem; font-weight: 700; color: var(--text-primary); letter-spacing: 0.06em; }
    .live-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--green); flex-shrink: 0; box-shadow: 0 0 0 2px rgba(29,185,84,0.25); animation: pulse 2s infinite; }
    @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }

    body.light {
      --bg: #f0f2f7; --surface: #ffffff; --surface-2: #f5f7fb; --border: #dde2ee; --border-strong: #c8d0e0;
      --text-primary: #0f1623; --text-secondary: #4a5a72; --text-tertiary: #8a9bb5;
      --shadow-sm: 0 1px 4px rgba(0,0,0,0.08), 0 1px 2px rgba(0,0,0,0.05);
      --shadow-md: 0 4px 16px rgba(0,0,0,0.10), 0 2px 4px rgba(0,0,0,0.06);
      --shadow-lg: 0 10px 32px rgba(0,0,0,0.12), 0 4px 8px rgba(0,0,0,0.07);
    }
    .theme-toggle-btn { width: 32px; height: 32px; border-radius: 50%; border: 1px solid var(--border); background: var(--surface-2); color: var(--text-secondary); cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all 0.15s; flex-shrink: 0; }
    .theme-toggle-btn:hover { border-color: var(--accent); color: var(--accent); background: var(--accent-light); }

    .page { max-width: 1440px; margin: 0 auto; padding: 2rem 2rem 4rem; }
    .page-header { margin-bottom: 2rem; }
    .page-title { font-size: 1.5rem; font-weight: 700; color: var(--text-primary); letter-spacing: -0.03em; margin-bottom: 0.25rem; }
    .page-subtitle { font-size: 0.85rem; color: var(--text-secondary); }

    .stats-row { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 1rem; margin-bottom: 2rem; }
    .stat-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 1.25rem 1.5rem; box-shadow: var(--shadow-sm); transition: box-shadow 0.2s; }
    .stat-card:hover { box-shadow: var(--shadow-md); }
    .stat-card.primary { background: linear-gradient(135deg, #c47a10 0%, #f5a623 100%); border-color: transparent; color: white; }
    .stat-label { font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-tertiary); margin-bottom: 0.5rem; }
    .stat-card.primary .stat-label { color: rgba(255,255,255,0.65); }
    .stat-value { font-size: 1.75rem; font-weight: 800; color: var(--text-primary); letter-spacing: -0.04em; line-height: 1; }
    .stat-card.primary .stat-value { color: white; font-size: 2.25rem; }
    .stat-value.positive { color: var(--green); }
    .stat-value.negative { color: var(--red); }
    .stat-sub { font-size: 0.75rem; color: var(--text-tertiary); margin-top: 0.35rem; }
    .stat-card.primary .stat-sub { color: rgba(255,255,255,0.55); }

    .toolbar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.25rem; }
    .filter-group { display: flex; gap: 0.25rem; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 3px; box-shadow: var(--shadow-sm); }
    .filter-btn { background: transparent; border: none; color: var(--text-secondary); padding: 0.35rem 0.85rem; cursor: pointer; font-size: 0.8rem; font-weight: 500; border-radius: 6px; transition: all 0.15s; }
    .filter-btn:hover { background: var(--surface-2); color: var(--text-primary); }
    .filter-btn.active { background: var(--accent); color: white; box-shadow: 0 1px 4px rgba(79,110,247,0.35); }
    .bot-count { font-size: 0.8rem; color: var(--text-tertiary); }

    .bot-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(400px, 1fr)); gap: 1.25rem; }
    .bot-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 1.5rem; box-shadow: var(--shadow-sm); transition: all 0.2s; position: relative; overflow: hidden; }
    .bot-card:hover { box-shadow: var(--shadow-lg); transform: translateY(-2px); border-color: var(--border-strong); }
    .bot-card.inactive { opacity: 0.65; }
    .bot-card.inactive:hover { opacity: 1; }
    .bot-card.active::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; background: linear-gradient(90deg, #c47a10, #f5a623); border-radius: var(--radius) var(--radius) 0 0; }
    .bot-card.paused::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; background: linear-gradient(90deg, #ca8a04, #eab308); border-radius: var(--radius) var(--radius) 0 0; }
    .bot-card.paused { opacity: 0.85; }

    .card-header { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 1rem; }
    .card-identity { display: flex; flex-direction: column; gap: 0.3rem; }
    .card-name { font-size: 1rem; font-weight: 700; color: var(--text-primary); letter-spacing: -0.02em; }
    .card-meta { display: flex; align-items: center; gap: 0.5rem; }
    .exchange-badge { font-size: 0.58rem; font-weight: 700; letter-spacing: 0.06em; padding: 0.15rem 0.4rem; border-radius: 4px; background: var(--accent-light); color: var(--accent); text-transform: uppercase; }
    .strategy-tag { font-size: 0.58rem; font-weight: 500; color: var(--text-tertiary); background: var(--surface-2); border: 1px solid var(--border); padding: 0.15rem 0.4rem; border-radius: 4px; }
    .status-pill { display: flex; align-items: center; gap: 0.35rem; font-size: 0.7rem; font-weight: 600; letter-spacing: 0.05em; padding: 0.3rem 0.65rem; border-radius: 20px; white-space: nowrap; }
    .status-pill.active { background: var(--green-bg); color: var(--green); border: 1px solid var(--green-border); }
    .status-pill.inactive { background: var(--surface-2); color: var(--text-tertiary); border: 1px solid var(--border); }
    .status-pill.paused { background: rgba(234, 179, 8, 0.1); color: #eab308; border: 1px solid rgba(234, 179, 8, 0.3); }
    .status-dot { width: 5px; height: 5px; border-radius: 50%; background: currentColor; }
    .status-pill.active .status-dot { animation: pulse 2s infinite; }

    .sparkline-wrap { margin-bottom: 1rem; min-height: 44px; position: relative; }
    .sparkline-wrap canvas { width: 100% !important; height: 44px !important; }
    .sparkline-empty { height: 44px; display: flex; align-items: center; justify-content: center; font-size: 0.72rem; color: var(--text-tertiary); background: var(--surface-2); border-radius: var(--radius-xs); border: 1px dashed var(--border); }

    .live-pos-widget { background: var(--surface-2); border: 1px solid var(--border); border-radius: var(--radius-xs); padding: 0.5rem 0.65rem; margin-bottom: 1rem; }
    .live-pos-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.35rem; }
    .live-pos-side { font-size: 0.65rem; font-weight: 800; letter-spacing: 0.05em; padding: 0.1rem 0.4rem; border-radius: 4px; }
    .live-pos-side.pos-long { background: rgba(29,185,84,0.1); color: #1db954; border: 1px solid rgba(29,185,84,0.3); }
    .live-pos-side.pos-short { background: rgba(232,64,74,0.1); color: #e8404a; border: 1px solid rgba(232,64,74,0.3); }
    .live-pos-pnl { font-size: 0.78rem; font-weight: 700; font-variant-numeric: tabular-nums; }
    .live-pos-pnl.positive { color: #1db954; }
    .live-pos-pnl.negative { color: #e8404a; }
    .live-pos-rows { display: grid; grid-template-columns: 1fr 1fr; gap: 0.1rem 0.5rem; }
    .live-pos-row { display: flex; justify-content: space-between; font-size: 0.62rem; color: var(--text-secondary); }
    .live-pos-row span:last-child { font-weight: 600; color: var(--text-primary); font-variant-numeric: tabular-nums; }

    .pnl-hero { display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 1rem; }
    .pnl-breakdown { display: flex; flex-direction: column; gap: 0.25rem; padding: 0.5rem 0; }
    .pnl-row { display: flex; justify-content: space-between; align-items: center; }
    .pnl-label-sm { font-size: 0.68rem; color: var(--text-tertiary); font-weight: 500; }
    .pnl-value-sm { font-size: 0.78rem; font-weight: 700; letter-spacing: -0.02em; }
    .pnl-value-sm.positive { color: var(--green); }
    .pnl-value-sm.negative { color: var(--red); }
    .pnl-value-sm.neutral { color: var(--text-secondary); }
    .pnl-value-sm.fee { color: var(--red); }
    .pnl-divider { height: 1px; background: var(--border); margin: 0.25rem 0; }
    .pnl-value { font-size: 1.6rem; font-weight: 800; letter-spacing: -0.04em; line-height: 1; }
    .pnl-value.positive { color: var(--green); }
    .pnl-value.negative { color: var(--red); }
    .pnl-value.neutral { color: var(--text-secondary); }
    .pnl-label { font-size: 0.72rem; color: var(--text-tertiary); font-weight: 500; }

    .card-stats { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0.75rem; padding: 0.875rem; background: var(--surface-2); border: 1px solid var(--border); border-radius: var(--radius-sm); margin-bottom: 1rem; }
    .stat-item { display: flex; flex-direction: column; gap: 0.2rem; }
    .stat-item-label { font-size: 0.65rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-tertiary); }
    .stat-item-value { font-size: 0.85rem; font-weight: 700; color: var(--text-primary); }
    .stat-item-value.positive { color: var(--green); }
    .stat-item-value.negative { color: var(--red); }

    .card-actions { display: flex; gap: 0.5rem; }
    .btn { display: inline-flex; align-items: center; justify-content: center; gap: 0.35rem; padding: 0.55rem 1rem; border-radius: var(--radius-xs); font-size: 0.8rem; font-weight: 600; cursor: pointer; transition: all 0.15s; text-decoration: none; border: none; white-space: nowrap; }
    .btn-primary { background: var(--accent); color: white; flex: 1; box-shadow: 0 1px 4px rgba(245,166,35,0.3); }
    .btn-primary:hover { background: var(--accent-hover); box-shadow: 0 2px 8px rgba(245,166,35,0.4); transform: translateY(-1px); }
    .btn-warning { background: rgba(234, 179, 8, 0.15); color: #eab308; border: 1px solid rgba(234, 179, 8, 0.3); flex: 1; }
    .btn-warning:hover { background: rgba(234, 179, 8, 0.25); }
    .btn-danger { background: var(--red-bg); color: var(--red); border: 1px solid var(--red-border); flex: 1; }
    .btn-danger:hover { background: #fee2e2; }
    .btn-ghost { background: transparent; color: var(--text-secondary); border: 1px solid var(--border); }
    .btn-ghost:hover { background: var(--surface-2); color: var(--text-primary); border-color: var(--border-strong); }

    /* AI Signal Engine Strip */
    .ai-strip { margin: 0 0rem 0.75rem; background: var(--surface-2); border-radius: var(--radius-sm); padding: 0.625rem 0.75rem; display: flex; flex-direction: column; gap: 0.5rem; }
    .ai-strip-title { font-size: 0.625rem; font-weight: 500; letter-spacing: 0.07em; text-transform: uppercase; color: var(--text-3); display: flex; align-items: center; gap: 0.375rem; margin-bottom: 0.125rem; }
    .ai-row { display: flex; gap: 0.5rem; flex-wrap: wrap; }
    .ai-pill { display: flex; align-items: center; gap: 0.375rem; font-size: 0.6875rem; padding: 0.25rem 0.625rem; border-radius: 100px; border: 0.5px solid var(--border); background: var(--surface); }
    .ai-pill-label { color: var(--text-3); }
    .ai-pill-val { font-weight: 500; color: var(--text-1); }
    .ai-pill-val.regime-sideway { color: #BA7517; }
    .ai-pill-val.regime-trend { color: #1D9E75; }
    .ai-pill-val.macro-fear { color: #E24B4A; }
    .ai-pill-val.macro-greed { color: #1D9E75; }
    .ai-pill-val.size-mult { color: #1D9E75; }
    .ai-pill-val.direction-long { color: #1D9E75; }
    .ai-pill-val.direction-short { color: #E24B4A; }
    .conf-bar-wrap { display: flex; align-items: center; gap: 0.5rem; }
    .conf-label { font-size: 0.6875rem; color: var(--text-3); white-space: nowrap; }
    .conf-track { flex: 1; height: 4px; background: var(--border); border-radius: 2px; overflow: hidden; }
    .conf-fill { height: 100%; border-radius: 2px; transition: width 0.6s ease; }
    .conf-pct { font-size: 0.6875rem; font-weight: 500; min-width: 1.75rem; text-align: right; }
    .decision-log { margin-top: 0.25rem; border: 0.5px solid var(--border); border-radius: var(--radius-sm); overflow: hidden; }
    .log-header { padding: 0.375rem 0.75rem; background: var(--surface-2); font-size: 0.625rem; font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-3); display: flex; justify-content: space-between; align-items: center; }
    .log-row { padding: 0.375rem 0.75rem; font-size: 0.6875rem; border-top: 0.5px solid var(--border); display: flex; justify-content: space-between; align-items: center; }
    .log-gate { color: var(--text-2); }
    .log-pass { color: #1D9E75; font-weight: 500; }
    .log-fail { color: #E24B4A; font-weight: 500; }
    .log-skip { color: var(--text-3); }

    .state-loading, .state-empty, .state-error { grid-column: 1 / -1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 4rem 2rem; color: var(--text-tertiary); font-size: 0.875rem; gap: 0.75rem; }
    .state-error { color: var(--red); }
    .spinner { width: 24px; height: 24px; border: 2px solid var(--border); border-top-color: var(--accent); border-radius: 50%; animation: spin 0.7s linear infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }

    @media (max-width: 900px) { .stats-row { grid-template-columns: 1fr 1fr; } .stats-row .stat-card.primary { grid-column: 1 / -1; } }
    @media (max-width: 600px) {
      .page { padding: 0.75rem 0.75rem 3rem; }
      .stats-row { grid-template-columns: 1fr 1fr; gap: 0.5rem; margin-bottom: 1rem; }
      .stats-row .stat-card.primary { grid-column: 1 / -1; }
      .stat-value { font-size: 1.4rem; }
      .stat-card.primary .stat-value { font-size: 1.75rem; }
      .stat-card { padding: 0.875rem 1rem; }
      .bot-grid { grid-template-columns: 1fr; }
      .topnav { padding: 0 0.75rem; }
      .topnav-subtitle { display: none; }
      .live-indicator { display: none; }
      .bot-count { display: none; }
      .toolbar { margin-bottom: 0.75rem; }
    }

    /* ── Market Intelligence Panel ─────────────────────────────────────── */
    .mi-panel { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem 1.25rem; margin-bottom: 1.5rem; }
    .mi-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.875rem; }
    .mi-title { font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-tertiary); display: flex; align-items: center; gap: 0.45rem; }
    .mi-title-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); }
    .mi-updated { font-size: 0.68rem; color: var(--text-tertiary); }
    .mi-grid { display: grid; grid-template-columns: 1fr 1fr 1fr 2fr; gap: 0.875rem; }
    @media (max-width: 1100px) { .mi-grid { grid-template-columns: 1fr 1fr; } .mi-news { grid-column: 1 / -1; } }
    @media (max-width: 600px) { .mi-grid { grid-template-columns: 1fr; } }
    .mi-cell { background: var(--surface-2); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 0.75rem 0.875rem; }
    .mi-cell-label { font-size: 0.65rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em; color: var(--text-tertiary); margin-bottom: 0.4rem; }
    .mi-cell-value { font-size: 1.35rem; font-weight: 800; letter-spacing: -0.03em; color: var(--text-primary); line-height: 1; }
    .mi-cell-sub { font-size: 0.7rem; color: var(--text-secondary); margin-top: 0.3rem; }
    .mi-fg-bar { height: 5px; border-radius: 3px; margin-top: 0.5rem; background: linear-gradient(to right, #e8404a 0%, #f5a623 25%, #f5a623 50%, #1db954 75%, #1db954 100%); position: relative; }
    .mi-fg-thumb { position: absolute; top: -3px; width: 11px; height: 11px; border-radius: 50%; background: #fff; border: 2px solid var(--border-strong); transform: translateX(-50%); transition: left 0.4s ease; }
    .mi-etf-bull { color: var(--green); }
    .mi-etf-bear { color: var(--red); }
    .mi-etf-neutral { color: var(--text-secondary); }
    .mi-macro-high { color: var(--red); }
    .mi-macro-medium { color: var(--yellow); }
    .mi-macro-low { color: var(--green); }
    .mi-news { }
    .mi-news-list { list-style: none; display: flex; flex-direction: column; gap: 0.35rem; }
    .mi-news-item { font-size: 0.72rem; color: var(--text-secondary); line-height: 1.4; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; padding: 0.2rem 0; border-bottom: 1px solid var(--border); }
    .mi-news-item:last-child { border-bottom: none; }
    .mi-skeleton { background: var(--border); border-radius: 4px; animation: shimmer 1.4s infinite; }
    @keyframes shimmer { 0%,100%{opacity:.4} 50%{opacity:.9} }

    .wallet-widget { position: relative; }
    .wallet-chip { display: flex; align-items: center; gap: 0.45rem; background: var(--surface-2); border: 1px solid var(--border); border-radius: 20px; padding: 0.3rem 0.75rem 0.3rem 0.55rem; cursor: pointer; transition: all 0.15s; color: var(--text-primary); font-size: 0.78rem; font-weight: 600; }
    .wallet-chip:hover { border-color: var(--accent); background: var(--surface); }
    .wallet-chip-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--green); flex-shrink: 0; box-shadow: 0 0 0 2px rgba(29,185,84,0.25); }
    .wallet-chip-addr { font-family: 'SF Mono','Fira Code',monospace; letter-spacing: 0.01em; }
    .wallet-popup { display: none; position: absolute; top: calc(100% + 10px); right: 0; background: var(--surface); border: 1px solid var(--border-strong); border-radius: var(--radius); box-shadow: var(--shadow-lg); padding: 1rem; min-width: 220px; max-width: calc(100vw - 1.5rem); z-index: 500; animation: popupIn 0.12s ease; }
    .wallet-popup.open { display: block; }
    @keyframes popupIn { from { opacity:0; transform:translateY(-6px); } to { opacity:1; transform:translateY(0); } }
    .wallet-popup-addr { font-size: 1rem; font-weight: 800; color: var(--text-primary); letter-spacing: -0.02em; text-align: center; margin-bottom: 0.2rem; }
    .wallet-popup-full { font-size: 0.62rem; color: var(--text-tertiary); font-family: 'SF Mono','Fira Code',monospace; text-align: center; margin-bottom: 1rem; word-break: break-all; line-height: 1.5; }
    .wallet-popup-actions { display: flex; gap: 0.5rem; }
    .wallet-popup-btn { flex: 1; display: flex; align-items: center; justify-content: center; gap: 0.4rem; padding: 0.55rem 0.5rem; border-radius: var(--radius-sm); font-size: 0.75rem; font-weight: 600; cursor: pointer; transition: all 0.15s; background: var(--surface-2); border: 1px solid var(--border); color: var(--text-secondary); }
    .wallet-popup-btn:hover { background: var(--border); color: var(--text-primary); }
    .wallet-popup-btn-danger { color: var(--red); border-color: var(--red-border); background: var(--red-bg); }
    .wallet-popup-btn-danger:hover { background: rgba(232,64,74,0.2); }
