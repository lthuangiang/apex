  <!-- ── Market Intelligence polling ──────────────────────────────────── -->
  <script>
  (function() {
    var POLL_MS = 5 * 60 * 1000;
    var fgLabels = ['Extreme Fear','Fear','Neutral','Greed','Extreme Greed'];
    var etfClassMap = { strong_bull:'mi-etf-bull', bull:'mi-etf-bull', neutral:'mi-etf-neutral', bear:'mi-etf-bear', strong_bear:'mi-etf-bear' };
    var macroClassMap = { HIGH:'mi-macro-high', MEDIUM:'mi-macro-medium', LOW:'mi-macro-low' };

    function fmtMoney(n) {
      if (n == null) return '—';
      var abs = Math.abs(n);
      var s = abs >= 1e9 ? (abs/1e9).toFixed(2)+'B' : abs >= 1e6 ? (abs/1e6).toFixed(1)+'M' : abs.toFixed(0);
      return (n < 0 ? '-$' : '+$') + s;
    }

    function renderSnapshot(snap) {
      var now = new Date(snap.fetchedAt);
      document.getElementById('mi-updated').textContent = 'Updated ' + now.toLocaleTimeString();

      // Fear & Greed
      var fg = snap.fearGreed && snap.fearGreed.status === 'fulfilled' ? snap.fearGreed.value : null;
      if (fg && fg.value != null) {
        var idx = fg.value;
        document.getElementById('mi-fg-value').textContent = idx;
        var label = idx <= 20 ? fgLabels[0] : idx <= 40 ? fgLabels[1] : idx <= 60 ? fgLabels[2] : idx <= 80 ? fgLabels[3] : fgLabels[4];
        document.getElementById('mi-fg-label').textContent = label + (fg.source === 'alternative.me' ? ' (alt)' : '');
        document.getElementById('mi-fg-thumb').style.left = idx + '%';
      }

      // ETF Flow
      var etf = snap.etfFlow && snap.etfFlow.status === 'fulfilled' ? snap.etfFlow.value : null;
      if (etf) {
        var etfEl = document.getElementById('mi-etf-value');
        etfEl.textContent = fmtMoney(etf.netInflow);
        etfEl.className = 'mi-cell-value ' + (etfClassMap[etf.signal] || 'mi-etf-neutral');
        document.getElementById('mi-etf-signal').textContent = (etf.signal || '—').replace(/_/g,' ');
      }

      // Macro Risk
      var macro = snap.macroRisk && snap.macroRisk.status === 'fulfilled' ? snap.macroRisk.value : null;
      if (macro) {
        var macroEl = document.getElementById('mi-macro-value');
        macroEl.textContent = macro.level || '—';
        macroEl.className = 'mi-cell-value ' + (macroClassMap[macro.level] || '');
        var evts = (macro.upcomingEvents || []).slice(0,2).map(function(e){ return e.name; }).join(', ');
        document.getElementById('mi-macro-sub').textContent = evts || 'No high-impact events';
      }

      // Hot News
      var news = snap.hotNews && snap.hotNews.status === 'fulfilled' ? snap.hotNews.value : null;
      var list = document.getElementById('mi-news-list');
      if (news && Array.isArray(news) && news.length) {
        list.innerHTML = news.slice(0,5).map(function(n){
          return '<li class="mi-news-item" title="' + (n.title||'').replace(/"/g,'&quot;') + '">' + (n.title || '') + '</li>';
        }).join('');
      } else {
        list.innerHTML = '<li class="mi-news-item mi-etf-neutral">No news data</li>';
      }
    }

    function fetchMI() {
      fetch('/api/sosovalue/snapshot').then(function(r){ return r.json(); }).then(function(data){
        renderSnapshot(data);
      }).catch(function(err){
        document.getElementById('mi-updated').textContent = 'Unavailable';
        console.warn('[MI]', err);
      });
    }

    fetchMI();
    setInterval(fetchMI, POLL_MS);
  })();
  </script>
