  <!-- ── Wizard JS ─────────────────────────────────────────────────────────── -->
  <script>
  (function () {
    'use strict';

    // ── State ─────────────────────────────────────────────────────────────────
    var state = {
      step: 0,
      exchange: 'sodex',
      botType: 'standard',
      symbol: '',
      symbolB: '',
      symbols: [],
    };

    var TOTAL_STEPS = 5;

    // ── DOM refs ──────────────────────────────────────────────────────────────
    var overlay   = document.getElementById('wz-overlay');
    var errBanner = document.getElementById('wz-error');
    var nextBtn   = document.getElementById('wz-next');
    var backBtn   = document.getElementById('wz-back');
    var counter   = document.getElementById('wz-step-counter');

    // ── Open / Close ──────────────────────────────────────────────────────────
    document.getElementById('btn-create-bot').addEventListener('click', openWizard);
    document.getElementById('wz-close').addEventListener('click', closeWizard);
    overlay.addEventListener('click', function (e) { if (e.target === overlay) closeWizard(); });

    function openWizard() {
      resetState();
      document.body.classList.add('modal-open');
      overlay.classList.add('open');
      goToStep(0);
    }

    function closeWizard() {
      overlay.classList.remove('open');
      document.body.classList.remove('modal-open');
    }

    function resetState() {
      state.step = 0;
      state.exchange = 'sodex';
      state.botType = 'standard';
      state.symbol = '';
      state.symbolB = '';
      state.symbols = [];
      clearErrors();
      // Reset exchange tiles
      document.querySelectorAll('.ex-tile').forEach(function (t) {
        t.classList.toggle('selected', t.dataset.exchange === 'sodex');
      });
      // Reset type tiles
      document.querySelectorAll('.type-tile').forEach(function (t) {
        t.classList.toggle('selected', t.dataset.type === 'standard');
      });
      // Reset form inputs
      ['wz-id','wz-name','wz-tags','wz-apiKey','wz-subaccount','wz-apiSecret',
       'wz-nodeApiKey','wz-decibelSubaccount','wz-privateKey',
       'wz-userAddress','wz-dangoPrivateKey',
       'wz-hibachiApiKey','wz-hibachiAccountId','wz-hibachiPrivateKey','wz-hibachiSecretKey'].forEach(function (id) {
        var el = document.getElementById(id);
        if (el) el.value = '';
      });
      document.getElementById('wz-mode').value = 'farm';
      document.getElementById('wz-network').value = 'mainnet';
      document.getElementById('wz-hibachiAccountType').value = 'trustless';
      document.getElementById('wz-hibachi-trustless-row').style.display = '';
      document.getElementById('wz-hibachi-managed-row').style.display = 'none';
      document.getElementById('wz-autoStart').checked = false;
      document.getElementById('wz-legValueUsd').value = '1000';
      document.getElementById('wz-holdingPeriodSecs').value = '300';
      document.getElementById('wz-profitTargetUsd').value = '50';
      document.getElementById('wz-maxLossUsd').value = '30';
    }

    // ── Step navigation ───────────────────────────────────────────────────────
    nextBtn.addEventListener('click', function () {
      // Use step index instead of button text to avoid emoji matching issues
      if (state.step === TOTAL_STEPS - 1) {
        submitBot();
      } else {
        if (validateStep(state.step)) goToStep(state.step + 1);
      }
    });

    backBtn.addEventListener('click', function () {
      goToStep(state.step - 1);
    });

    function goToStep(n) {
      clearErrors();
      // Hide all panels
      document.querySelectorAll('.wz-panel').forEach(function (p) { p.classList.remove('active'); });
      document.getElementById('wz-panel-' + n).classList.add('active');

      // Update step indicators
      document.querySelectorAll('.wz-step').forEach(function (s) {
        var i = parseInt(s.dataset.step, 10);
        s.classList.remove('active', 'done');
        if (i < n) s.classList.add('done');
        else if (i === n) s.classList.add('active');
      });

      state.step = n;
      counter.textContent = 'Step ' + (n + 1) + ' of ' + TOTAL_STEPS;
      backBtn.style.display = n > 0 ? '' : 'none';

      // Always set button text based on current step — never leave stale "Launch Bot" on non-final steps
      nextBtn.disabled = false;
      nextBtn.textContent = n === TOTAL_STEPS - 1 ? '\uD83D\uDE80 Launch Bot' : 'Next \u2192';

      // Side effects per step
      if (n === 1) showCredsPanel();
      if (n === 2) loadSymbols();
      if (n === 3) showHedgeConfig();
      if (n === 4) buildReview();
    }

    // ── Step 0: Exchange + Type tiles ─────────────────────────────────────────
    document.querySelectorAll('.ex-tile').forEach(function (tile) {
      tile.addEventListener('click', function () {
        state.exchange = tile.dataset.exchange;
        state.symbol = '';
        state.symbolB = '';
        document.querySelectorAll('.ex-tile').forEach(function (t) { t.classList.remove('selected'); });
        tile.classList.add('selected');
        // Auto-fill bot ID
        var idEl = document.getElementById('wz-id');
        if (idEl && !idEl.value) idEl.value = 'my-' + state.exchange + '-bot';
        var nameEl = document.getElementById('wz-name');
        if (nameEl && !nameEl.value) nameEl.value = state.exchange.charAt(0).toUpperCase() + state.exchange.slice(1) + ' Bot';
      });
    });

    document.querySelectorAll('.type-tile').forEach(function (tile) {
      tile.addEventListener('click', function () {
        state.botType = tile.dataset.type;
        document.querySelectorAll('.type-tile').forEach(function (t) { t.classList.remove('selected'); });
        tile.classList.add('selected');
      });
    });

    // ── Hibachi account type toggle ───────────────────────────────────────────
    document.getElementById('wz-hibachiAccountType').addEventListener('change', function () {
      var isTrustless = this.value === 'trustless';
      document.getElementById('wz-hibachi-trustless-row').style.display = isTrustless ? '' : 'none';
      document.getElementById('wz-hibachi-managed-row').style.display   = isTrustless ? 'none' : '';
    });

    // ── Step 1: Credentials panel ─────────────────────────────────────────────
    function showCredsPanel() {
      ['sodex','decibel','dango','hibachi'].forEach(function (ex) {
        var el = document.getElementById('wz-creds-' + ex);
        if (el) el.style.display = ex === state.exchange ? '' : 'none';
      });
    }

    // ── Step 2: Symbol loading ────────────────────────────────────────────────
    var BTC_DEFAULTS = { sodex: 'BTC-USD', decibel: 'BTC/USD', dango: 'BTC-USD', hibachi: 'BTC/USDT-P' };

    function loadSymbols() {
      var title = document.getElementById('wz-market-title');
      title.textContent = state.botType === 'hedge' ? 'Symbol A (Long leg)' : 'Select Symbol';

      var bSection = document.getElementById('wz-sym-b-section');
      bSection.style.display = state.botType === 'hedge' ? '' : 'none';

      var loading  = document.getElementById('wz-sym-loading');
      var ready   = document.getElementById('wz-sym-ready');
      var fallback = document.getElementById('wz-sym-fallback');
      var selA    = document.getElementById('wz-sym-select');
      var selB    = document.getElementById('wz-sym-select-b');
      var meta    = document.getElementById('wz-sym-meta');

      // Reset state
      loading.style.display  = '';
      ready.style.display    = 'none';
      fallback.style.display = 'none';
      selA.innerHTML = '<option value="">— Select symbol —</option>';
      selB.innerHTML = '<option value="">— Select symbol —</option>';
      state.symbol  = '';
      state.symbolB = '';
      if (meta) meta.textContent = '';

      fetch('/api/exchanges/' + state.exchange + '/symbols')
        .then(function (r) { return r.json(); })
        .then(function (data) {
          var symbols = data.symbols;
          loading.style.display = 'none';

          if (symbols && symbols.length > 0) {
            ready.style.display = '';
            // Populate dropdown
            symbols.forEach(function (sym) {
              [selA, selB].forEach(function (sel) {
                var opt = document.createElement('option');
                opt.value = sym;
                opt.textContent = sym;
                sel.appendChild(opt);
              });
            });
            // Auto-select BTC default for this exchange
            var btcDefault = BTC_DEFAULTS[state.exchange] || (symbols[0] || '');
            // Try exact match first, then first available
            var btcIdx = symbols.indexOf(btcDefault);
            var selected = btcIdx >= 0 ? btcDefault : symbols[0];
            selA.value = selected;
            state.symbol = selected;
            if (meta) meta.textContent = 'Trading pair for ' + state.exchange.toUpperCase() + ' — ' + selected;
            if (selB) { selB.value = ''; }
          } else {
            // Live fetch failed or returned empty — show manual input
            fallback.style.display = '';
            var manual = document.getElementById('wz-sym-manual');
            if (manual) manual.value = BTC_DEFAULTS[state.exchange] || '';
          }
        })
        .catch(function () {
          loading.style.display = 'none';
          fallback.style.display = '';
          var manual = document.getElementById('wz-sym-manual');
          if (manual) manual.value = BTC_DEFAULTS[state.exchange] || '';
        });
    }

    // Wire select change → state
    document.getElementById('wz-sym-select').addEventListener('change', function () {
      state.symbol = this.value;
      hideFieldError('symbol');
    });
    document.getElementById('wz-sym-select-b').addEventListener('change', function () {
      state.symbolB = this.value;
      hideFieldError('symbolB');
    });
    // Manual fallback input
    document.getElementById('wz-sym-manual').addEventListener('input', function () {
      state.symbol = this.value.trim().toUpperCase();
      hideFieldError('symbol');
    });

    // ── Step 3: Hedge config visibility ──────────────────────────────────────
    function showHedgeConfig() {
      document.getElementById('wz-hedge-config').style.display = state.botType === 'hedge' ? '' : 'none';
    }

    // ── Step 4: Review ────────────────────────────────────────────────────────
    function buildReview() {
      try {
        var grid = document.getElementById('wz-review-grid');
        if (!grid) return;

        var idEl   = document.getElementById('wz-id');
        var nameEl = document.getElementById('wz-name');
        var modeEl = document.getElementById('wz-mode');
        var tagsEl = document.getElementById('wz-tags');
        var autoEl = document.getElementById('wz-autoStart');

        var id   = idEl   ? idEl.value.trim()   : '';
        var name = nameEl ? nameEl.value.trim()  : '';
        var mode = modeEl ? modeEl.value         : 'farm';
        var tags = tagsEl ? tagsEl.value.trim()  : '';

        var items = [
          { label: 'Exchange',     value: state.exchange.toUpperCase(), accent: true },
          { label: 'Bot Type',     value: state.botType === 'hedge' ? 'Hedge Bot ⚖️' : 'Standard Bot 🤖' },
          { label: 'Bot ID',       value: id   || '(not set)' },
          { label: 'Display Name', value: name || '(not set)' },
          { label: 'Symbol',       value: state.botType === 'hedge'
              ? (state.symbol || '?') + ' / ' + (state.symbolB || '?')
              : (state.symbol || '(not set)') },
          { label: 'Mode',         value: mode === 'farm' ? 'Farm' : 'Trade' },
        ];
        if (tags) items.push({ label: 'Tags', value: tags });
        if (state.botType === 'hedge') {
          var lvEl = document.getElementById('wz-legValueUsd');
          items.push({ label: 'Leg Value', value: '$' + (lvEl ? lvEl.value : '1000') });
        }
        if (autoEl && autoEl.checked) {
          items.push({ label: 'Auto-start', value: 'Yes', accent: true });
        }

        grid.innerHTML = items.map(function (item) {
          return '<div class="review-item">' +
                   '<div class="review-label">' + item.label + '</div>' +
                   '<div class="review-value' + (item.accent ? ' accent' : '') + '">' + item.value + '</div>' +
                 '</div>';
        }).join('');
      } catch (e) {
        console.error('[Wizard] buildReview error:', e);
      }
    }

    // ── Validation ────────────────────────────────────────────────────────────
    function validateStep(step) {
      clearErrors();
      var ok = true;

      if (step === 0) {
        // Exchange and type are always selected (tiles default)
        return true;
      }

      if (step === 1) {
        if (state.exchange === 'sodex') {
          if (!val('wz-apiKey'))     { showFieldError('apiKey', 'API Key is required'); ok = false; }
          if (!val('wz-subaccount')) { showFieldError('subaccount', 'Subaccount address is required'); ok = false; }
          if (!val('wz-apiSecret'))  { showFieldError('apiSecret', 'Private key is required'); ok = false; }
        } else if (state.exchange === 'decibel') {
          if (!val('wz-privateKey')) { showFieldError('privateKey', 'Private key is required'); ok = false; }
        } else if (state.exchange === 'dango') {
          if (!val('wz-userAddress'))     { showFieldError('userAddress', 'User address is required'); ok = false; }
          if (!val('wz-dangoPrivateKey')) { showFieldError('dangoPrivateKey', 'Private key is required'); ok = false; }
        } else if (state.exchange === 'hibachi') {
          if (!val('wz-hibachiApiKey')) { showFieldError('hibachiApiKey', 'API Key is required'); ok = false; }
          if (!val('wz-hibachiAccountId')) { showFieldError('hibachiAccountId', 'Account ID is required'); ok = false; }
          var acctType = document.getElementById('wz-hibachiAccountType').value;
          if (acctType === 'trustless') {
            var pk = val('wz-hibachiPrivateKey');
            if (!pk) { showFieldError('hibachiPrivateKey', 'Private key is required'); ok = false; }
            else if (!/^0x[0-9a-fA-F]{64}$/.test(pk)) { showFieldError('hibachiPrivateKey', 'Must be 0x-prefixed 64-char hex'); ok = false; }
          } else {
            if (!val('wz-hibachiSecretKey')) { showFieldError('hibachiSecretKey', 'Secret key is required'); ok = false; }
          }
        }
        return ok;
      }

      if (step === 2) {
        if (!state.symbol) { showFieldError('symbol', 'Please select a symbol'); ok = false; }
        if (state.botType === 'hedge') {
          if (!state.symbolB) { showFieldError('symbolB', 'Please select Symbol B'); ok = false; }
          if (state.symbol && state.symbolB && state.symbol === state.symbolB) {
            showFieldError('symbolB', 'Symbol B must be different from Symbol A'); ok = false;
          }
        }
        return ok;
      }

      if (step === 3) {
        var id = val('wz-id');
        if (!id) { showFieldError('id', 'Bot ID is required'); ok = false; }
        else if (!/^[a-z0-9][a-z0-9\-]*$/.test(id)) { showFieldError('id', 'Lowercase letters, numbers, hyphens only'); ok = false; }
        if (!val('wz-name')) { showFieldError('name', 'Display name is required'); ok = false; }
        if (state.botType === 'hedge') {
          var lv = parseFloat(document.getElementById('wz-legValueUsd').value);
          if (!lv || lv <= 0) { showFieldError('legValueUsd', 'Must be greater than 0'); ok = false; }
        }
        return ok;
      }

      return ok;
    }

    function val(id) {
      var el = document.getElementById(id);
      return el ? el.value.trim() : '';
    }

    function showFieldError(field, msg) {
      var errEl = document.getElementById('err-' + field);
      var inputEl = document.getElementById('wz-' + field);
      if (errEl) { errEl.textContent = msg; errEl.classList.add('visible'); errEl.style.display = ''; }
      if (inputEl) inputEl.classList.add('error');
    }

    function hideFieldError(field) {
      var errEl = document.getElementById('err-' + field);
      var inputEl = document.getElementById('wz-' + field);
      if (errEl) { errEl.classList.remove('visible'); }
      if (inputEl) inputEl.classList.remove('error');
    }

    function clearErrors() {
      errBanner.classList.remove('visible');
      document.querySelectorAll('.wz-field-error').forEach(function (e) { e.classList.remove('visible'); });
      document.querySelectorAll('.wz-input.error, .wz-select.error').forEach(function (e) { e.classList.remove('error'); });
    }

    // Clear field error on input
    document.querySelectorAll('.wz-input, .wz-select').forEach(function (el) {
      el.addEventListener('input', function () {
        el.classList.remove('error');
        var id = el.id.replace('wz-', '');
        var errEl = document.getElementById('err-' + id);
        if (errEl) errEl.classList.remove('visible');
      });
    });

    // ── Submit ────────────────────────────────────────────────────────────────
    async function submitBot() {
      clearErrors();
      nextBtn.disabled = true;
      nextBtn.textContent = 'Launching\u2026';

      try {
        var payload = buildPayload();
        console.log('[Wizard] Submitting bot:', JSON.stringify(Object.assign({}, payload, {
          apiSecret: payload.apiSecret ? '***' : undefined,
          privateKey: payload.privateKey ? '***' : undefined,
          dangoPrivateKey: payload.dangoPrivateKey ? '***' : undefined,
          hibachiPrivateKey: payload.hibachiPrivateKey ? '***' : undefined,
          hibachiSecretKey: payload.hibachiSecretKey ? '***' : undefined,
        })));

        var r = await fetch('/api/bots', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        var json = await r.json();
        if (!r.ok) {
          console.error('[Wizard] Server error:', r.status, json);
          throw Object.assign(new Error(json.error || json.hint || 'Failed to create bot'), { _status: r.status, _body: json });
        }
        closeWizard();
        if (typeof refresh === 'function') refresh();
      } catch (err) {
        console.error('[Wizard] submitBot error:', err);
        err.message && (errBanner.textContent = err.message);
        errBanner.classList.add('visible');
        errBanner.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        // credential errors → go back to credentials step
        var msg = (err.message || '').toLowerCase();
        var isCredErr = msg.includes('missing credentials') || msg.includes('invalid credentials') ||
                        msg.includes('authentication failed') || msg.includes('unauthorized') ||
                        msg.startsWith('missing sodex') || msg.startsWith('missing dango') ||
                        msg.startsWith('missing decibel') || msg.startsWith('missing hibachi');
        if (isCredErr) goToStep(1);
      } finally {
        nextBtn.disabled = false;
        // Only restore "Launch Bot" text if we're still on the final step.
        // If a credential error sent us back to step 1, goToStep() already set the correct text.
        if (state.step === TOTAL_STEPS - 1) {
          nextBtn.textContent = '\uD83D\uDE80 Launch Bot';
        }
      }
    }

    function buildPayload() {
      var id   = val('wz-id');
      var name = val('wz-name');
      var mode = document.getElementById('wz-mode').value;
      var tags = val('wz-tags').split(',').map(function (t) { return t.trim(); }).filter(Boolean);
      var autoStart = document.getElementById('wz-autoStart').checked;

      var base = {
        id:              id,
        name:            name,
        exchange:        state.exchange,
        credentialKey:   id,   // Bot ID — adapter already created inline from credentials
        tradeLogBackend: 'json',
        tradeLogPath:    './trades-' + id + '.json',
        tags:            tags,
        autoStart:       autoStart,
      };

      // Attach credentials
      if (state.exchange === 'sodex') {
        base.apiKey    = val('wz-apiKey');
        base.apiSecret = val('wz-apiSecret');
        base.subaccount = val('wz-subaccount');
      } else if (state.exchange === 'decibel') {
        base.privateKey          = val('wz-privateKey');
        base.nodeApiKey          = val('wz-nodeApiKey');
        base.subaccount          = val('wz-decibelSubaccount');
      } else if (state.exchange === 'dango') {
        base.dangoPrivateKey = val('wz-dangoPrivateKey');
        base.userAddress     = val('wz-userAddress');
        base.network         = document.getElementById('wz-network').value;
      } else if (state.exchange === 'hibachi') {
        base.hibachiApiKey      = val('wz-hibachiApiKey');
        base.hibachiAccountId   = val('wz-hibachiAccountId');
        base.hibachiAccountType = document.getElementById('wz-hibachiAccountType').value;
        if (base.hibachiAccountType === 'trustless') {
          base.hibachiPrivateKey = val('wz-hibachiPrivateKey');
        } else {
          base.hibachiSecretKey = val('wz-hibachiSecretKey');
        }
      }

      if (state.botType === 'hedge') {
        return Object.assign({}, base, {
          botType:               'hedge',
          symbolA:               state.symbol,
          symbolB:               state.symbolB,
          legValueUsd:           parseFloat(document.getElementById('wz-legValueUsd').value) || 1000,
          holdingPeriodSecs:     parseInt(document.getElementById('wz-holdingPeriodSecs').value, 10) || 300,
          profitTargetUsd:       parseFloat(document.getElementById('wz-profitTargetUsd').value) || 50,
          maxLossUsd:            parseFloat(document.getElementById('wz-maxLossUsd').value) || 30,
          volumeSpikeMultiplier: 2.0,
          volumeRollingWindow:   20,
          fundingRateWeight:     0.1,
          cooldownSecs:          30,
        });
      }

      return Object.assign({}, base, {
        symbol:       state.symbol,
        mode:         mode,
        orderSizeMin: 0.003,
        orderSizeMax: 0.005,
      });
    }

  })();
  </script>

  <!-- ── Theme Toggle JS ── -->
  <script>
  (function () {
    function applyTheme(isLight) {
      document.body.classList.toggle('light', isLight);
      var moon = document.querySelector('.icon-moon');
      var sun  = document.querySelector('.icon-sun');
      if (moon) moon.style.display = isLight ? 'none'  : '';
      if (sun)  sun.style.display  = isLight ? ''      : 'none';
    }
    applyTheme(document.body.classList.contains('light'));
    window.toggleTheme = function () {
      var isLight = !document.body.classList.contains('light');
      localStorage.setItem('drift-theme', isLight ? 'light' : 'dark');
      applyTheme(isLight);
    };
  })();
  </script>

  <!-- ── Copy toast ── -->
  <div class="copy-toast" id="copy-toast">✓ Address copied</div>

  <!-- ── Wallet Widget JS ── -->
  <script>
  (function () {
    var fullAddress = null;
    function shortAddr(addr) { return addr.slice(0, 6) + '\u2026' + addr.slice(-4); }

    fetch('/api/auth/me')
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (!data.ok || !data.address) return;
        fullAddress = data.address;
        var short = shortAddr(fullAddress);
        document.getElementById('wallet-chip-addr').textContent = short;
        document.getElementById('wallet-popup-addr').textContent = short;
        document.getElementById('wallet-popup-full').textContent = fullAddress;
        document.getElementById('wallet-widget').style.display = '';
      })
      .catch(function () {});

    window.toggleWalletPopup = function (e) {
      e.stopPropagation();
      document.getElementById('wallet-popup').classList.toggle('open');
    };
    document.addEventListener('click', function (e) {
      var popup = document.getElementById('wallet-popup');
      var chip  = document.getElementById('wallet-chip');
      if (popup && !popup.contains(e.target) && e.target !== chip) popup.classList.remove('open');
    });
    window.copyWalletAddress = function () {
      if (!fullAddress) return;
      navigator.clipboard.writeText(fullAddress).then(function () {
        var toast = document.getElementById('copy-toast');
        toast.classList.add('show');
        setTimeout(function () { toast.classList.remove('show'); }, 2000);
        var btn = document.getElementById('btn-copy-addr');
        var orig = btn.innerHTML;
        btn.innerHTML = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Copied!';
        setTimeout(function () { btn.innerHTML = orig; }, 2000);
      }).catch(function () {
        var ta = document.createElement('textarea');
        ta.value = fullAddress; ta.style.position = 'fixed'; ta.style.opacity = '0';
        document.body.appendChild(ta); ta.select(); document.execCommand('copy'); document.body.removeChild(ta);
      });
      document.getElementById('wallet-popup').classList.remove('open');
    };
    window.walletDisconnect = function () {
      fetch('/api/auth/logout', { method: 'POST' }).finally(function () { window.location.href = '/wallet-login'; });
    };
  })();
  </script>
