<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>DRIFT — Bot Manager</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg: #0d0f14;
      --surface: #141820;
      --surface-2: #1a2030;
      --border: #1e2535;
      --border-strong: #28334a;
      --text-primary: #e8edf5;
      --text-secondary: #8a9bb5;
      --text-tertiary: #4a5a72;
      --accent: #f5a623;
      --accent-light: rgba(245,166,35,0.12);
      --accent-hover: #ffb83d;
      --green: #1db954;
      --green-bg: rgba(29,185,84,0.12);
      --green-border: rgba(29,185,84,0.3);
      --red: #e8404a;
      --red-bg: rgba(232,64,74,0.12);
      --red-border: rgba(232,64,74,0.3);
      --yellow: #f5a623;
      --shadow-sm: 0 1px 4px rgba(0,0,0,0.4), 0 1px 2px rgba(0,0,0,0.3);
      --shadow-md: 0 4px 16px rgba(0,0,0,0.5), 0 2px 4px rgba(0,0,0,0.3);
      --shadow-lg: 0 10px 32px rgba(0,0,0,0.65), 0 4px 8px rgba(0,0,0,0.4);
      --radius: 12px;
      --radius-sm: 8px;
      --radius-xs: 6px;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Inter', 'Segoe UI', sans-serif;
      background: var(--bg);
      color: var(--text-primary);
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
    }

    /* ── Top Nav ── */
    .topnav {
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      padding: 0 2rem;
      height: 56px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 100;
      box-shadow: var(--shadow-sm);
    }

    .topnav-brand {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      font-size: 1rem;
      font-weight: 700;
      color: var(--text-primary);
      letter-spacing: -0.02em;
    }

    .topnav-brand .brand-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--accent);
    }

    .topnav-right {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .live-indicator {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      font-size: 0.72rem;
      font-weight: 500;
      color: var(--text-tertiary);
      letter-spacing: 0.04em;
    }

    .live-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--green);
      animation: pulse 2s infinite;
    }

    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.4; }
    }

    /* ── Light Mode ── */
    body.light {
      --bg: #f0f2f7;
      --surface: #ffffff;
      --surface-2: #f5f7fb;
      --border: #dde2ee;
      --border-strong: #c8d0e0;
      --text-primary: #0f1623;
      --text-secondary: #4a5a72;
      --text-tertiary: #8a9bb5;
      --shadow-sm: 0 1px 4px rgba(0,0,0,0.08), 0 1px 2px rgba(0,0,0,0.05);
      --shadow-md: 0 4px 16px rgba(0,0,0,0.10), 0 2px 4px rgba(0,0,0,0.06);
      --shadow-lg: 0 10px 32px rgba(0,0,0,0.12), 0 4px 8px rgba(0,0,0,0.07);
    }

    /* ── Theme Toggle Button ── */
    .theme-toggle-btn {
      width: 32px; height: 32px;
      border-radius: 50%;
      border: 1px solid var(--border);
      background: var(--surface-2);
      color: var(--text-secondary);
      cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      transition: all 0.15s;
      flex-shrink: 0;
    }
    .theme-toggle-btn:hover {
      border-color: var(--accent);
      color: var(--accent);
      background: var(--accent-light);
    }

    /* ── Page Layout ── */
    .page {
      max-width: 1440px;
      margin: 0 auto;
      padding: 2rem 2rem 4rem;
    }

    .page-header {
      margin-bottom: 2rem;
    }

    .page-title {
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--text-primary);
      letter-spacing: -0.03em;
      margin-bottom: 0.25rem;
    }

    .page-subtitle {
      font-size: 0.85rem;
      color: var(--text-secondary);
    }

    /* ── Stats Row ── */
    .stats-row {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr 1fr;
      gap: 1rem;
      margin-bottom: 2rem;
    }

    .stat-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1.25rem 1.5rem;
      box-shadow: var(--shadow-sm);
      transition: box-shadow 0.2s;
    }

    .stat-card:hover {
      box-shadow: var(--shadow-md);
    }

    .stat-card.primary {
      background: linear-gradient(135deg, #c47a10 0%, #f5a623 100%);
      border-color: transparent;
      color: white;
    }

    .stat-label {
      font-size: 0.7rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--text-tertiary);
      margin-bottom: 0.5rem;
    }

    .stat-card.primary .stat-label {
      color: rgba(255,255,255,0.65);
    }

    .stat-value {
      font-size: 1.75rem;
      font-weight: 800;
      color: var(--text-primary);
      letter-spacing: -0.04em;
      line-height: 1;
    }

    .stat-card.primary .stat-value {
      color: white;
      font-size: 2.25rem;
    }

    .stat-value.positive { color: var(--green); }
    .stat-value.negative { color: var(--red); }

    .stat-sub {
      font-size: 0.75rem;
      color: var(--text-tertiary);
      margin-top: 0.35rem;
    }

    .stat-card.primary .stat-sub {
      color: rgba(255,255,255,0.55);
    }

    /* ── Toolbar ── */
    .toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1.25rem;
    }

    .filter-group {
      display: flex;
      gap: 0.25rem;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      padding: 3px;
      box-shadow: var(--shadow-sm);
    }

    .filter-btn {
      background: transparent;
      border: none;
      color: var(--text-secondary);
      padding: 0.35rem 0.85rem;
      cursor: pointer;
      font-size: 0.8rem;
      font-weight: 500;
      border-radius: 6px;
      transition: all 0.15s;
    }

    .filter-btn:hover {
      background: var(--surface-2);
      color: var(--text-primary);
    }

    .filter-btn.active {
      background: var(--accent);
      color: white;
      box-shadow: 0 1px 4px rgba(79,110,247,0.35);
    }

    .bot-count {
      font-size: 0.8rem;
      color: var(--text-tertiary);
    }

    /* ── Bot Grid ── */
    .bot-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
      gap: 1.25rem;
    }

    /* ── Bot Card ── */
    .bot-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1.5rem;
      box-shadow: var(--shadow-sm);
      transition: all 0.2s;
      position: relative;
      overflow: hidden;
    }

    .bot-card:hover {
      box-shadow: var(--shadow-lg);
      transform: translateY(-2px);
      border-color: var(--border-strong);
    }

    .bot-card.inactive {
      opacity: 0.65;
    }

    .bot-card.inactive:hover {
      opacity: 1;
    }

    /* Active card accent line */
    .bot-card.active::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 3px;
      background: linear-gradient(90deg, #c47a10, #f5a623);
      border-radius: var(--radius) var(--radius) 0 0;
    }

    /* ── Card Header ── */
    .card-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      margin-bottom: 1rem;
    }

    .card-identity {
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
    }

    .card-name {
      font-size: 1rem;
      font-weight: 700;
      color: var(--text-primary);
      letter-spacing: -0.02em;
    }

    .card-meta {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .exchange-badge {
      font-size: 0.65rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      padding: 0.2rem 0.5rem;
      border-radius: 4px;
      background: var(--accent-light);
      color: var(--accent);
      text-transform: uppercase;
    }

    .strategy-tag {
      font-size: 0.65rem;
      font-weight: 500;
      color: var(--text-tertiary);
      background: var(--surface-2);
      border: 1px solid var(--border);
      padding: 0.2rem 0.5rem;
      border-radius: 4px;
    }

    .status-pill {
      display: flex;
      align-items: center;
      gap: 0.35rem;
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.05em;
      padding: 0.3rem 0.65rem;
      border-radius: 20px;
      white-space: nowrap;
    }

    .status-pill.active {
      background: var(--green-bg);
      color: var(--green);
      border: 1px solid var(--green-border);
    }

    .status-pill.inactive {
      background: var(--surface-2);
      color: var(--text-tertiary);
      border: 1px solid var(--border);
    }

    .status-dot {
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: currentColor;
    }

    .status-pill.active .status-dot {
      animation: pulse 2s infinite;
    }

    /* ── Sparkline ── */
    .sparkline-wrap {
      margin-bottom: 1rem;
      min-height: 44px;
      position: relative;
    }

    .sparkline-wrap canvas {
      width: 100% !important;
      height: 44px !important;
    }

    .sparkline-empty {
      height: 44px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.72rem;
      color: var(--text-tertiary);
      background: var(--surface-2);
      border-radius: var(--radius-xs);
      border: 1px dashed var(--border);
    }

    /* ── Live Position Widget (replaces sparkline when position open) ── */
    .live-pos-widget {
      background: var(--surface-2);
      border: 1px solid var(--border);
      border-radius: var(--radius-xs);
      padding: 0.5rem 0.65rem;
      margin-bottom: 1rem;
    }

    .live-pos-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 0.35rem;
    }

    .live-pos-side {
      font-size: 0.65rem;
      font-weight: 800;
      letter-spacing: 0.05em;
      padding: 0.1rem 0.4rem;
      border-radius: 4px;
    }

    .live-pos-side.pos-long {
      background: rgba(29,185,84,0.1);
      color: #1db954;
      border: 1px solid rgba(29,185,84,0.3);
    }

    .live-pos-side.pos-short {
      background: rgba(232,64,74,0.1);
      color: #e8404a;
      border: 1px solid rgba(232,64,74,0.3);
    }

    .live-pos-pnl {
      font-size: 0.78rem;
      font-weight: 700;
      font-variant-numeric: tabular-nums;
    }

    .live-pos-pnl.positive { color: #1db954; }
    .live-pos-pnl.negative { color: #e8404a; }

    .live-pos-rows {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.1rem 0.5rem;
    }

    .live-pos-row {
      display: flex;
      justify-content: space-between;
      font-size: 0.62rem;
      color: var(--text-secondary);
    }

    .live-pos-row span:last-child {
      font-weight: 600;
      color: var(--text-primary);
      font-variant-numeric: tabular-nums;
    }

    /* ── PnL Hero ── */
    .pnl-hero {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      margin-bottom: 1rem;
    }

    .pnl-breakdown {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
      padding: 0.5rem 0;
    }

    .pnl-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .pnl-label-sm {
      font-size: 0.68rem;
      color: var(--text-tertiary);
      font-weight: 500;
    }

    .pnl-value-sm {
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: -0.02em;
    }

    .pnl-value-sm.positive { color: var(--green); }
    .pnl-value-sm.negative { color: var(--red); }
    .pnl-value-sm.neutral { color: var(--text-secondary); }
    .pnl-value-sm.fee { color: var(--red); }

    .pnl-divider {
      height: 1px;
      background: var(--border);
      margin: 0.25rem 0;
    }

    .pnl-value {
      font-size: 1.6rem;
      font-weight: 800;
      letter-spacing: -0.04em;
      line-height: 1;
    }

    .pnl-value.positive { color: var(--green); }
    .pnl-value.negative { color: var(--red); }
    .pnl-value.neutral { color: var(--text-secondary); }

    .pnl-label {
      font-size: 0.72rem;
      color: var(--text-tertiary);
      font-weight: 500;
    }

    /* ── Stats Grid ── */
    .card-stats {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 0.75rem;
      padding: 0.875rem;
      background: var(--surface-2);
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      margin-bottom: 1rem;
    }

    .stat-item {
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
    }

    .stat-item-label {
      font-size: 0.65rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--text-tertiary);
    }

    .stat-item-value {
      font-size: 0.85rem;
      font-weight: 700;
      color: var(--text-primary);
    }

    .stat-item-value.positive { color: var(--green); }
    .stat-item-value.negative { color: var(--red); }

    /* ── Actions ── */
    .card-actions {
      display: flex;
      gap: 0.5rem;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.35rem;
      padding: 0.55rem 1rem;
      border-radius: var(--radius-xs);
      font-size: 0.8rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.15s;
      text-decoration: none;
      border: none;
      white-space: nowrap;
    }

    .btn-primary {
      background: var(--accent);
      color: white;
      flex: 1;
      box-shadow: 0 1px 4px rgba(245,166,35,0.3);
    }

    .btn-primary:hover {
      background: var(--accent-hover);
      box-shadow: 0 2px 8px rgba(245,166,35,0.4);
      transform: translateY(-1px);
    }

    .btn-danger {
      background: var(--red-bg);
      color: var(--red);
      border: 1px solid var(--red-border);
      flex: 1;
    }

    .btn-danger:hover {
      background: #fee2e2;
    }

    .btn-ghost {
      background: transparent;
      color: var(--text-secondary);
      border: 1px solid var(--border);
    }

    .btn-ghost:hover {
      background: var(--surface-2);
      color: var(--text-primary);
      border-color: var(--border-strong);
    }

    /* ── Loading / Empty ── */
    .state-loading, .state-empty, .state-error {
      grid-column: 1 / -1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 4rem 2rem;
      color: var(--text-tertiary);
      font-size: 0.875rem;
      gap: 0.75rem;
    }

    .state-error { color: var(--red); }

    .spinner {
      width: 24px;
      height: 24px;
      border: 2px solid var(--border);
      border-top-color: var(--accent);
      border-radius: 50%;
      animation: spin 0.7s linear infinite;
    }

    @keyframes spin { to { transform: rotate(360deg); } }

    /* ── Responsive ── */
    @media (max-width: 900px) {
      .stats-row { grid-template-columns: 1fr 1fr; }
      .stats-row .stat-card.primary { grid-column: 1 / -1; }
    }

    @media (max-width: 600px) {
      .page { padding: 1rem 1rem 3rem; }
      .stats-row { grid-template-columns: 1fr; }
      .bot-grid { grid-template-columns: 1fr; }
      .topnav { padding: 0 1rem; }
    }

    /* ── Wallet Widget ── */
    .wallet-widget { position: relative; }

    .wallet-chip {
      display: flex; align-items: center; gap: 0.45rem;
      background: var(--surface-2); border: 1px solid var(--border);
      border-radius: 20px; padding: 0.3rem 0.75rem 0.3rem 0.55rem;
      cursor: pointer; transition: all 0.15s; color: var(--text-primary);
      font-size: 0.78rem; font-weight: 600;
    }
    .wallet-chip:hover { border-color: var(--accent); background: var(--surface); }

    .wallet-chip-dot {
      width: 7px; height: 7px; border-radius: 50%;
      background: var(--green); flex-shrink: 0;
      box-shadow: 0 0 0 2px rgba(29,185,84,0.25);
    }
    .wallet-chip-addr { font-family: 'SF Mono','Fira Code',monospace; letter-spacing: 0.01em; }

    .wallet-popup {
      display: none; position: absolute; top: calc(100% + 10px); right: 0;
      background: var(--surface); border: 1px solid var(--border-strong);
      border-radius: var(--radius); box-shadow: var(--shadow-lg);
      padding: 1rem; min-width: 240px; z-index: 500;
      animation: popupIn 0.12s ease;
    }
    .wallet-popup.open { display: block; }
    @keyframes popupIn { from { opacity:0; transform:translateY(-6px); } to { opacity:1; transform:translateY(0); } }

    .wallet-popup-addr {
      font-size: 1rem; font-weight: 800; color: var(--text-primary);
      letter-spacing: -0.02em; text-align: center; margin-bottom: 0.2rem;
    }
    .wallet-popup-full {
      font-size: 0.62rem; color: var(--text-tertiary);
      font-family: 'SF Mono','Fira Code',monospace;
      text-align: center; margin-bottom: 1rem;
      word-break: break-all; line-height: 1.5;
    }
    .wallet-popup-actions { display: flex; gap: 0.5rem; }
    .wallet-popup-btn {
      flex: 1; display: flex; align-items: center; justify-content: center; gap: 0.4rem;
      padding: 0.55rem 0.5rem; border-radius: var(--radius-sm);
      font-size: 0.75rem; font-weight: 600; cursor: pointer; transition: all 0.15s;
      background: var(--surface-2); border: 1px solid var(--border);
      color: var(--text-secondary);
    }
    .wallet-popup-btn:hover { background: var(--border); color: var(--text-primary); }
    .wallet-popup-btn-danger { color: var(--red); border-color: var(--red-border); background: var(--red-bg); }
    .wallet-popup-btn-danger:hover { background: rgba(232,64,74,0.2); }

    .copy-toast {
      position: fixed; bottom: 1.5rem; left: 50%; transform: translateX(-50%);
      background: var(--surface); border: 1px solid var(--green-border);
      color: var(--green); font-size: 0.78rem; font-weight: 600;
      padding: 0.5rem 1.25rem; border-radius: 20px; box-shadow: var(--shadow-md);
      opacity: 0; pointer-events: none; transition: opacity 0.2s;
      z-index: 9999;
    }
    .copy-toast.show { opacity: 1; }
  </style>
</head>
<body>
  <script>
    // Apply saved theme immediately to prevent flash
    (function() {
      if (localStorage.getItem('drift-theme') === 'light') {
        document.body.classList.add('light');
      }
    })();
  </script>

  <!-- Top Nav -->
  <nav class="topnav">
    <div class="topnav-brand">
      <div style="display:flex;flex-direction:column;gap:0.1rem">
        <span style="font-size:1rem;font-weight:800;color:var(--text-primary);letter-spacing:-0.02em">DRIFT — Let it run</span>
        <span style="font-size:0.65rem;color:var(--text-tertiary);font-weight:400">Autopilot trading · generates volume · executes strategies</span>
      </div>
    </div>
    <div class="topnav-right">
      <div class="live-indicator">
        <div class="live-dot"></div>
        <span>LIVE</span>
      </div>
      <!-- ── Theme Toggle ── -->
      <button class="theme-toggle-btn" id="theme-toggle" onclick="toggleTheme()" title="Toggle light/dark mode" aria-label="Toggle theme">
        <svg class="icon-moon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        <svg class="icon-sun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
      </button>
      <!-- ── Wallet Widget ── -->
      <div class="wallet-widget" id="wallet-widget" style="display:none">
        <button class="wallet-chip" id="wallet-chip" onclick="toggleWalletPopup(event)" aria-label="Wallet menu">
          <span class="wallet-chip-dot"></span>
          <span class="wallet-chip-addr" id="wallet-chip-addr">0x…</span>
          <svg width="10" height="10" viewBox="0 0 12 12" fill="none" style="opacity:.5;flex-shrink:0"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <!-- Popup -->
        <div class="wallet-popup" id="wallet-popup">
          <div class="wallet-popup-addr" id="wallet-popup-addr">0x…</div>
          <div class="wallet-popup-full" id="wallet-popup-full">0x0000…0000</div>
          <div class="wallet-popup-actions">
            <button class="wallet-popup-btn" id="btn-copy-addr" onclick="copyWalletAddress()">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
              Copy Address
            </button>
            <button class="wallet-popup-btn wallet-popup-btn-danger" onclick="walletDisconnect()">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
              Disconnect
            </button>
          </div>
        </div>
      </div>
    </div>
  </nav>

  <div class="page">

    <!-- Stats Row -->
    <div class="stats-row">
      <div class="stat-card primary">
        <div class="stat-label">Total PnL</div>
        <div class="stat-value" id="total-pnl">$0.00</div>
        <div class="stat-sub">Combined session across all bots</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Volume</div>
        <div class="stat-value" id="total-volume">$0</div>
        <div class="stat-sub">Session traded</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Active Bots</div>
        <div class="stat-value" id="active-bots">0</div>
        <div class="stat-sub" id="active-bots-sub">of 0 running</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Fees Paid</div>
        <div class="stat-value" id="total-fees">$0.00</div>
        <div class="stat-sub">Session total</div>
      </div>
    </div>

    <!-- Toolbar -->
    <div class="toolbar">
      <div class="filter-group">
        <button class="filter-btn active" data-filter="all">All</button>
        <button class="filter-btn" data-filter="active">Active</button>
        <button class="filter-btn" data-filter="inactive">Inactive</button>
      </div>
      <div style="display:flex;align-items:center;gap:0.75rem;">
        <span class="bot-count" id="bot-count-label"></span>
        <button class="btn btn-primary" id="btn-create-bot" style="padding:0.45rem 1rem;font-size:0.8rem;">
          + New Bot
        </button>
      </div>
    </div>

    <!-- Bot Grid -->
    <%- include('partials/bot-cards') %>

  </div>

  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <script src="/js/manager-dashboard.js?v=2"></script>

  <!-- ── Create Bot Modal ─────────────────────────────────────────────────── -->
  <style>
    .modal-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.45);
      z-index: 1000;
      align-items: center;
      justify-content: center;
    }
    .modal-overlay.open { display: flex; }
    .modal {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: var(--shadow-lg);
      width: 100%;
      max-width: 560px;
      max-height: 90vh;
      overflow-y: auto;
      padding: 2rem;
      position: relative;
    }
    .modal-title { font-size: 1.1rem; font-weight: 700; letter-spacing: -0.02em; margin-bottom: 1.5rem; color: var(--text-primary); }
    .modal-close { position: absolute; top: 1rem; right: 1rem; background: none; border: none; font-size: 1.25rem; cursor: pointer; color: var(--text-tertiary); line-height: 1; padding: 0.25rem; }
    .modal-close:hover { color: var(--text-primary); }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 0.75rem; }
    .form-row.full { grid-template-columns: 1fr; }
    .form-group { display: flex; flex-direction: column; gap: 0.3rem; }
    .form-label { font-size: 0.72rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-secondary); }
    .form-label .req { color: var(--red); margin-left: 2px; }
    .form-input, .form-select { padding: 0.55rem 0.75rem; border: 1px solid var(--border-strong); border-radius: var(--radius-xs); font-size: 0.85rem; color: var(--text-primary); background: var(--surface); transition: border-color 0.15s, box-shadow 0.15s; width: 100%; }
    .form-input:focus, .form-select:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px rgba(245,166,35,0.15); }
    .form-hint { font-size: 0.68rem; color: var(--text-tertiary); }
    .form-section { margin-top: 1.25rem; padding-top: 1.25rem; border-top: 1px solid var(--border); }
    .form-section-title { font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em; color: var(--text-tertiary); margin-bottom: 0.875rem; }
    .modal-footer { display: flex; gap: 0.75rem; justify-content: flex-end; margin-top: 1.75rem; padding-top: 1.25rem; border-top: 1px solid var(--border); }
    .modal-error { background: var(--red-bg); border: 1px solid var(--red-border); color: var(--red); border-radius: var(--radius-xs); padding: 0.6rem 0.875rem; font-size: 0.8rem; margin-bottom: 1rem; display: none; }
    .modal-error.visible { display: block; }
    .type-tabs { display: flex; gap: 0.5rem; margin-bottom: 1.25rem; }
    .type-tab { flex: 1; padding: 0.65rem; border: 2px solid var(--border); border-radius: var(--radius-sm); background: var(--surface); cursor: pointer; text-align: center; transition: all 0.15s; }
    .type-tab:hover { border-color: var(--accent); }
    .type-tab.selected { border-color: var(--accent); background: var(--accent-light); }
    .type-tab-title { font-size: 0.85rem; font-weight: 700; color: var(--text-primary); margin-bottom: 0.2rem; }
    .type-tab.selected .type-tab-title { color: var(--accent); }
    .type-tab-desc { font-size: 0.68rem; color: var(--text-tertiary); }
    .fields-standard, .fields-hedge { display: none; }
    .fields-standard.visible, .fields-hedge.visible { display: contents; }
    .checkbox-row { display: flex; align-items: center; gap: 0.5rem; margin-top: 0.25rem; }
    .checkbox-row input[type="checkbox"] { width: 16px; height: 16px; accent-color: var(--accent); cursor: pointer; }
    .checkbox-row label { font-size: 0.82rem; color: var(--text-secondary); cursor: pointer; }
  </style>

  <div class="modal-overlay" id="create-bot-modal">
    <div class="modal">
      <button class="modal-close" id="modal-close-btn" aria-label="Close">&#x2715;</button>
      <div class="modal-title">Create New Bot</div>
      <div class="modal-error" id="modal-error"></div>

      <div class="type-tabs">
        <div class="type-tab selected" data-type="standard" id="tab-standard">
          <div class="type-tab-title">Standard Bot</div>
          <div class="type-tab-desc">Farm / trade a single symbol</div>
        </div>
        <div class="type-tab" data-type="hedge" id="tab-hedge">
          <div class="type-tab-title">Hedge Bot</div>
          <div class="type-tab-desc">Correlated pair, delta-neutral</div>
        </div>
      </div>

      <form id="create-bot-form" autocomplete="off">
        <!-- Common fields -->
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Bot ID <span class="req">*</span></label>
            <input class="form-input" type="text" name="id" placeholder="my-bot-1" required />
            <span class="form-hint">Lowercase, hyphens only</span>
          </div>
          <div class="form-group">
            <label class="form-label">Display Name <span class="req">*</span></label>
            <input class="form-input" type="text" name="name" placeholder="My Bot" required />
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Exchange <span class="req">*</span></label>
            <select class="form-select" name="exchange" required>
              <option value="sodex">SoDEX</option>
              <option value="dango">Dango</option>
              <option value="decibel">Decibel</option>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label">Credential Key <span class="req">*</span></label>
            <input class="form-input" type="text" name="credentialKey" placeholder="SODEX" required />
            <span class="form-hint">Env prefix (e.g. SODEX_API_KEY)</span>
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Trade Log Backend</label>
            <select class="form-select" name="tradeLogBackend">
              <option value="json">JSON</option>
              <option value="sqlite">SQLite</option>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label">Trade Log Path <span class="req">*</span></label>
            <input class="form-input" type="text" name="tradeLogPath" placeholder="./trades-mybot.json" required />
          </div>
        </div>
        <div class="form-row full">
          <div class="form-group">
            <label class="form-label">Tags</label>
            <input class="form-input" type="text" name="tags" placeholder="Farm, TWAP (comma-separated)" />
          </div>
        </div>

        <!-- Standard Bot fields -->
        <div class="form-section fields-standard visible" id="fields-standard">
          <div class="form-section-title">Standard Bot Settings</div>
          <div class="form-row">
            <div class="form-group">
              <label class="form-label">Symbol <span class="req">*</span></label>
              <input class="form-input" type="text" name="symbol" placeholder="BTC-USD" />
            </div>
            <div class="form-group">
              <label class="form-label">Mode</label>
              <select class="form-select" name="mode">
                <option value="farm">Farm</option>
                <option value="trade">Trade</option>
              </select>
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label class="form-label">Order Size Min <span class="req">*</span></label>
              <input class="form-input" type="number" name="orderSizeMin" placeholder="0.003" step="0.001" min="0.001" />
            </div>
            <div class="form-group">
              <label class="form-label">Order Size Max <span class="req">*</span></label>
              <input class="form-input" type="number" name="orderSizeMax" placeholder="0.005" step="0.001" min="0.001" />
            </div>
          </div>
        </div>

        <!-- Hedge Bot fields -->
        <div class="form-section fields-hedge" id="fields-hedge">
          <div class="form-section-title">Hedge Bot Settings</div>
          <div class="form-row">
            <div class="form-group">
              <label class="form-label">Symbol A <span class="req">*</span></label>
              <input class="form-input" type="text" name="symbolA" placeholder="BTC-USD" />
            </div>
            <div class="form-group">
              <label class="form-label">Symbol B <span class="req">*</span></label>
              <input class="form-input" type="text" name="symbolB" placeholder="ETH-USD" />
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label class="form-label">Leg Value USD <span class="req">*</span></label>
              <input class="form-input" type="number" name="legValueUsd" placeholder="1000" min="1" />
            </div>
            <div class="form-group">
              <label class="form-label">Holding Period (secs) <span class="req">*</span></label>
              <input class="form-input" type="number" name="holdingPeriodSecs" placeholder="300" min="10" />
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label class="form-label">Profit Target USD <span class="req">*</span></label>
              <input class="form-input" type="number" name="profitTargetUsd" placeholder="50" min="0.01" step="0.01" />
            </div>
            <div class="form-group">
              <label class="form-label">Max Loss USD <span class="req">*</span></label>
              <input class="form-input" type="number" name="maxLossUsd" placeholder="30" min="0.01" step="0.01" />
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label class="form-label">Volume Spike Multiplier <span class="req">*</span></label>
              <input class="form-input" type="number" name="volumeSpikeMultiplier" placeholder="2.0" min="1.01" step="0.1" />
            </div>
            <div class="form-group">
              <label class="form-label">Volume Rolling Window <span class="req">*</span></label>
              <input class="form-input" type="number" name="volumeRollingWindow" placeholder="20" min="2" />
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label class="form-label">Funding Rate Weight</label>
              <input class="form-input" type="number" name="fundingRateWeight" placeholder="0.1" min="0" max="1" step="0.01" />
            </div>
            <div class="form-group">
              <label class="form-label">Cooldown (secs)</label>
              <input class="form-input" type="number" name="cooldownSecs" placeholder="30" min="0" />
            </div>
          </div>
        </div>

        <!-- Auto-start -->
        <div class="form-row full" style="margin-top:1rem;">
          <div class="checkbox-row">
            <input type="checkbox" name="autoStart" id="autoStart" />
            <label for="autoStart">Auto-start bot after creation</label>
          </div>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-ghost" id="modal-cancel-btn">Cancel</button>
          <button type="submit" class="btn btn-primary" id="modal-submit-btn">Create Bot</button>
        </div>
      </form>
    </div>
  </div>

  <script>
  (function() {
    var overlay    = document.getElementById('create-bot-modal');
    var form       = document.getElementById('create-bot-form');
    var errEl      = document.getElementById('modal-error');
    var submitBtn  = document.getElementById('modal-submit-btn');
    var selectedType = 'standard';

    document.getElementById('btn-create-bot').addEventListener('click', function() {
      overlay.classList.add('open');
      errEl.classList.remove('visible');
      form.reset();
      selectType('standard');
    });

    document.getElementById('modal-close-btn').addEventListener('click', closeModal);
    document.getElementById('modal-cancel-btn').addEventListener('click', closeModal);
    overlay.addEventListener('click', function(e) { if (e.target === overlay) closeModal(); });

    function closeModal() { overlay.classList.remove('open'); }

    document.querySelectorAll('.type-tab').forEach(function(tab) {
      tab.addEventListener('click', function() { selectType(tab.dataset.type); });
    });

    function selectType(type) {
      selectedType = type;
      document.querySelectorAll('.type-tab').forEach(function(t) {
        t.classList.toggle('selected', t.dataset.type === type);
      });
      document.getElementById('fields-standard').classList.toggle('visible', type === 'standard');
      document.getElementById('fields-hedge').classList.toggle('visible', type === 'hedge');
    }

    form.addEventListener('submit', async function(e) {
      e.preventDefault();
      errEl.classList.remove('visible');
      submitBtn.disabled = true;
      submitBtn.textContent = 'Creating\u2026';

      try {
        var data = buildPayload();
        var r = await fetch('/api/bots', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        var json = await r.json();
        if (!r.ok) throw new Error(json.error || 'Failed to create bot');
        closeModal();
        if (typeof refresh === 'function') refresh();
      } catch (err) {
        errEl.textContent = err.message;
        errEl.classList.add('visible');
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Create Bot';
      }
    });

    function buildPayload() {
      var fd = new FormData(form);
      var raw = Object.fromEntries(fd.entries());
      var tagsRaw = (raw.tags || '').toString().trim();
      var tags = tagsRaw ? tagsRaw.split(',').map(function(t) { return t.trim(); }).filter(Boolean) : [];

      var base = {
        id:              raw.id,
        name:            raw.name,
        exchange:        raw.exchange,
        credentialKey:   raw.credentialKey,
        tradeLogBackend: raw.tradeLogBackend,
        tradeLogPath:    raw.tradeLogPath,
        tags:            tags,
        autoStart:       form.querySelector('[name="autoStart"]').checked,
      };

      if (selectedType === 'hedge') {
        return Object.assign({}, base, {
          botType:               'hedge',
          symbolA:               raw.symbolA,
          symbolB:               raw.symbolB,
          legValueUsd:           parseFloat(raw.legValueUsd),
          holdingPeriodSecs:     parseInt(raw.holdingPeriodSecs, 10),
          profitTargetUsd:       parseFloat(raw.profitTargetUsd),
          maxLossUsd:            parseFloat(raw.maxLossUsd),
          volumeSpikeMultiplier: parseFloat(raw.volumeSpikeMultiplier),
          volumeRollingWindow:   parseInt(raw.volumeRollingWindow, 10),
          fundingRateWeight:     parseFloat(raw.fundingRateWeight || '0'),
          cooldownSecs:          raw.cooldownSecs ? parseInt(raw.cooldownSecs, 10) : undefined,
        });
      }

      return Object.assign({}, base, {
        symbol:       raw.symbol,
        mode:         raw.mode,
        orderSizeMin: parseFloat(raw.orderSizeMin),
        orderSizeMax: parseFloat(raw.orderSizeMax),
      });
    }
  })();
  </script>

  <!-- ── Theme Toggle JS ── -->
  <script>
  (function () {
    function applyTheme(isLight) {
      document.body.classList.toggle('light', isLight);
      var moon = document.querySelector('.icon-moon');
      var sun  = document.querySelector('.icon-sun');
      if (moon) moon.style.display = isLight ? 'none'  : '';
      if (sun)  sun.style.display  = isLight ? ''      : 'none';
    }

    // Apply icon state on load (body class already set by inline script)
    applyTheme(document.body.classList.contains('light'));

    window.toggleTheme = function () {
      var isLight = !document.body.classList.contains('light');
      localStorage.setItem('drift-theme', isLight ? 'light' : 'dark');
      applyTheme(isLight);
    };
  })();
  </script>

  <!-- ── Copy toast ── -->
  <div class="copy-toast" id="copy-toast">✓ Address copied</div>

  <!-- ── Wallet Widget JS ── -->
  <script>
  (function () {
    var fullAddress = null;

    function shortAddr(addr) {
      return addr.slice(0, 6) + '\u2026' + addr.slice(-4);
    }

    // Fetch session info and render widget
    fetch('/api/auth/me')
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (!data.ok || !data.address) return; // passcode auth — no address to show
        fullAddress = data.address;
        var short = shortAddr(fullAddress);
        document.getElementById('wallet-chip-addr').textContent = short;
        document.getElementById('wallet-popup-addr').textContent = short;
        document.getElementById('wallet-popup-full').textContent = fullAddress;
        document.getElementById('wallet-widget').style.display = '';
      })
      .catch(function () { /* not wallet-authed, hide widget */ });

    // Toggle popup
    window.toggleWalletPopup = function (e) {
      e.stopPropagation();
      document.getElementById('wallet-popup').classList.toggle('open');
    };

    // Close popup on outside click
    document.addEventListener('click', function (e) {
      var popup = document.getElementById('wallet-popup');
      var chip  = document.getElementById('wallet-chip');
      if (popup && !popup.contains(e.target) && e.target !== chip) {
        popup.classList.remove('open');
      }
    });

    // Copy address
    window.copyWalletAddress = function () {
      if (!fullAddress) return;
      navigator.clipboard.writeText(fullAddress).then(function () {
        var toast = document.getElementById('copy-toast');
        toast.classList.add('show');
        setTimeout(function () { toast.classList.remove('show'); }, 2000);
        // Update button text briefly
        var btn = document.getElementById('btn-copy-addr');
        var orig = btn.innerHTML;
        btn.innerHTML = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Copied!';
        setTimeout(function () { btn.innerHTML = orig; }, 2000);
      }).catch(function () {
        // Fallback for non-HTTPS
        var ta = document.createElement('textarea');
        ta.value = fullAddress;
        ta.style.position = 'fixed'; ta.style.opacity = '0';
        document.body.appendChild(ta); ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
      });
      document.getElementById('wallet-popup').classList.remove('open');
    };

    // Disconnect
    window.walletDisconnect = function () {
      fetch('/api/auth/logout', { method: 'POST' }).finally(function () {
        window.location.href = '/wallet-login';
      });
    };
  })();
  </script>
</body>
</html>