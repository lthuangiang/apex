  <!-- ═══ Agent Panel Live Polling ═══════════════════════════════════════════ -->
  <script>
  (function() {
    var AGENT_POLL_MS = 5000;

    function updateAgentPanel(data) {
      // Status badge
      var badge = document.getElementById('agent-status-badge');
      var state = data.lifecycleState || 'IDLE';
      badge.textContent = state;
      badge.className = 'status-pill ' + (state === 'RUNNING' ? 'active' : 'inactive');

      // Button states based on lifecycle
      var btnStart = document.getElementById('agent-btn-start');
      var btnPause = document.getElementById('agent-btn-pause');
      var btnStop = document.getElementById('agent-btn-stop');
      var isRunning = state === 'RUNNING';
      var isPaused = state === 'PAUSED';
      var isStopped = state === 'STOPPED' || state === 'IDLE';
      if (btnStart) { btnStart.disabled = isRunning; btnStart.style.opacity = isRunning ? '0.4' : '1'; btnStart.style.cursor = isRunning ? 'not-allowed' : 'pointer'; }
      if (btnPause) { btnPause.disabled = !isRunning; btnPause.style.opacity = !isRunning ? '0.4' : '1'; btnPause.style.cursor = !isRunning ? 'not-allowed' : 'pointer'; }
      if (btnStop) { btnStop.disabled = isStopped; btnStop.style.opacity = isStopped ? '0.4' : '1'; btnStop.style.cursor = isStopped ? 'not-allowed' : 'pointer'; }

      // Updated time
      document.getElementById('agent-updated').textContent = 'Cycle #' + (data.cycleCount || 0);

      // Last decision
      var d = data.lastDecision;
      if (d) {
        document.getElementById('agent-strategy').textContent = d.selectedStrategy || '—';
        var dirEl = document.getElementById('agent-direction');
        dirEl.textContent = (d.direction || '—').toUpperCase();
        dirEl.style.color = d.direction === 'long' ? 'var(--green)' : d.direction === 'short' ? 'var(--red)' : 'var(--text-secondary)';

        document.getElementById('agent-regime').textContent = (d.regime || '—').replace(/_/g, ' ');
        document.getElementById('agent-regime-conf').textContent = ((d.confidenceScore || 0) * 100).toFixed(0) + '% confidence';

        var sizeEl = document.getElementById('agent-size');
        sizeEl.textContent = d.allocatedSize ? d.allocatedSize.toFixed(5) + ' BTC' : '—';

        document.getElementById('agent-risk').textContent = d.riskGateStatus || '—';
        document.getElementById('agent-risk').style.color = d.riskGateStatus === 'OPEN' ? 'var(--green)' : 'var(--red)';
      }

      // Risk Gate
      if (data.riskGate) {
        document.getElementById('agent-risk-reason').textContent = data.riskGate.reason || '—';
      }

      // Portfolio
      if (data.portfolio) {
        document.getElementById('agent-exposure').textContent = 'Exposure: $' + (data.portfolio.totalOpenExposureUsd || 0).toFixed(0);
        var pnlEl = document.getElementById('agent-pnl');
        var pnl = data.dualObjective ? data.dualObjective.sessionPnl : (data.portfolio.sessionPnl || 0);
        pnlEl.textContent = '$' + pnl.toFixed(2);
        pnlEl.style.color = pnl >= 0 ? 'var(--green)' : 'var(--red)';
      }

      // Cycles
      document.getElementById('agent-cycles').textContent = data.cycleCount || 0;

      // Performance
      if (data.performance) {
        var farmWr = data.performance.farm ? (data.performance.farm.winRate * 100).toFixed(0) + '%' : '—';
        var tradeWr = data.performance.trade ? (data.performance.trade.winRate * 100).toFixed(0) + '%' : '—';
        document.getElementById('agent-farm-wr').textContent = farmWr;
        document.getElementById('agent-trade-wr').textContent = tradeWr;
      }

      // Latency
      if (data.latency) {
        document.getElementById('agent-latency').textContent = (data.latency.p50 || 0) + 'ms';
      }

      // 8-Signal breakdown from lastMarketContext
      if (data.lastMarketContext && data.lastMarketContext.intelligence) {
        var sig = data.lastMarketContext.intelligence.signals || {};
        var fgEl = document.getElementById('sig-fg');
        fgEl.textContent = sig.fearGreed || '—';
        fgEl.style.color = sig.fearGreed < 30 ? 'var(--red)' : sig.fearGreed > 60 ? 'var(--green)' : 'var(--text-1)';

        var etfEl = document.getElementById('sig-etf');
        etfEl.textContent = (sig.etfFlow || '—').replace(/_/g, ' ');
        etfEl.style.color = (sig.etfFlow || '').includes('bull') ? 'var(--green)' : (sig.etfFlow || '').includes('bear') ? 'var(--red)' : 'var(--text-2)';

        var oiEl = document.getElementById('sig-oi');
        var oiVal = sig.openInterest || 0;
        oiEl.textContent = oiVal >= 1e9 ? (oiVal/1e9).toFixed(1) + 'B' : oiVal >= 1e6 ? (oiVal/1e6).toFixed(0) + 'M' : oiVal;

        var frEl = document.getElementById('sig-fr');
        var fr = sig.fundingRate || 0;
        frEl.textContent = (fr * 100).toFixed(3) + '%';
        frEl.style.color = fr > 0.005 ? 'var(--green)' : fr < -0.005 ? 'var(--red)' : 'var(--text-2)';

        var scEl = document.getElementById('sig-sc');
        var sc = sig.stablecoinInflow || 0;
        scEl.textContent = sc >= 1e9 ? '+$' + (sc/1e9).toFixed(1) + 'B' : sc <= -1e9 ? '-$' + (Math.abs(sc)/1e9).toFixed(1) + 'B' : sc >= 0 ? '+$' + (sc/1e6).toFixed(0) + 'M' : '-$' + (Math.abs(sc)/1e6).toFixed(0) + 'M';
        scEl.style.color = sc > 0 ? 'var(--green)' : sc < 0 ? 'var(--red)' : 'var(--text-2)';

        document.getElementById('sig-macro').textContent = sig.macroRisk || 'none';
        document.getElementById('sig-macro').style.color = sig.macroRisk === 'high' ? 'var(--red)' : sig.macroRisk === 'elevated' ? '#f5a623' : 'var(--green)';

        var ssiEl = document.getElementById('sig-ssi');
        ssiEl.textContent = sig.ssiIndex ? sig.ssiIndex.toFixed(0) : '—';

        var sectorEl = document.getElementById('sig-sector');
        sectorEl.textContent = (sig.sectorSignal || '—').replace(/_/g, ' ');
        sectorEl.style.color = sig.sectorSignal === 'risk_on' ? 'var(--green)' : sig.sectorSignal === 'risk_off' ? 'var(--red)' : 'var(--text-2)';
      }

      // Decision history (from /agent/history could be fetched separately, use what we have)
      renderDecisions(data.lastDecision);
    }

    var decisionsBuffer = [];
    function renderDecisions(d) {
      if (!d) return;
      // Add to buffer (avoid duplicates by cycleId)
      if (decisionsBuffer.length === 0 || decisionsBuffer[0].cycleId !== d.cycleId) {
        decisionsBuffer.unshift(d);
        if (decisionsBuffer.length > 10) decisionsBuffer.length = 10;
      }
      document.getElementById('agent-decision-count').textContent = decisionsBuffer.length;
      var list = document.getElementById('agent-decisions-list');
      list.innerHTML = decisionsBuffer.map(function(dec) {
        var time = dec.timestamp ? dec.timestamp.slice(11, 19) : '—';
        var stratColor = dec.selectedStrategy === 'FARM' ? 'var(--accent)' : dec.selectedStrategy === 'TRADE' ? '#8b5cf6' : 'var(--text-secondary)';
        var dirColor = dec.direction === 'long' ? 'var(--green)' : dec.direction === 'short' ? 'var(--red)' : 'var(--text-tertiary)';
        return '<div class="log-row">' +
          '<span style="color:var(--text-tertiary);font-family:monospace;font-size:0.65rem;">' + time + '</span>' +
          '<span style="color:' + stratColor + ';font-weight:600;font-size:0.72rem;">' + dec.selectedStrategy + '</span>' +
          '<span style="color:' + dirColor + ';font-weight:500;font-size:0.72rem;">' + (dec.direction || '—').toUpperCase() + '</span>' +
          '<span style="font-size:0.68rem;color:var(--text-secondary);">' + (dec.regime || '').replace(/_/g,' ') + '</span>' +
          '<span class="' + (dec.riskGateStatus === 'OPEN' ? 'log-pass' : 'log-fail') + '" style="font-size:0.68rem;">' + dec.riskGateStatus + '</span>' +
          '</div>';
      }).join('');
    }

    function pollAgent() {
      fetch('/agent/status')
        .then(function(r) { return r.ok ? r.json() : null; })
        .then(function(data) { if (data) updateAgentPanel(data); })
        .catch(function() {});
    }

    // Initial fetch + interval
    pollAgent();
    setInterval(pollAgent, AGENT_POLL_MS);
  })();

  // Agent panel collapse/expand
  var _agentCollapsed = localStorage.getItem('drift-agent-collapsed') === '1';
  function toggleAgentPanel() {
    _agentCollapsed = !_agentCollapsed;
    localStorage.setItem('drift-agent-collapsed', _agentCollapsed ? '1' : '0');
    applyAgentCollapse();
  }
  function applyAgentCollapse() {
    var body = document.getElementById('agent-panel-body');
    var icon = document.getElementById('agent-collapse-icon');
    if (!body) return;
    if (_agentCollapsed) {
      body.style.maxHeight = '0';
      body.style.overflow = 'hidden';
      if (icon) icon.style.transform = 'rotate(-90deg)';
    } else {
      body.style.maxHeight = '2000px';
      body.style.overflow = 'visible';
      if (icon) icon.style.transform = 'rotate(0)';
    }
  }
  applyAgentCollapse();

  // Agent control buttons
  function agentAction(action) {
    fetch('/agent/' + action, { method: 'POST' })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        console.log('[Agent] ' + action + ':', data);
      })
      .catch(function(err) { console.error('[Agent] action failed:', err); });
  }
  </script>

  <!-- ═══ Pre-Trade Analytics — Live Recalculation (Task 3.7) ═════════════════ -->
  <script>
  (function() {
    'use strict';

    // ── Constants ──────────────────────────────────────────────────────────────
    var DEFAULT_FEE_RATE = 0.0005; // 5 bps
    var DEBOUNCE_MS = 500;

    // ── State ─────────────────────────────────────────────────────────────────
    var ptaState = {
      notional: 0,
      longAccountBalance: null,
      shortAccountBalance: null,
      longFundingRate: null,
      shortFundingRate: null,
      currentPrice: null, // fetched or placeholder
      longExchange: '',
      shortExchange: '',
      longSymbol: '',
      shortSymbol: ''
    };

    // ── Utility: debounce ─────────────────────────────────────────────────────
    var _ptaTimer = null;
    function ptaDebounce(fn, ms) {
      return function() {
        clearTimeout(_ptaTimer);
        _ptaTimer = setTimeout(fn, ms);
      };
    }

    // ── Format helpers ────────────────────────────────────────────────────────
    function fmtUsd(n) {
      if (n == null || isNaN(n)) return '—';
      return '$' + n.toFixed(2);
    }
    function fmtRate(r) {
      if (r == null || isNaN(r)) return '—';
      var pct = (r * 100).toFixed(4);
      return (r >= 0 ? '+' : '') + pct + '%';
    }
    function fmtQty(n) {
      if (n == null || isNaN(n)) return '—';
      return n.toFixed(6);
    }

    // ── Panel visibility control ──────────────────────────────────────────────
    function showPtaSection(section) {
      var loading = document.getElementById('pre-trade-analytics-loading');
      var empty = document.getElementById('pre-trade-analytics-empty');
      var dnSection = document.getElementById('pre-trade-dn-section');
      var stdSection = document.getElementById('pre-trade-standard-section');

      if (loading) loading.style.display = section === 'loading' ? '' : 'none';
      if (empty) empty.style.display = section === 'empty' ? '' : 'none';
      if (dnSection) dnSection.style.display = section === 'dn' ? '' : 'none';
      if (stdSection) stdSection.style.display = section === 'standard' ? '' : 'none';
    }

    // ── Read form inputs ──────────────────────────────────────────────────────
    function readDnFormInputs() {
      // Notional = min order size for DN (use DN-specific field, fallback to standard)
      var isDN = document.getElementById('wz-delta-neutral-config');
      var notionalEl = (isDN && isDN.style.display !== 'none')
        ? document.getElementById('wz-oi-sizeMinUsd')
        : document.getElementById('wz-sizeMinUsd');
      ptaState.notional = parseFloat(notionalEl ? notionalEl.value : '0') || 0;

      // Primary exchange (long by default unless direction is 'short')
      var dirEl = document.getElementById('wz-oi-direction');
      var direction = dirEl ? dirEl.value : 'long';

      // Exchange A = primary exchange from wizard state
      var primaryExchange = '';
      var exTile = document.querySelector('.ex-tile.selected');
      if (exTile) primaryExchange = exTile.dataset.exchange || '';

      // Exchange B = hedge exchange
      var hedgeExchEl = document.getElementById('wz-oi-exchangeB');
      var hedgeExchange = hedgeExchEl ? hedgeExchEl.value : '';

      // Symbol A = primary symbol
      var symSelA = document.getElementById('wz-sym-select');
      var symManual = document.getElementById('wz-sym-manual');
      var primarySymbol = '';
      if (symSelA && symSelA.value) primarySymbol = symSelA.value;
      else if (symManual && symManual.value) primarySymbol = symManual.value;

      // Symbol B = hedge symbol
      var symBEl = document.getElementById('wz-oi-symbolB');
      var hedgeSymbol = symBEl ? symBEl.value : '';

      // Assign long/short based on direction
      if (direction === 'short') {
        ptaState.longExchange = hedgeExchange;
        ptaState.longSymbol = hedgeSymbol || primarySymbol;
        ptaState.shortExchange = primaryExchange;
        ptaState.shortSymbol = primarySymbol;
      } else {
        ptaState.longExchange = primaryExchange;
        ptaState.longSymbol = primarySymbol;
        ptaState.shortExchange = hedgeExchange;
        ptaState.shortSymbol = hedgeSymbol || primarySymbol;
      }

      // Account balances from account selector (if available)
      ptaState.longAccountBalance = getAccountBalance('wz-account-select');
      ptaState.shortAccountBalance = getAccountBalance('wz-oi-hedge-account-select');

      // Swap balances if direction is 'short' (primary is short leg)
      if (direction === 'short') {
        var tmp = ptaState.longAccountBalance;
        ptaState.longAccountBalance = ptaState.shortAccountBalance;
        ptaState.shortAccountBalance = tmp;
      }
    }

    function getAccountBalance(selectId) {
      // Try to read balance from the accounts data cached during wizard load
      var selectEl = document.getElementById(selectId);
      if (!selectEl || !selectEl.value) return null;

      // Look up balance from _wizardAccounts or from sidebar data
      if (typeof _wizardAccounts !== 'undefined' && _wizardAccounts) {
        var acct = _wizardAccounts.find(function(a) { return a.id === selectEl.value; });
        if (acct && acct.balanceUsd != null) return acct.balanceUsd;
      }
      return null;
    }

    // ── Fetch funding rate ────────────────────────────────────────────────────
    function fetchFundingRate(exchange, symbol, callback) {
      if (!exchange || !symbol) { callback(null); return; }
      fetch('/api/exchanges/' + encodeURIComponent(exchange) + '/funding-rate?symbol=' + encodeURIComponent(symbol))
        .then(function(r) { return r.json(); })
        .then(function(data) {
          callback(data.fundingRate != null ? data.fundingRate : null);
        })
        .catch(function() { callback(null); });
    }

    // ── Core recalculation ────────────────────────────────────────────────────
    function recalculatePta() {
      readDnFormInputs();

      // Check if we have enough data to show anything
      if (!ptaState.notional || ptaState.notional <= 0) {
        showPtaSection('empty');
        return;
      }

      // Determine if this is a DN setup (we're in the DN config panel)
      var dnConfig = document.getElementById('wz-delta-neutral-config');
      if (!dnConfig || dnConfig.style.display === 'none') {
        // Standard/Farm bot — use simplified view
        recalculateStandard();
        return;
      }

      showPtaSection('loading');

      var notional = ptaState.notional;
      var feePerLeg = notional * DEFAULT_FEE_RATE * 2; // entry + exit

      // Use a placeholder price (we can't easily fetch real-time price without an extra API)
      // For now, estimate target amount as notional / assumed price
      var estimatedPrice = 100000; // Placeholder — BTC ~$100k default
      var targetAmount = notional / estimatedPrice;

      // Fetch funding rates for both legs in parallel
      var longDone = false, shortDone = false;
      var longRate = null, shortRate = null;

      function tryRender() {
        if (!longDone || !shortDone) return;

        ptaState.longFundingRate = longRate;
        ptaState.shortFundingRate = shortRate;

        // Update DOM
        updateEl('pta-long-margin', ptaState.longAccountBalance != null ? fmtUsd(ptaState.longAccountBalance) : '—');
        updateEl('pta-long-target', fmtQty(targetAmount) + ' ≈ ' + fmtUsd(notional));
        updateEl('pta-long-fees', '-' + fmtUsd(feePerLeg));
        updateEl('pta-long-funding', fmtRate(longRate));

        updateEl('pta-short-margin', ptaState.shortAccountBalance != null ? fmtUsd(ptaState.shortAccountBalance) : '—');
        updateEl('pta-short-target', fmtQty(targetAmount) + ' ≈ ' + fmtUsd(notional));
        updateEl('pta-short-fees', '-' + fmtUsd(feePerLeg));
        updateEl('pta-short-funding', fmtRate(shortRate));

        // Net calculations
        var netFunding = ((longRate || 0) + (shortRate || 0)); // long pays, short receives (or vice versa)
        var netHourlyCost = Math.abs(netFunding) * notional;
        var totalFees = feePerLeg * 2; // both legs

        updateEl('pta-net-funding', fmtRate(netFunding));
        updateEl('pta-net-hourly-cost', '-' + fmtUsd(netHourlyCost));
        updateEl('pta-net-total-fees', '-' + fmtUsd(totalFees));

        // Color coding for funding rates
        colorCode('pta-long-funding', longRate);
        colorCode('pta-short-funding', shortRate);
        colorCode('pta-net-funding', netFunding);

        showPtaSection('dn');
      }

      fetchFundingRate(ptaState.longExchange, ptaState.longSymbol, function(rate) {
        longRate = rate;
        longDone = true;
        tryRender();
      });

      fetchFundingRate(ptaState.shortExchange, ptaState.shortSymbol, function(rate) {
        shortRate = rate;
        shortDone = true;
        tryRender();
      });

      // Timeout: if funding rates don't come back in 5s, render with nulls
      setTimeout(function() {
        if (!longDone) { longDone = true; longRate = null; }
        if (!shortDone) { shortDone = true; shortRate = null; }
        tryRender();
      }, 5000);
    }

    // ── Standard/Farm bot simplified calculation ──────────────────────────────
    function recalculateStandard() {
      var notional = ptaState.notional;
      var stdPanel = document.getElementById('wz-standard-fee-panel');
      var stdEmpty = document.getElementById('std-pta-empty');
      var stdContent = document.getElementById('std-pta-content');

      if (!notional || notional <= 0) {
        // Show the standalone panel with empty state
        if (stdPanel) stdPanel.style.display = '';
        if (stdEmpty) stdEmpty.style.display = '';
        if (stdContent) stdContent.style.display = 'none';
        showPtaSection('empty');
        return;
      }

      var roundTripFee = notional * DEFAULT_FEE_RATE * 2;

      // Update the DN-embedded panel elements (in case DN config is visible later)
      updateEl('pta-std-notional', fmtUsd(notional));
      updateEl('pta-std-fee-rate', (DEFAULT_FEE_RATE * 10000).toFixed(1) + ' bps');
      updateEl('pta-std-round-trip-fee', '-' + fmtUsd(roundTripFee));

      // Update the standalone standard bot fee panel elements
      updateEl('std-pta-notional', fmtUsd(notional));
      updateEl('std-pta-fee-rate', (DEFAULT_FEE_RATE * 10000).toFixed(1) + ' bps');
      updateEl('std-pta-round-trip-fee', '-' + fmtUsd(roundTripFee));

      // Show standalone panel with content
      if (stdPanel) stdPanel.style.display = '';
      if (stdEmpty) stdEmpty.style.display = 'none';
      if (stdContent) stdContent.style.display = '';

      // Fetch funding rate for the selected symbol on the primary exchange
      var primaryExchange = '';
      var exTile = document.querySelector('.ex-tile.selected');
      if (exTile) primaryExchange = exTile.dataset.exchange || '';

      var symSelA = document.getElementById('wz-sym-select');
      var symManual = document.getElementById('wz-sym-manual');
      var symbol = '';
      if (symSelA && symSelA.value) symbol = symSelA.value;
      else if (symManual && symManual.value) symbol = symManual.value;

      fetchFundingRate(primaryExchange, symbol, function(rate) {
        updateEl('pta-std-funding', fmtRate(rate));
        colorCode('pta-std-funding', rate);
        updateEl('std-pta-funding', fmtRate(rate));
        colorCode('std-pta-funding', rate);
      });

      showPtaSection('standard');
    }

    // ── DOM helpers ───────────────────────────────────────────────────────────
    function updateEl(id, text) {
      var el = document.getElementById(id);
      if (el) el.textContent = text;
    }

    function colorCode(id, rate) {
      var el = document.getElementById(id);
      if (!el) return;
      el.classList.remove('positive', 'negative', 'neutral');
      if (rate == null) el.classList.add('neutral');
      else if (rate > 0) el.classList.add('positive');
      else if (rate < 0) el.classList.add('negative');
      else el.classList.add('neutral');
    }

    // ── Wire up event listeners with debounce ─────────────────────────────────
    var debouncedRecalc = ptaDebounce(recalculatePta, DEBOUNCE_MS);

    // Notional / Size inputs
    var sizeInputIds = ['wz-sizeMinUsd', 'wz-sizeMaxUsd'];
    sizeInputIds.forEach(function(id) {
      var el = document.getElementById(id);
      if (el) el.addEventListener('input', debouncedRecalc);
    });

    // Account dropdowns
    var accountSelectIds = ['wz-account-select', 'wz-oi-hedge-account-select'];
    accountSelectIds.forEach(function(id) {
      var el = document.getElementById(id);
      if (el) el.addEventListener('change', debouncedRecalc);
    });

    // Pair/Symbol selectors
    var symbolSelectIds = ['wz-sym-select', 'wz-oi-symbolB'];
    symbolSelectIds.forEach(function(id) {
      var el = document.getElementById(id);
      if (el) el.addEventListener('change', debouncedRecalc);
    });

    // Manual symbol input
    var symManual = document.getElementById('wz-sym-manual');
    if (symManual) symManual.addEventListener('input', debouncedRecalc);

    // Hedge exchange change (affects funding rate source)
    var hedgeExchEl = document.getElementById('wz-oi-exchangeB');
    if (hedgeExchEl) hedgeExchEl.addEventListener('change', debouncedRecalc);

    // Direction change (swaps long/short assignment)
    var dirEl = document.getElementById('wz-oi-direction');
    if (dirEl) dirEl.addEventListener('change', debouncedRecalc);

    // Also trigger recalc when DN config section becomes visible
    // (observed via MutationObserver on the panel display)
    var dnConfigEl = document.getElementById('wz-delta-neutral-config');
    if (dnConfigEl) {
      var observer = new MutationObserver(function(mutations) {
        mutations.forEach(function(m) {
          if (m.attributeName === 'style') {
            var isVisible = dnConfigEl.style.display !== 'none';
            if (isVisible) {
              // Small delay to let inputs populate
              setTimeout(recalculatePta, 100);
            }
          }
        });
      });
      observer.observe(dnConfigEl, { attributes: true, attributeFilter: ['style'] });
    }

    // Trigger recalc when standard fee panel becomes visible (non-DN bots on config step)
    var stdFeePanelEl = document.getElementById('wz-standard-fee-panel');
    if (stdFeePanelEl) {
      var stdObserver = new MutationObserver(function(mutations) {
        mutations.forEach(function(m) {
          if (m.attributeName === 'style') {
            var isVisible = stdFeePanelEl.style.display !== 'none';
            if (isVisible) {
              setTimeout(recalculatePta, 100);
            }
          }
        });
      });
      stdObserver.observe(stdFeePanelEl, { attributes: true, attributeFilter: ['style'] });
    }

    // Initialize: show empty state
    showPtaSection('empty');
  })();
  </script>

  <!-- ═══ Account Registry JS ═══════════════════════════════════════════════ -->
  <script>
  (function() {
    var currentConnectType = 'cex';
    var accountsLoaded = false;

    // ── View Switching: Accounts vs Bots ──────────────────────────────────────
    var filterBtns = document.querySelectorAll('.filter-btn');
    filterBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        var view = this.getAttribute('data-view');
        filterBtns.forEach(function(b) { b.classList.remove('active'); });
        this.classList.add('active');

        var accountsPanel = document.getElementById('accounts-panel');
        var agentPanel = document.getElementById('agent-panel');
        var botGrid = document.getElementById('bot-cards');

        if (view === 'accounts') {
          accountsPanel.style.display = 'block';
          if (agentPanel) agentPanel.style.display = 'none';
          if (botGrid) botGrid.style.display = 'none';
          if (!accountsLoaded) { loadAccounts(); accountsLoaded = true; }
        } else {
          accountsPanel.style.display = 'none';
          if (agentPanel) agentPanel.style.display = '';
          if (botGrid) botGrid.style.display = '';
        }
      });
    });

    // ── Load accounts from API ────────────────────────────────────────────────
    window.loadAccounts = function loadAccounts() {
      fetch('/api/accounts')
        .then(function(r) { return r.json(); })
        .then(function(data) {
          var accounts = data.accounts || [];
          var listEl = document.getElementById('accounts-list');
          var emptyEl = document.getElementById('accounts-empty');

          if (accounts.length === 0) {
            listEl.style.display = 'none';
            emptyEl.style.display = 'flex';
            var footer = document.getElementById('accounts-connect-footer');
            if (footer) footer.style.display = 'none';
            return;
          }

          listEl.style.display = 'block';
          emptyEl.style.display = 'none';
          var footer = document.getElementById('accounts-connect-footer');
          if (footer) footer.style.display = 'block';

          listEl.innerHTML = accounts.map(function(acc) {
            var typeLabel = acc.type === 'cex' ? 'CEX' : acc.type === 'dex-wallet' ? 'DEX' : 'Perp DEX';
            var balanceHtml = '';
            if (acc.balanceUsd != null) {
              var balStr = '$' + Number(acc.balanceUsd).toFixed(2);
              var changeStr = '';
              if (acc.todayChange != null && acc.todayChange !== 0) {
                var sign = acc.todayChange >= 0 ? '+' : '';
                var cls = acc.todayChange >= 0 ? 'color:var(--green)' : 'color:var(--red)';
                changeStr = '<span style="font-size:0.7rem;font-weight:600;margin-left:0.4rem;' + cls + '">' + sign + '$' + Math.abs(acc.todayChange).toFixed(2) + '</span>';
              } else if (acc.sodBalance != null) {
                changeStr = '<span style="font-size:0.7rem;color:var(--text-tertiary);margin-left:0.4rem">$0.00</span>';
              }
              balanceHtml = '<div style="display:flex;align-items:baseline;gap:0.2rem;margin-right:0.75rem">' +
                '<span style="font-size:0.85rem;font-weight:700;color:var(--green)">' + balStr + '</span>' +
                changeStr +
              '</div>';
            }
            return '<div class="account-row">' +
              '<div class="account-row-left">' +
                '<span class="account-exchange-badge">' + acc.exchange + '</span>' +
                '<span class="account-type-badge">' + typeLabel + '</span>' +
                '<span class="account-row-label">' + escHtml(acc.label) + '</span>' +
                '<span class="account-row-key">' + acc.truncatedKey + '</span>' +
              '</div>' +
              '<div style="display:flex;align-items:center">' +
                balanceHtml +
                '<button class="account-delete-btn" onclick="refreshAccountBalance(\'' + acc.id + '\', this)" title="Refresh balance" style="margin-right:0.3rem">' +
                  '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 4v6h6"/><path d="M23 20v-6h-6"/><path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15"/></svg>' +
                '</button>' +
                '<button class="account-delete-btn" onclick="deleteAccount(\'' + acc.id + '\')" title="Delete account">' +
                  '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>' +
                '</button>' +
              '</div>' +
            '</div>';
          }).join('');
        })
        .catch(function(err) {
          console.error('[Accounts] Failed to load:', err);
        });
    };

    function escHtml(s) {
      var d = document.createElement('div');
      d.textContent = s || '';
      return d.innerHTML;
    }

    // ── Connect Modal ─────────────────────────────────────────────────────────
    // Uses the canonical connect-account-modal (created in accounts-sidebar flow)
    window.openConnectModal = function(type) {
      currentConnectType = type;
      var modal = document.getElementById('connect-account-modal');
      if (modal) {
        // Set the account type via hidden input and sync visual buttons
        var typeInput = document.getElementById('account-type-selector');
        if (typeInput && type) typeInput.value = type;
        // Sync visual type buttons
        var typeGroup = document.getElementById('cam-type-group');
        if (typeGroup) {
          typeGroup.querySelectorAll('.cam-type-btn').forEach(function(btn) {
            btn.classList.toggle('selected', btn.dataset.type === type);
          });
        }
        // Reset form fields
        var labelEl = document.getElementById('cam-label');
        if (labelEl) labelEl.value = '';
        var exchEl = document.getElementById('cam-exchange');
        if (exchEl) exchEl.value = '';
        var credSection = document.getElementById('cam-cred-section');
        if (credSection) credSection.style.display = 'none';
        // Show modal
        modal.style.display = 'flex';
        modal.classList.add('active');
      }
      // Also open legacy overlay if present (backward compat)
      var legacy = document.getElementById('connect-modal-overlay');
      if (legacy) legacy.classList.add('open');
    };

    window.closeConnectModal = function() {
      var modal = document.getElementById('connect-account-modal');
      if (modal) {
        modal.style.display = 'none';
        modal.classList.remove('active');
      }
      var legacy = document.getElementById('connect-modal-overlay');
      if (legacy) legacy.classList.remove('open');
    };

    // Close on overlay click (legacy modal)
    var legacyOverlay = document.getElementById('connect-modal-overlay');
    if (legacyOverlay) {
      legacyOverlay.addEventListener('click', function(e) {
        if (e.target === this) closeConnectModal();
      });
    }

    // ── Dynamic credential fields based on exchange ───────────────────────────
    var exchangeFields = {
      sodex: [
        { key: 'apiKey', label: 'API Key', placeholder: 'Your SoDEX API key' },
        { key: 'apiSecret', label: 'API Secret', placeholder: 'EVM private key (0x...)' },
        { key: 'subaccount', label: 'Subaccount Address', placeholder: 'EVM subaccount address' }
      ],
      dango: [
        { key: 'dangoPrivateKey', label: 'Private Key', placeholder: 'Secp256k1 private key (no 0x)' },
        { key: 'userAddress', label: 'User Address', placeholder: '0x...' },
        { key: 'network', label: 'Network', placeholder: 'mainnet or testnet', defaultVal: 'mainnet' }
      ],
      decibel: [
        { key: 'privateKey', label: 'Private Key', placeholder: 'Ed25519 private key' },
        { key: 'nodeApiKey', label: 'Node API Key (optional)', placeholder: '' },
        { key: 'builderAddress', label: 'Builder Address (optional)', placeholder: '' }
      ],
      hibachi: [
        { key: 'hibachiApiKey', label: 'API Key', placeholder: 'Hibachi API key' },
        { key: 'hibachiAccountId', label: 'Account ID', placeholder: 'Numeric account ID' },
        { key: 'hibachiAccountType', label: 'Account Type', placeholder: 'trustless or exchange_managed', defaultVal: 'trustless' },
        { key: 'hibachiPrivateKey', label: 'Private Key (trustless)', placeholder: 'ECDSA private key (0x...)' }
      ],
      ondoperps: [
        { key: 'apiKeyId', label: 'API Key ID', placeholder: 'OndoPerps API key ID' },
        { key: 'apiKeySecret', label: 'API Key Secret', placeholder: 'API key secret' }
      ],
      perpl: [
        { key: 'perplApiKey', label: 'API Key', placeholder: 'Perpl API key' },
        { key: 'perplApiKeySecret', label: 'API Key Secret', placeholder: 'Ed25519 private key hex' }
      ]
    };

    window.updateCredFields = function() {
      var exchange = document.getElementById('connect-exchange').value;
      var container = document.getElementById('connect-cred-fields');
      var fields = exchangeFields[exchange] || [];

      container.innerHTML = fields.map(function(f) {
        return '<div class="connect-field">' +
          '<label>' + f.label + '</label>' +
          '<input type="password" id="cred-' + f.key + '" placeholder="' + (f.placeholder || '') + '" value="' + (f.defaultVal || '') + '" />' +
        '</div>';
      }).join('');
    };

    // ── Save account ──────────────────────────────────────────────────────────
    window.saveConnectAccount = function() {
      var label = document.getElementById('connect-label').value.trim();
      var exchange = document.getElementById('connect-exchange').value;

      if (!label) { showConnectToast('Please enter an account label', 'err'); return; }
      if (!exchange) { showConnectToast('Please select an exchange', 'err'); return; }

      var fields = exchangeFields[exchange] || [];
      var credentials = { exchange: exchange };
      for (var i = 0; i < fields.length; i++) {
        var val = (document.getElementById('cred-' + fields[i].key) || {}).value || '';
        if (val) credentials[fields[i].key] = val;
      }

      var btn = document.getElementById('btn-connect-save');
      btn.disabled = true;
      btn.textContent = 'Connecting...';

      fetch('/api/accounts', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ label: label, type: currentConnectType, credentials: credentials })
      })
        .then(function(r) { return r.json().then(function(d) { return { ok: r.ok, data: d }; }); })
        .then(function(res) {
          btn.disabled = false;
          btn.textContent = 'Connect Account';
          if (!res.ok) { showConnectToast(res.data.error || 'Failed', 'err'); return; }
          showConnectToast('Account connected!', 'ok');
          setTimeout(function() { closeConnectModal(); loadAccounts(); }, 800);
        })
        .catch(function(err) {
          btn.disabled = false;
          btn.textContent = 'Connect Account';
          showConnectToast('Network error: ' + err.message, 'err');
        });
    };

    // ── Delete account ────────────────────────────────────────────────────────
    window.deleteAccount = function(id) {
      if (!confirm('Disconnect this account? Bots using it will need credentials re-entered.')) return;

      fetch('/api/accounts/' + id, { method: 'DELETE' })
        .then(function(r) { return r.json(); })
        .then(function(data) {
          if (data.ok) loadAccounts();
          else alert('Failed to disconnect: ' + (data.error || 'Unknown error'));
        })
        .catch(function(err) { alert('Network error: ' + err.message); });
    };

    window.refreshAccountBalance = function(id, btn) {
      if (btn) { btn.disabled = true; btn.style.opacity = '0.5'; }

      fetch('/api/accounts/' + id + '/refresh-balance', { method: 'POST' })
        .then(function(r) { return r.json(); })
        .then(function(data) {
          if (data.ok) {
            showConnectToast('Balance updated: $' + Number(data.balanceUsd).toFixed(2), 'ok');
            loadAccounts(); // reload list to show updated balance
          } else {
            showConnectToast('Failed: ' + (data.error || 'Unknown'), 'err');
          }
        })
        .catch(function(err) { showConnectToast('Network error: ' + err.message, 'err'); })
        .finally(function() { if (btn) { btn.disabled = false; btn.style.opacity = '1'; } });
    };

    function showConnectToast(msg, type) {
      var el = document.getElementById('connect-toast');
      el.textContent = msg;
      el.style.color = type === 'ok' ? 'var(--green)' : 'var(--red)';
      el.style.opacity = '1';
      setTimeout(function() { el.style.opacity = '0'; }, 3000);
    }
  })();
  </script>
</body>
</html>
