  <script>
  (function() {
    // ── Account Type Selection ──────────────────────────────────────────────────
    window.camSelectType = function(btn) {
      document.querySelectorAll('#cam-type-group .cam-type-btn').forEach(function(b) {
        b.classList.remove('selected');
      });
      btn.classList.add('selected');
      document.getElementById('account-type-selector').value = btn.dataset.type;
      camUpdateCredentials();
    };

    // ── Credential field templates per exchange + type ─────────────────────────
    var credTemplates = {
      cex: {
        sodex: [
          { key: 'apiKey', label: 'API Key', type: 'text', placeholder: 'Your SoDEX API key' },
          { key: 'apiSecret', label: 'API Secret (Private Key)', type: 'password', placeholder: '0x... (EVM private key)' },
          { key: 'subaccount', label: 'Subaccount Address', type: 'text', placeholder: '0x...' }
        ],
        hibachi: [
          { key: 'hibachiApiKey', label: 'API Key', type: 'text', placeholder: 'Hibachi API key' },
          { key: 'hibachiAccountId', label: 'Account ID', type: 'text', placeholder: 'Numeric ID' },
          { key: 'hibachiPrivateKey', label: 'Private Key / Secret', type: 'password', placeholder: '0x... (ECDSA) or HMAC secret' }
        ]
      },
      'dex-wallet': {
        sodex: [
          { key: 'apiSecret', label: 'Private Key (EVM)', type: 'password', placeholder: '0x... (66-char hex)' },
          { key: 'subaccount', label: 'Wallet Address', type: 'text', placeholder: '0x...' }
        ],
        decibel: [
          { key: 'privateKey', label: 'Private Key (Ed25519)', type: 'password', placeholder: 'Ed25519 private key' },
          { key: 'subaccount', label: 'Wallet Address (optional)', type: 'text', placeholder: '0x...' }
        ],
        dango: [
          { key: 'dangoPrivateKey', label: 'Private Key (Secp256k1)', type: 'password', placeholder: '64-char hex, no 0x prefix' },
          { key: 'userAddress', label: 'Wallet Address', type: 'text', placeholder: '0x...' }
        ],
        hibachi: [
          { key: 'hibachiPrivateKey', label: 'Private Key (ECDSA)', type: 'password', placeholder: '0x... (66-char hex)' }
        ]
      },
      'perp-dex': {
        ondoperps: [
          { key: 'apiKeyId', label: 'API Key ID', type: 'text', placeholder: 'OndoPerps API key ID' },
          { key: 'apiKeySecret', label: 'API Key Secret', type: 'password', placeholder: 'API key secret' }
        ],
        perpl: [
          { key: 'perplApiKey', label: 'API Key', type: 'text', placeholder: 'Perpl API token' },
          { key: 'perplApiKeySecret', label: 'Private Key (Ed25519)', type: 'password', placeholder: '0x... or hex without prefix' }
        ],
        sodex: [
          { key: 'apiKey', label: 'API Key', type: 'text', placeholder: 'SoDEX API key' },
          { key: 'apiSecret', label: 'Private Key', type: 'password', placeholder: '0x... (EVM private key)' },
          { key: 'subaccount', label: 'Subaccount Address', type: 'text', placeholder: '0x...' }
        ],
        decibel: [
          { key: 'privateKey', label: 'Private Key (Ed25519)', type: 'password', placeholder: 'Ed25519 private key' },
          { key: 'nodeApiKey', label: 'Node API Key (optional)', type: 'text', placeholder: 'aptoslabs_...' }
        ],
        dango: [
          { key: 'dangoPrivateKey', label: 'Private Key (Secp256k1)', type: 'password', placeholder: '64-char hex' },
          { key: 'userAddress', label: 'User Address', type: 'text', placeholder: '0x...' }
        ],
        hibachi: [
          { key: 'hibachiApiKey', label: 'API Key', type: 'text', placeholder: 'Hibachi API key' },
          { key: 'hibachiAccountId', label: 'Account ID', type: 'text', placeholder: 'Numeric' },
          { key: 'hibachiPrivateKey', label: 'Private Key', type: 'password', placeholder: '0x...' }
        ]
      }
    };

    // ── Update credential fields dynamically ──────────────────────────────────
    window.camUpdateCredentials = function() {
      var type = document.getElementById('account-type-selector').value;
      var exchange = document.getElementById('cam-exchange').value;
      var section = document.getElementById('cam-cred-section');
      var title = document.getElementById('cam-cred-title');
      var container = document.getElementById('cam-cred-fields');

      if (!exchange) {
        section.style.display = 'none';
        return;
      }

      var fields = (credTemplates[type] && credTemplates[type][exchange]) || credTemplates['perp-dex'][exchange] || [];

      if (fields.length === 0) {
        section.style.display = 'none';
        return;
      }

      section.style.display = 'flex';
      var exchangeNames = { sodex: 'SoDEX', decibel: 'Decibel', dango: 'Dango', hibachi: 'Hibachi', ondoperps: 'OndoPerps', perpl: 'Perpl' };
      title.textContent = (exchangeNames[exchange] || exchange) + ' Credentials';

      container.innerHTML = fields.map(function(f) {
        return '<div class="cam-field">' +
          '<label>' + f.label + '</label>' +
          '<input type="' + f.type + '" id="cam-cred-' + f.key + '" placeholder="' + f.placeholder + '" autocomplete="off" />' +
        '</div>';
      }).join('');
    };

    // ── Submit new account ────────────────────────────────────────────────────
    window.camSubmitAccount = function() {
      var type = document.getElementById('account-type-selector').value;
      var exchange = document.getElementById('cam-exchange').value;
      var label = document.getElementById('cam-label').value.trim();

      if (!label) { camShowToast('Please enter an account label', 'err'); return; }
      if (!exchange) { camShowToast('Please select an exchange', 'err'); return; }

      // Collect credentials
      var fields = (credTemplates[type] && credTemplates[type][exchange]) || credTemplates['perp-dex'][exchange] || [];
      var credentials = { exchange: exchange };
      for (var i = 0; i < fields.length; i++) {
        var el = document.getElementById('cam-cred-' + fields[i].key);
        var val = el ? el.value.trim() : '';
        if (val) credentials[fields[i].key] = val;
      }

      // Validate at least one credential is filled
      var hasAnyCred = Object.keys(credentials).some(function(k) { return k !== 'exchange' && credentials[k]; });
      if (!hasAnyCred) { camShowToast('Please fill in at least one credential field', 'err'); return; }

      var btn = document.getElementById('cam-submit-btn');
      btn.disabled = true;
      btn.textContent = 'Connecting...';

      fetch('/api/accounts', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ label: label, type: type, credentials: credentials })
      })
        .then(function(r) { return r.json().then(function(d) { return { ok: r.ok, data: d }; }); })
        .then(function(res) {
          btn.disabled = false;
          btn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg> Connect Account';
          if (!res.ok) { camShowToast(res.data.error || 'Failed to connect', 'err'); return; }
          camShowToast('Account connected!', 'ok');
          // Reset form fields
          var labelReset = document.getElementById('cam-label');
          if (labelReset) labelReset.value = '';
          var exchReset = document.getElementById('cam-exchange');
          if (exchReset) exchReset.value = '';
          var credSectionReset = document.getElementById('cam-cred-section');
          if (credSectionReset) credSectionReset.style.display = 'none';
          var credFieldsReset = document.getElementById('cam-cred-fields');
          if (credFieldsReset) credFieldsReset.innerHTML = '';
          setTimeout(function() {
            closeConnectModal();
            // Refresh sidebar and accounts panel
            if (typeof refreshAccounts === 'function') refreshAccounts();
            if (typeof loadAccounts === 'function') loadAccounts();
          }, 800);
        })
        .catch(function(err) {
          btn.disabled = false;
          btn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg> Connect Account';
          camShowToast('Network error: ' + err.message, 'err');
        });
    };

    function camShowToast(msg, type) {
      var el = document.getElementById('cam-toast');
      el.textContent = msg;
      el.style.color = type === 'ok' ? 'var(--green)' : 'var(--red)';
      el.style.opacity = '1';
      setTimeout(function() { el.style.opacity = '0'; }, 3500);
    }

    // ── Close on overlay click ────────────────────────────────────────────────
    var camOverlay = document.getElementById('connect-account-modal');
    if (camOverlay) {
      camOverlay.addEventListener('click', function(e) {
        if (e.target === camOverlay) closeConnectModal();
      });
    }
  })();
  </script>

