                  <input class="wz-input" type="password" id="wz-oi-ondoApiKeySecret" placeholder="ondoApiSecret_..." autocomplete="new-password" />
                </div>
              </div>
            </div>
            <div id="wz-oi-creds-sodex" style="display:none">
              <div class="wz-form-row">
                <div class="wz-form-group">
                  <label class="wz-label">API Key <span class="req">*</span></label>
                  <input class="wz-input" type="text" id="wz-oi-sodexApiKey" placeholder="your_api_key" autocomplete="off" />
                </div>
                <div class="wz-form-group">
                  <label class="wz-label">Subaccount <span class="req">*</span></label>
                  <input class="wz-input" type="text" id="wz-oi-sodexSubaccount" placeholder="0x..." autocomplete="off" />
                </div>
              </div>
              <div class="wz-form-row full">
                <div class="wz-form-group">
                  <label class="wz-label">Private Key <span class="req">*</span></label>
                  <input class="wz-input" type="password" id="wz-oi-sodexSecret" placeholder="0x..." autocomplete="new-password" />
                </div>
              </div>
            </div>
            <div id="wz-oi-creds-hibachi" style="display:none">
              <div class="wz-form-row">
                <div class="wz-form-group">
                  <label class="wz-label">API Key <span class="req">*</span></label>
                  <input class="wz-input" type="text" id="wz-oi-hibachiApiKey" placeholder="API key" autocomplete="off" />
                </div>
                <div class="wz-form-group">
                  <label class="wz-label">Account ID <span class="req">*</span></label>
                  <input class="wz-input" type="text" id="wz-oi-hibachiAccountId" placeholder="12345" autocomplete="off" />
                </div>
              </div>
              <div class="wz-form-row full">
                <div class="wz-form-group">
                  <label class="wz-label">Private Key (ECDSA) <span class="req">*</span></label>
                  <input class="wz-input" type="password" id="wz-oi-hibachiPrivateKey" placeholder="0x..." autocomplete="new-password" />
                </div>
              </div>
            </div>
            <div id="wz-oi-creds-decibel" style="display:none">
              <div class="wz-form-row full">
                <div class="wz-form-group">
                  <label class="wz-label">Private Key <span class="req">*</span></label>
                  <input class="wz-input" type="password" id="wz-oi-decibelKey" placeholder="ed25519-priv-0x..." autocomplete="new-password" />
                </div>
              </div>
            </div>
            <div id="wz-oi-creds-perpl" style="display:none">
              <div class="wz-form-row">
                <div class="wz-form-group">
                  <label class="wz-label">API Key <span class="req">*</span></label>
                  <input class="wz-input" type="text" id="wz-oi-perplApiKey" placeholder="API key" autocomplete="off" />
                </div>
                <div class="wz-form-group">
                  <label class="wz-label">Private Key (Ed25519) <span class="req">*</span></label>
                  <input class="wz-input" type="password" id="wz-oi-perplSecret" placeholder="0x..." autocomplete="new-password" />
                </div>
              </div>
            </div>

            <div class="wz-form-row" style="margin-top:1rem">
              <div class="wz-form-group">
                <label class="wz-label">Hedge Symbol <span class="req">*</span></label>
                <select class="wz-select" id="wz-oi-symbolB">
                  <option value="">-- Select hedge exchange first --</option>
                </select>
                <span class="wz-hint" id="wz-oi-symbolB-hint">Symbol on the hedge exchange (loaded dynamically)</span>
              </div>
            </div>
            </div><!-- /wz-dn-cross-exchange-fields -->
            <div class="wz-form-row">
              <div class="wz-form-group">
                <label class="wz-label">Max Loss USD</label>
                <input class="wz-input" type="number" id="wz-oi-maxLossUsd" placeholder="15" min="1" step="0.5" value="15" />
              </div>
              <div class="wz-form-group">
                <label class="wz-label">Take Profit USD</label>
                <input class="wz-input" type="number" id="wz-oi-takeProfitUsd" placeholder="5" min="0" step="0.5" value="0" />
                <span class="wz-hint">Close when combined PnL ≥ this (0 = disabled)</span>
              </div>
            </div>
            <div class="wz-form-row">
              <div class="wz-form-group">
                <label class="wz-label">Max Delta Divergence USD</label>
                <input class="wz-input" type="number" id="wz-oi-maxDelta" placeholder="30" min="5" value="30" />
                <span class="wz-hint">Rebalance trigger when legs diverge beyond this</span>
              </div>
            </div>
            <div class="wz-form-row">
              <div class="wz-form-group">
                <label class="wz-label">Min Hold (hours)</label>
                <input class="wz-input" type="number" id="wz-oi-minHoldHrs" placeholder="4" min="1" value="4" />
                <span class="wz-hint">Minimum 4h for Perpl OI multiplier</span>
              </div>
              <div class="wz-form-group">
                <label class="wz-label">Max Hold (hours)</label>
                <input class="wz-input" type="number" id="wz-oi-maxHoldHrs" placeholder="48" min="4" value="48" />
                <span class="wz-hint">48h+ for highest multiplier tier</span>
              </div>
            </div>
            <div class="wz-section-title" style="margin-top:1rem">Position Sizing (USD)</div>
            <div class="wz-form-row">
              <div class="wz-form-group">
                <label class="wz-label">Min Order Size (USD)</label>
                <input class="wz-input" type="number" id="wz-oi-sizeMinUsd" placeholder="100" min="10" step="10" value="100" />
                <span class="wz-hint">Minimum per-leg position value (random within range)</span>
              </div>
              <div class="wz-form-group">
                <label class="wz-label">Max Order Size (USD)</label>
                <input class="wz-input" type="number" id="wz-oi-sizeMaxUsd" placeholder="200" min="10" step="10" value="200" />
                <span class="wz-hint">Maximum per-leg position value (anti-bot tracking)</span>
              </div>
            </div>
            <div class="wz-form-row">
              <div class="wz-form-group">
                <label class="wz-label">Entry Mode</label>
                <select class="wz-select" id="wz-oi-entryMode">
                  <option value="taker">Taker (fast, higher fees)</option>
                  <option value="maker-chunked">Maker Chunked (slow, ~70% less fees)</option>
                </select>
                <span class="wz-hint">Maker splits entry into small PostOnly orders</span>
              </div>
              <div class="wz-form-group">
                <label class="wz-label">Chunk Size (USD)</label>
                <input class="wz-input" type="number" id="wz-oi-chunkSize" placeholder="100" min="10" value="100" />
                <span class="wz-hint">USD per maker order chunk</span>
              </div>
            </div>
            </div><!-- /wz-dn-classic-view -->
            </div><!-- /wz-dn-config-left -->
            <div class="wz-dn-analytics-right">
              <%- include('partials/pre-trade-analytics') %>
            </div>
            </div><!-- /wz-dn-layout -->
          </div>
          <div class="wz-check-row" style="margin-top:.75rem">
            <input type="checkbox" id="wz-autoStart" checked />
            <label for="wz-autoStart">Auto-start bot after creation</label>
          </div>
        </div>

        <!-- ── Step 4: Review ── -->
        <div class="wz-panel" id="wz-panel-4">
          <div class="wz-section-title">Review & Launch</div>
          <div class="review-grid" id="wz-review-grid"></div>
          <div class="review-creds">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            Credentials encrypted with AES-256-GCM — never stored in plaintext
          </div>
        </div>
      </div>

      <!-- Footer -->
      <div class="wz-footer">
        <div class="wz-footer-left">
          <button class="wz-btn wz-btn-ghost" id="wz-back" style="display:none">← Back</button>
        </div>
        <div class="wz-footer-right">
          <span class="wz-step-counter" id="wz-step-counter">Step 1 of 5</span>
          <button class="wz-btn wz-btn-primary" id="wz-next">Next →</button>
        </div>
      </div>
    </div>
  </div>

  <!-- ── Wizard JS ─────────────────────────────────────────────────────────── -->
  <script>
  (function () {
    'use strict';

    // ── State ─────────────────────────────────────────────────────────────────
    var state = {
      step: 0,
      exchange: 'sodex',
      botType: 'standard',
      symbol: '',
      symbolB: '',
      symbols: [],
    };

    var TOTAL_STEPS = 5;

    // ── DOM refs ──────────────────────────────────────────────────────────────
    var overlay   = document.getElementById('wz-overlay');
    var errBanner = document.getElementById('wz-error');
    var nextBtn   = document.getElementById('wz-next');
    var backBtn   = document.getElementById('wz-back');
    var counter   = document.getElementById('wz-step-counter');

    // ── Open / Close ──────────────────────────────────────────────────────────
    document.getElementById('btn-create-bot').addEventListener('click', openWizard);
    document.getElementById('wz-close').addEventListener('click', closeWizard);
    overlay.addEventListener('click', function (e) { if (e.target === overlay) closeWizard(); });

    function openWizard() {
      resetState();
      document.body.classList.add('modal-open');
      overlay.classList.add('open');
      goToStep(0);
    }

    function closeWizard() {
      overlay.classList.remove('open');
      document.body.classList.remove('modal-open');
    }

    function resetState() {
      state.step = 0;
      state.exchange = 'sodex';
      state.botType = 'standard';
      state.symbol = '';
      state.symbolB = '';
      state.symbols = [];
      _wizardAccountSelected = '';
      clearErrors();
      // Reset exchange tiles
      document.querySelectorAll('.ex-tile').forEach(function (t) {
        t.classList.toggle('selected', t.dataset.exchange === 'sodex');
      });
      // Reset type tiles
      document.querySelectorAll('.type-tile').forEach(function (t) {
        t.classList.toggle('selected', t.dataset.type === 'standard');
      });
      // Reset form inputs
      ['wz-tags','wz-apiKey','wz-subaccount','wz-apiSecret',
       'wz-nodeApiKey','wz-decibelSubaccount','wz-privateKey',
       'wz-userAddress','wz-dangoPrivateKey',
       'wz-hibachiApiKey','wz-hibachiAccountId','wz-hibachiPrivateKey','wz-hibachiSecretKey'].forEach(function (id) {
        var el = document.getElementById(id);
        if (el) el.value = '';
      });
      document.getElementById('wz-mode').value = 'farm';
      document.getElementById('wz-intelligence-mode').value = 'auto';
      document.getElementById('wz-manual-mode-section').style.display = 'none';
      document.getElementById('wz-network').value = 'mainnet';
      document.getElementById('wz-hibachiAccountType').value = 'trustless';
      document.getElementById('wz-hibachi-trustless-row').style.display = '';
      document.getElementById('wz-hibachi-managed-row').style.display = 'none';
      document.getElementById('wz-autoStart').checked = false;
      document.getElementById('wz-legValueUsd').value = '1000';
      document.getElementById('wz-holdingPeriodSecs').value = '300';
      document.getElementById('wz-profitTargetUsd').value = '50';
      document.getElementById('wz-maxLossUsd').value = '30';
      // Reset account selector state
      var credsContainer = document.getElementById('wz-manual-creds-container');
      if (credsContainer) credsContainer.style.display = '';
      var accountInfoEl = document.getElementById('wz-account-selected-info');
      if (accountInfoEl) accountInfoEl.style.display = 'none';
      var toggleBtn = document.getElementById('wz-manual-creds-toggle');
      if (toggleBtn) toggleBtn.textContent = 'Or enter credentials manually \u2193';
    }

    // ── Step navigation ───────────────────────────────────────────────────────
    nextBtn.addEventListener('click', function () {
      // Use step index instead of button text to avoid emoji matching issues
      if (state.step === TOTAL_STEPS - 1) {
        submitBot();
      } else {
        if (validateStep(state.step)) goToStep(state.step + 1);
      }
    });

    backBtn.addEventListener('click', function () {
      goToStep(state.step - 1);
    });

    function goToStep(n) {
      clearErrors();
      // Hide all panels
      document.querySelectorAll('.wz-panel').forEach(function (p) { p.classList.remove('active'); });
      document.getElementById('wz-panel-' + n).classList.add('active');

      // Update step indicators
      document.querySelectorAll('.wz-step').forEach(function (s) {
        var i = parseInt(s.dataset.step, 10);
        s.classList.remove('active', 'done');
        if (i < n) s.classList.add('done');
        else if (i === n) s.classList.add('active');
      });

      state.step = n;
      counter.textContent = 'Step ' + (n + 1) + ' of ' + TOTAL_STEPS;
      backBtn.style.display = n > 0 ? '' : 'none';

      // Always set button text based on current step — never leave stale "Launch Bot" on non-final steps
      nextBtn.disabled = false;
      nextBtn.textContent = n === TOTAL_STEPS - 1 ? '\uD83D\uDE80 Launch Bot' : 'Next \u2192';

      // Side effects per step
      if (n === 1) showCredsPanel();
      if (n === 2) loadSymbols();
      if (n === 3) showHedgeConfig();
      if (n === 4) buildReview();
    }

    // ── Step 0: Exchange + Type tiles ─────────────────────────────────────────
    document.querySelectorAll('.ex-tile').forEach(function (tile) {
      tile.addEventListener('click', function () {
        state.exchange = tile.dataset.exchange;
        state.symbol = '';
        state.symbolB = '';
        document.querySelectorAll('.ex-tile').forEach(function (t) { t.classList.remove('selected'); });
        tile.classList.add('selected');
      });
    });

    document.querySelectorAll('.type-tile').forEach(function (tile) {
      tile.addEventListener('click', function () {
        state.botType = tile.dataset.type;
        document.querySelectorAll('.type-tile').forEach(function (t) { t.classList.remove('selected'); });
        tile.classList.add('selected');
      });
    });

    // ── Hibachi account type toggle ───────────────────────────────────────────
    document.getElementById('wz-hibachiAccountType').addEventListener('change', function () {
      var isTrustless = this.value === 'trustless';
      document.getElementById('wz-hibachi-trustless-row').style.display = isTrustless ? '' : 'none';
      document.getElementById('wz-hibachi-managed-row').style.display   = isTrustless ? 'none' : '';
    });

    // ── Step 1: Credentials panel ─────────────────────────────────────────────
    var _wizardAccounts = null;
    var _wizardAccountSelected = '';

    function showCredsPanel() {
      ['sodex','decibel','dango','hibachi','ondoperps','perpl'].forEach(function (ex) {
        var el = document.getElementById('wz-creds-' + ex);
        if (el) el.style.display = ex === state.exchange ? '' : 'none';
      });
      // Load accounts for account selector
      loadWizardAccounts();
    }

    function loadWizardAccounts() {
      var selector = document.getElementById('wz-account-selector');
      var selectEl = document.getElementById('wz-account-select');
      var credsContainer = document.getElementById('wz-manual-creds-container');
      if (!selector || !selectEl) return;

      fetch('/api/accounts')
        .then(function(r) { return r.json(); })
        .then(function(data) {
          _wizardAccounts = (data.accounts || []).filter(function(a) { return a.exchange === state.exchange; });
          if (_wizardAccounts.length === 0) {
            selector.style.display = 'none';
            if (credsContainer) credsContainer.style.display = '';
            return;
          }
          selector.style.display = 'block';
          selectEl.innerHTML = '<option value="">— Select a saved account —</option>' +
            _wizardAccounts.map(function(a) {
              return '<option value="' + a.id + '">' + a.label + ' (' + a.exchange.toUpperCase() + ' · ' + a.truncatedKey + ')</option>';
            }).join('');
          _wizardAccountSelected = '';
          // Show manual creds by default, hide when account selected
          if (credsContainer) credsContainer.style.display = '';
          updateAccountSelectedInfo();
        })
        .catch(function() {
          selector.style.display = 'none';
          if (credsContainer) credsContainer.style.display = '';
        });
    }

    // Handle account selection change
    document.getElementById('wz-account-select').addEventListener('change', function() {
      _wizardAccountSelected = this.value;
      var credsContainer = document.getElementById('wz-manual-creds-container');
      if (_wizardAccountSelected) {
        // Account selected: hide manual credential fields
        if (credsContainer) credsContainer.style.display = 'none';
        // Update the toggle button text
        var toggleBtn = document.getElementById('wz-manual-creds-toggle');
        if (toggleBtn) {
          toggleBtn.textContent = 'Or enter credentials manually \u2193';
        }
      } else {
        // No account selected (manual mode): show credential fields
        if (credsContainer) credsContainer.style.display = '';
      }
      updateAccountSelectedInfo();
    });

    function updateAccountSelectedInfo() {
      var infoEl = document.getElementById('wz-account-selected-info');
      var labelEl = document.getElementById('wz-account-selected-label');
      if (!infoEl) return;

      if (_wizardAccountSelected && _wizardAccounts) {
        var acct = _wizardAccounts.find(function(a) { return a.id === _wizardAccountSelected; });
        if (acct) {
          infoEl.style.display = 'flex';
          labelEl.textContent = '\u2713 Using: ' + acct.label + ' (' + acct.exchange.toUpperCase() + ')';
        } else {
          infoEl.style.display = 'none';
        }
      } else {
        infoEl.style.display = 'none';
      }
    }

    // Toggle manual credential entry when user clicks "Or enter manually"
    window.toggleManualCredEntry = function() {
      var credsContainer = document.getElementById('wz-manual-creds-container');
      var toggleBtn = document.getElementById('wz-manual-creds-toggle');
      if (!credsContainer) return;

      var isHidden = credsContainer.style.display === 'none';
      credsContainer.style.display = isHidden ? '' : 'none';
      if (toggleBtn) {
        toggleBtn.textContent = isHidden ? 'Hide manual credentials \u2191' : 'Or enter credentials manually \u2193';
      }
      // If showing manual entry, deselect the saved account
      if (isHidden) {
        var selectEl = document.getElementById('wz-account-select');
        if (selectEl) selectEl.value = '';
        _wizardAccountSelected = '';
        updateAccountSelectedInfo();
      }
    };

    function showWizardCredFields(show) {
      // Legacy function — kept for backward compatibility
      var credsEl = document.getElementById('wz-creds-' + state.exchange);
      if (credsEl) {
        credsEl.style.opacity = show ? '1' : '0.35';
        credsEl.style.pointerEvents = show ? '' : 'none';
      }
    }

    // ── Step 2: Symbol loading ────────────────────────────────────────────────
    var BTC_DEFAULTS = { sodex: 'BTC-USD', decibel: 'BTC/USD', dango: 'BTC-USD', hibachi: 'BTC/USDT-P', ondoperps: 'XAU-PERP', perpl: 'BTC-PERP' };
    var marketMetadata = {}; // Stores per-symbol metadata (maxLeverage, minNotional, etc.)

    function loadSymbols() {
      var title = document.getElementById('wz-market-title');
      title.textContent = (state.botType === 'pair' || state.botType === 'hedge') ? 'Symbol A (Long leg)' : 'Select Symbol';

      var bSection = document.getElementById('wz-sym-b-section');
      bSection.style.display = (state.botType === 'pair' || state.botType === 'hedge') ? '' : 'none';

      var loading  = document.getElementById('wz-sym-loading');
      var ready   = document.getElementById('wz-sym-ready');
      var fallback = document.getElementById('wz-sym-fallback');
      var selA    = document.getElementById('wz-sym-select');
      var selB    = document.getElementById('wz-sym-select-b');
      var meta    = document.getElementById('wz-sym-meta');

      // Reset state
      loading.style.display  = '';
      ready.style.display    = 'none';
      fallback.style.display = 'none';
      selA.innerHTML = '<option value="">— Select symbol —</option>';
      selB.innerHTML = '<option value="">— Select symbol —</option>';
      state.symbol  = '';
      state.symbolB = '';
      if (meta) meta.textContent = '';

      fetch('/api/exchanges/' + state.exchange + '/symbols')
        .then(function (r) { return r.json(); })
        .then(function (data) {
          var symbols = data.symbols;
          marketMetadata = data.markets || {}; // Store metadata for leverage lookup
          loading.style.display = 'none';

          if (symbols && symbols.length > 0) {
            ready.style.display = '';
            // Populate dropdown
            symbols.forEach(function (sym) {
              [selA, selB].forEach(function (sel) {
                var opt = document.createElement('option');
                opt.value = sym;
                opt.textContent = sym;
                sel.appendChild(opt);
              });
            });
            // Auto-select BTC default for this exchange
            var btcDefault = BTC_DEFAULTS[state.exchange] || (symbols[0] || '');
            // Try exact match first, then first available
            var btcIdx = symbols.indexOf(btcDefault);
            var selected = btcIdx >= 0 ? btcDefault : symbols[0];
            selA.value = selected;
            state.symbol = selected;
            if (meta) meta.textContent = 'Trading pair for ' + state.exchange.toUpperCase() + ' — ' + selected;
            if (selB) { selB.value = ''; }
            // Update leverage dropdown from market metadata
            updateLeverageFromMarket(selected);
          } else {
            // Live fetch failed or returned empty — show manual input
            fallback.style.display = '';
            var manual = document.getElementById('wz-sym-manual');
            if (manual) manual.value = BTC_DEFAULTS[state.exchange] || '';
          }
        })
        .catch(function () {
          loading.style.display = 'none';
          fallback.style.display = '';
          var manual = document.getElementById('wz-sym-manual');
          if (manual) manual.value = BTC_DEFAULTS[state.exchange] || '';
        });
    }

    // Wire select change → state + update leverage from market metadata
    document.getElementById('wz-sym-select').addEventListener('change', function () {
      state.symbol = this.value;
      hideFieldError('symbol');
      updateLeverageFromMarket(this.value);
    });
    document.getElementById('wz-sym-select-b').addEventListener('change', function () {
      state.symbolB = this.value;
      hideFieldError('symbolB');
    });
    // Manual fallback input
    document.getElementById('wz-sym-manual').addEventListener('input', function () {
      state.symbol = this.value.trim().toUpperCase();
      hideFieldError('symbol');
      updateLeverageFromMarket(state.symbol);
    });

    // Populate leverage dropdown dynamically from market metadata
    function updateLeverageFromMarket(symbol) {
      var levSelect = document.getElementById('wz-leverage');
      if (!levSelect) return;

      var meta = marketMetadata[symbol];
      // Exchange-specific defaults when API doesn't return metadata
      var exchangeDefaults = { sodex: 25, decibel: 20, dango: 10, hibachi: 20, ondoperps: 10, perpl: 20 };
      var maxLev = meta ? (meta.maxLeverage || 20) : (exchangeDefaults[state.exchange] || 20);
      var initLev = meta ? (meta.initLeverage || maxLev) : maxLev;

      // Build options: 1x, 2x, 3x, 5x, 10x, 15x, 20x, 25x (up to maxLeverage)
      var steps = [1, 2, 3, 5, 10, 15, 20, 25, 30, 40, 50].filter(function(v) { return v <= maxLev; });
      // Ensure maxLev itself is in the list
      if (steps.length === 0 || steps[steps.length - 1] !== maxLev) steps.push(maxLev);

      levSelect.innerHTML = steps.map(function(v) {
        var label = v + 'x' + (v === maxLev ? ' (Max)' : v === initLev && v !== maxLev ? ' (Default)' : '');
        var selected = v === initLev ? ' selected' : '';
        return '<option value="' + v + '"' + selected + '>' + label + '</option>';
      }).join('');
    }

    // ── Step 3: Hedge config visibility ──────────────────────────────────────
    function showHedgeConfig() {
      // Hedge/Pair bots now use DN-style config (same state machine)
      document.getElementById('wz-hedge-config').style.display = 'none'; // hide legacy pair trading fields
      document.getElementById('wz-delta-neutral-config').style.display = (state.botType === 'delta-neutral' || state.botType === 'oi-farmer' || state.botType === 'pair' || state.botType === 'hedge') ? '' : 'none';
      // Show standalone fee panel for standard/farm bots only
      var isDN = (state.botType === 'delta-neutral' || state.botType === 'oi-farmer' || state.botType === 'pair' || state.botType === 'hedge');
      var isPair = false; // deprecated — pair now routes through DN
      // Hide standard config for DN/hedge bots (they use the DN config instead)
      var stdConfig = document.getElementById('wz-standard-config');
      if (stdConfig) {
        stdConfig.style.display = isDN ? 'none' : '';
      }
      var stdFeePanel = document.getElementById('wz-standard-fee-panel');
      if (stdFeePanel) {
        stdFeePanel.style.display = !isDN ? '' : 'none';
      }
      // Auto-load hedge symbols when Delta-Neutral panel becomes visible
      if (isDN) loadHedgeSymbols();
      // Initialize hedge credentials panel + account selector on first show
      if (typeof showHedgeCreds === 'function') showHedgeCreds();

      // Hide cross-exchange fields for same-exchange hedge mode
      var crossExFields = document.getElementById('wz-dn-cross-exchange-fields');
      var crossExTitle = document.getElementById('wz-dn-cross-exchange-title');
      var isSameExchange = (state.botType === 'pair' || state.botType === 'hedge');
      if (crossExFields) crossExFields.style.display = isSameExchange ? 'none' : '';
      if (crossExTitle) crossExTitle.textContent = isSameExchange ? 'Hedge Mode (Same Exchange)' : 'Delta-Neutral -- Cross-Exchange';
    }

    // ── Delta-Neutral: Show correct credentials form for hedge exchange ──────────
    var _hedgeAccountSelected = '';

    window.showHedgeCreds = function showHedgeCreds() {
      var exchangeB = document.getElementById('wz-oi-exchangeB').value;
      ['ondoperps','sodex','hibachi','decibel','perpl'].forEach(function (ex) {
        var el = document.getElementById('wz-oi-creds-' + ex);
        if (el) el.style.display = ex === exchangeB ? '' : 'none';
      });
      // Load saved accounts for hedge exchange
      loadHedgeAccounts(exchangeB);
    };

    function loadHedgeAccounts(exchange) {
      var selector = document.getElementById('wz-oi-hedge-account-selector');
      var selectEl = document.getElementById('wz-oi-hedge-account-select');
      if (!selector || !selectEl) return;

      fetch('/api/accounts')
        .then(function(r) { return r.json(); })
        .then(function(data) {
          var accounts = (data.accounts || []).filter(function(a) { return a.exchange === exchange; });
          if (accounts.length === 0) {
            selector.style.display = 'none';
            _hedgeAccountSelected = '';
            showHedgeCredFields(true);
            return;
          }
          selector.style.display = 'block';
          selectEl.innerHTML = '<option value="">— Enter credentials manually —</option>' +
            accounts.map(function(a) {
              return '<option value="' + a.id + '">' + a.label + ' (' + a.truncatedKey + ')</option>';
            }).join('');
          _hedgeAccountSelected = '';
          showHedgeCredFields(true);
        })
        .catch(function() {
          selector.style.display = 'none';
          _hedgeAccountSelected = '';
        });
    }

    document.getElementById('wz-oi-hedge-account-select').addEventListener('change', function() {
      _hedgeAccountSelected = this.value;
      showHedgeCredFields(!_hedgeAccountSelected);
    });

    function showHedgeCredFields(show) {
      var exchangeB = document.getElementById('wz-oi-exchangeB').value;
      var credsEl = document.getElementById('wz-oi-creds-' + exchangeB);
      if (credsEl) {
        credsEl.style.opacity = show ? '1' : '0.35';
        credsEl.style.pointerEvents = show ? '' : 'none';
      }
    }

    // ── Delta-Neutral: Load symbols for hedge exchange ────────────────────────────
    window.loadHedgeSymbols = function loadHedgeSymbols() {
      var exchangeB = document.getElementById('wz-oi-exchangeB').value;
      var select = document.getElementById('wz-oi-symbolB');
      var hint = document.getElementById('wz-oi-symbolB-hint');
      if (!select) return;

      select.innerHTML = '<option value="">Loading symbols...</option>';
      select.disabled = true;
      if (hint) hint.textContent = 'Fetching symbols from ' + exchangeB + '...';

      fetch('/api/exchanges/' + exchangeB + '/symbols')
        .then(function (r) { return r.json(); })
        .then(function (data) {
          var symbols = data.symbols || [];
          select.innerHTML = '<option value="">-- Select symbol --</option>';
          symbols.forEach(function (sym) {
            var opt = document.createElement('option');
            opt.value = sym;
            opt.textContent = sym;
            select.appendChild(opt);
          });
          select.disabled = false;
          if (hint) hint.textContent = symbols.length + ' symbols available on ' + exchangeB;

          // Auto-select matching symbol if primary symbol has a close match
          if (state.symbol) {
            var base = state.symbol.replace(/-PERP$|-USD$|\/USD$|\/USDT$|USDT$/, '').toUpperCase();
            var match = symbols.find(function (s) {
              return s.toUpperCase().indexOf(base) === 0;
            });
            if (match) {
              select.value = match;
            }
          }
        })
        .catch(function (err) {
          select.innerHTML = '<option value="">Failed to load symbols</option>';
          select.disabled = false;
          if (hint) hint.textContent = 'Error: ' + err.message;
        });
    };

    // ── Step 4: Review ────────────────────────────────────────────────────────
    function buildReview() {
      try {
        var grid = document.getElementById('wz-review-grid');
        if (!grid) return;

        var modeEl = document.getElementById('wz-mode');
        var tagsEl = document.getElementById('wz-tags');
        var autoEl = document.getElementById('wz-autoStart');
        var intelEl = document.getElementById('wz-intelligence-mode');

        var mode = modeEl ? modeEl.value : 'farm';
        var tags = tagsEl ? tagsEl.value.trim() : '';
        var intel = intelEl ? intelEl.value : 'auto';

        // Auto-generated values (same logic as buildPayload)
        var exchangeNames = { sodex: 'SoDEX', decibel: 'Decibel', dango: 'Dango', hibachi: 'Hibachi', ondoperps: 'OndoPerps', perpl: 'Perpl' };
        var autoName = (exchangeNames[state.exchange] || state.exchange) + ' ' + (state.symbol || 'Bot');
        var isDN = (state.botType === 'delta-neutral' || state.botType === 'oi-farmer');
        var sizeMin = isDN
          ? (document.getElementById('wz-oi-sizeMinUsd').value || '100')
          : (document.getElementById('wz-sizeMinUsd').value || '100');
        var sizeMax = isDN
          ? (document.getElementById('wz-oi-sizeMaxUsd').value || '200')
          : (document.getElementById('wz-sizeMaxUsd').value || '200');
        var leverage = document.getElementById('wz-leverage').value || '5';
        var marginMode = document.getElementById('wz-margin-mode').value || 'cross';

        var items = [
          { label: 'Exchange',     value: state.exchange.toUpperCase(), accent: true },
          { label: 'Bot Type',     value: (state.botType === 'pair' || state.botType === 'hedge') ? 'Pair Trading' : (state.botType === 'delta-neutral' || state.botType === 'oi-farmer') ? 'Delta-Neutral' : 'Standard Bot' },
          { label: 'Bot Name',     value: autoName },
          { label: 'Symbol',       value: (state.botType === 'pair' || state.botType === 'hedge')
              ? (state.symbol || '?') + ' / ' + (state.symbolB || '?')
              : (state.symbol || '(not set)') },
          { label: 'Intelligence', value: intel === 'auto' ? 'Auto (Agent controls)' : 'Manual (' + mode + ')' },
          { label: 'Order Size',   value: '$' + sizeMin + ' - $' + sizeMax + ' USD' },
          { label: 'Leverage',     value: leverage + 'x' },
          { label: 'Margin',       value: marginMode.charAt(0).toUpperCase() + marginMode.slice(1) },
        ];
        if (tags) items.push({ label: 'Tags', value: tags });
        if (state.botType === 'hedge') {
          var lvEl = document.getElementById('wz-legValueUsd');
          items.push({ label: 'Leg Value', value: '$' + (lvEl ? lvEl.value : '1000') });
        }
        if (state.botType === 'delta-neutral' || state.botType === 'oi-farmer') {
          var oiDir = document.getElementById('wz-oi-direction');
          var oiExB = document.getElementById('wz-oi-exchangeB');
          var oiMin = document.getElementById('wz-oi-minHoldHrs');
          var oiMax = document.getElementById('wz-oi-maxHoldHrs');
          items.push({ label: 'Strategy', value: 'Delta-Neutral OI Hold', accent: true });
          items.push({ label: 'Primary (points)', value: state.exchange.toUpperCase() });
          items.push({ label: 'Hedge Exchange', value: oiExB ? oiExB.value.toUpperCase() : '?' });
          items.push({ label: 'Direction', value: oiDir ? oiDir.value : 'long' });
          items.push({ label: 'Hold Time', value: (oiMin ? oiMin.value : '4') + 'h - ' + (oiMax ? oiMax.value : '48') + 'h' });
        }
        if (autoEl && autoEl.checked) {
          items.push({ label: 'Auto-start', value: 'Yes', accent: true });
        }

        grid.innerHTML = items.map(function (item) {
          return '<div class="review-item">' +
                   '<div class="review-label">' + item.label + '</div>' +
                   '<div class="review-value' + (item.accent ? ' accent' : '') + '">' + item.value + '</div>' +
                 '</div>';
        }).join('');
      } catch (e) {
        console.error('[Wizard] buildReview error:', e);
      }
    }

    // ── Validation ────────────────────────────────────────────────────────────
    function validateStep(step) {
      clearErrors();
      var ok = true;

      if (step === 0) {
        // Exchange and type are always selected (tiles default)
        return true;
      }

      if (step === 1) {
        // Skip credential validation if a saved account is selected
        if (_wizardAccountSelected) return true;

        if (state.exchange === 'sodex') {
          if (!val('wz-apiKey'))     { showFieldError('apiKey', 'API Key is required'); ok = false; }
          if (!val('wz-subaccount')) { showFieldError('subaccount', 'Subaccount address is required'); ok = false; }
          var secret = val('wz-apiSecret');
          if (!secret) {
            showFieldError('apiSecret', 'Private key is required');
            ok = false;
          } else if (!/^0x[0-9a-fA-F]{64}$/.test(secret)) {
            showFieldError('apiSecret', 'Must be 0x-prefixed 64-char hex (e.g., 0x123abc...)');
            ok = false;
          }
        } else if (state.exchange === 'decibel') {
          if (!val('wz-privateKey')) { showFieldError('privateKey', 'Private key is required'); ok = false; }
        } else if (state.exchange === 'dango') {
          if (!val('wz-userAddress'))     { showFieldError('userAddress', 'User address is required'); ok = false; }
          if (!val('wz-dangoPrivateKey')) { showFieldError('dangoPrivateKey', 'Private key is required'); ok = false; }
        } else if (state.exchange === 'hibachi') {
          if (!val('wz-hibachiApiKey')) { showFieldError('hibachiApiKey', 'API Key is required'); ok = false; }
          if (!val('wz-hibachiAccountId')) { showFieldError('hibachiAccountId', 'Account ID is required'); ok = false; }
          var acctType = document.getElementById('wz-hibachiAccountType').value;
          if (acctType === 'trustless') {
            var pk = val('wz-hibachiPrivateKey');
            if (!pk) { showFieldError('hibachiPrivateKey', 'Private key is required'); ok = false; }
            else if (!/^0x[0-9a-fA-F]{64}$/.test(pk)) { showFieldError('hibachiPrivateKey', 'Must be 0x-prefixed 64-char hex'); ok = false; }
          } else {
            if (!val('wz-hibachiSecretKey')) { showFieldError('hibachiSecretKey', 'Secret key is required'); ok = false; }
          }
        } else if (state.exchange === 'ondoperps') {
          if (!val('wz-ondoperpsApiKeyId')) { showFieldError('ondoperpsApiKeyId', 'API Key ID is required'); ok = false; }
          if (!val('wz-ondoperpsApiKeySecret')) { showFieldError('ondoperpsApiKeySecret', 'API Key Secret is required'); ok = false; }
        } else if (state.exchange === 'perpl') {
          if (!val('wz-perplApiKey')) { showFieldError('perplApiKey', 'API Key is required'); ok = false; }
          var pk = val('wz-perplApiKeySecret');
          if (!pk) { showFieldError('perplApiKeySecret', 'Private key is required'); ok = false; }
          else if (!/^(0x)?[0-9a-fA-F]{64}$/.test(pk)) { showFieldError('perplApiKeySecret', 'Must be 64-char hex (with or without 0x prefix)'); ok = false; }
        }
        return ok;
      }

      if (step === 2) {
        if (!state.symbol) { showFieldError('symbol', 'Please select a symbol'); ok = false; }
        if (state.botType === 'hedge') {
          if (!state.symbolB) { showFieldError('symbolB', 'Please select Symbol B'); ok = false; }
          if (state.symbol && state.symbolB && state.symbol === state.symbolB) {
            showFieldError('symbolB', 'Symbol B must be different from Symbol A'); ok = false;
          }
        }
        return ok;
      }

      if (step === 3) {
        // Bot ID and Display Name are auto-generated — no validation needed
        // Validate USD sizing
        var sizeMin = parseFloat(document.getElementById('wz-sizeMinUsd').value) || 0;
        var sizeMax = parseFloat(document.getElementById('wz-sizeMaxUsd').value) || 0;
        if (sizeMin < 10) { ok = false; }
        if (sizeMax < sizeMin) { ok = false; }
        if (state.botType === 'hedge') {
          // Hedge bots now use DN config — no legacy leg value validation
        }
        if (state.botType === 'delta-neutral' || state.botType === 'oi-farmer') {
          var hedgeSym = document.getElementById('wz-oi-symbolB').value;
          if (!hedgeSym) {
            errBanner.textContent = 'Please select a hedge symbol';
            errBanner.classList.add('visible');
            ok = false;
          }
        }
        return ok;
      }

      return ok;
    }

    function val(id) {
      var el = document.getElementById(id);
      return el ? el.value.trim() : '';
    }

    function showFieldError(field, msg) {
      var errEl = document.getElementById('err-' + field);
      var inputEl = document.getElementById('wz-' + field);
      if (errEl) { errEl.textContent = msg; errEl.classList.add('visible'); errEl.style.display = ''; }
      if (inputEl) inputEl.classList.add('error');
    }

    function hideFieldError(field) {
      var errEl = document.getElementById('err-' + field);
      var inputEl = document.getElementById('wz-' + field);
      if (errEl) { errEl.classList.remove('visible'); }
      if (inputEl) inputEl.classList.remove('error');
    }

    function clearErrors() {
      errBanner.classList.remove('visible');
      document.querySelectorAll('.wz-field-error').forEach(function (e) { e.classList.remove('visible'); });
      document.querySelectorAll('.wz-input.error, .wz-select.error').forEach(function (e) { e.classList.remove('error'); });
    }

    // Clear field error on input
    document.querySelectorAll('.wz-input, .wz-select').forEach(function (el) {
      el.addEventListener('input', function () {
        el.classList.remove('error');
        var id = el.id.replace('wz-', '');
        var errEl = document.getElementById('err-' + id);
        if (errEl) errEl.classList.remove('visible');
      });
    });

    // ── Submit ────────────────────────────────────────────────────────────────
    async function submitBot() {
      clearErrors();
      nextBtn.disabled = true;
      nextBtn.textContent = 'Launching\u2026';

      try {
        var payload = buildPayload();

        // If an account was selected from the registry, fetch its credentials
        // and merge into payload (overriding any manually entered fields)
        if (_wizardAccountSelected) {
          var credRes = await fetch('/api/accounts/' + _wizardAccountSelected + '/credentials');
          if (!credRes.ok) {
            var credErr = await credRes.json();
            throw new Error('Failed to load account credentials: ' + (credErr.error || 'Unknown'));
          }
          var credData = await credRes.json();
          var acctCreds = credData.credentials || {};
          // Merge account credentials into payload (exclude 'exchange' field)
          delete acctCreds.exchange;
          Object.assign(payload, acctCreds);
        }

        // If a hedge account was selected from registry, fetch its credentials
        if (payload._hedgeAccountId) {
          var hedgeCredRes = await fetch('/api/accounts/' + payload._hedgeAccountId + '/credentials');
          if (!hedgeCredRes.ok) {
            var hedgeCredErr = await hedgeCredRes.json();
            throw new Error('Failed to load hedge account credentials: ' + (hedgeCredErr.error || 'Unknown'));
          }
          var hedgeCredData = await hedgeCredRes.json();
          var hedgeCreds = hedgeCredData.credentials || {};
          delete hedgeCreds.exchange;
          // Map credentials to hedge-prefixed fields expected by the server
          var hedgeExch = payload.exchangeB || '';
          if (hedgeExch === 'ondoperps') {
            payload.hedgeApiKeyId = hedgeCreds.apiKeyId;
            payload.hedgeApiKeySecret = hedgeCreds.apiKeySecret;
          } else if (hedgeExch === 'sodex') {
            payload.hedgeApiKey = hedgeCreds.apiKey;
            payload.hedgeApiSecret = hedgeCreds.apiSecret;
            payload.hedgeSubaccount = hedgeCreds.subaccount;
          } else if (hedgeExch === 'hibachi') {
            payload.hedgeHibachiApiKey = hedgeCreds.hibachiApiKey;
            payload.hedgeHibachiAccountId = hedgeCreds.hibachiAccountId;
            payload.hedgeHibachiPrivateKey = hedgeCreds.hibachiPrivateKey;
            payload.hedgeHibachiAccountType = hedgeCreds.hibachiAccountType || 'trustless';
          } else if (hedgeExch === 'decibel') {
            payload.hedgePrivateKey = hedgeCreds.privateKey;
          } else if (hedgeExch === 'perpl') {
            payload.hedgePerplApiKey = hedgeCreds.perplApiKey;
            payload.hedgePerplApiKeySecret = hedgeCreds.perplApiKeySecret;
          }
          delete payload._hedgeAccountId;
        }

        console.log('[Wizard] Submitting bot:', JSON.stringify(Object.assign({}, payload, {
          apiSecret: payload.apiSecret ? '***' : undefined,
          privateKey: payload.privateKey ? '***' : undefined,
          dangoPrivateKey: payload.dangoPrivateKey ? '***' : undefined,
          hibachiPrivateKey: payload.hibachiPrivateKey ? '***' : undefined,
          hibachiSecretKey: payload.hibachiSecretKey ? '***' : undefined,
        })));

        var r = await fetch('/api/bots', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        var json = await r.json();
        if (!r.ok) {
          console.error('[Wizard] Server error:', r.status, json);
          throw Object.assign(new Error(json.error || json.hint || 'Failed to create bot'), { _status: r.status, _body: json });
        }
        closeWizard();
        if (typeof refresh === 'function') refresh();
      } catch (err) {
        console.error('[Wizard] submitBot error:', err);
        err.message && (errBanner.textContent = err.message);
        errBanner.classList.add('visible');
        errBanner.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        // credential errors → go back to credentials step
        var msg = (err.message || '').toLowerCase();
        var isCredErr = msg.includes('missing credentials') || msg.includes('invalid credentials') ||
                        msg.includes('authentication failed') || msg.includes('unauthorized') ||
                        msg.startsWith('missing sodex') || msg.startsWith('missing dango') ||
                        msg.startsWith('missing decibel') || msg.startsWith('missing hibachi');
        if (isCredErr && state.botType !== 'delta-neutral' && state.botType !== 'oi-farmer') goToStep(1);
      } finally {
        nextBtn.disabled = false;
        // Only restore "Launch Bot" text if we're still on the final step.
        // If a credential error sent us back to step 1, goToStep() already set the correct text.
        if (state.step === TOTAL_STEPS - 1) {
          nextBtn.textContent = '\uD83D\uDE80 Launch Bot';
        }
      }
    }

    // Wave 3: Toggle manual mode strategy selector visibility
    window.toggleManualModeSection = function(intelligenceMode) {
      var manualSection = document.getElementById('wz-manual-mode-section');
      var hint = document.getElementById('wz-intel-hint');
      if (!manualSection) return;

      if (intelligenceMode === 'manual') {
        manualSection.style.display = '';
        if (hint) hint.textContent = 'You control strategy. Engine logs suggestions only.';
      } else {
        manualSection.style.display = 'none';
        if (hint) hint.textContent = 'Engine auto-switches Farm/Trade based on market regime';
      }
    };

    function buildPayload() {
      // Auto-generate Bot ID: exchange-symbol-timestamp (no user input needed)
      var sym = (state.symbol || 'unknown').toLowerCase().replace(/[^a-z0-9]/g, '-');
      var id = state.exchange + '-' + sym + '-' + Date.now().toString(36);
      // Auto-generate Display Name: "Exchange Symbol"
      var exchangeNames = { sodex: 'SoDEX', decibel: 'Decibel', dango: 'Dango', hibachi: 'Hibachi', ondoperps: 'OndoPerps', perpl: 'Perpl' };
      var name = (exchangeNames[state.exchange] || state.exchange) + ' ' + (state.symbol || 'Bot');
      var intelligenceMode = document.getElementById('wz-intelligence-mode').value;
      // In auto mode, default initial mode to 'farm' (engine will switch as needed)
      // In manual mode, use user-selected mode
      var mode = intelligenceMode === 'auto' ? 'farm' : document.getElementById('wz-mode').value;
      var tags = val('wz-tags').split(',').map(function (t) { return t.trim(); }).filter(Boolean);
      var autoStart = document.getElementById('wz-autoStart').checked;

      // USD-based sizing (will be converted to asset units server-side)
      var sizeMinUsd = parseFloat(document.getElementById('wz-sizeMinUsd').value) || 100;
      var sizeMaxUsd = parseFloat(document.getElementById('wz-sizeMaxUsd').value) || 200;
      var leverage = parseInt(document.getElementById('wz-leverage').value, 10) || 5;
      var marginMode = document.getElementById('wz-margin-mode').value || 'cross';

      var base = {
        id:               id,
        name:             name,
        exchange:         state.exchange,
        intelligenceMode: intelligenceMode,  // Wave 3: Auto or Manual
        credentialKey:    id,   // Bot ID — adapter already created inline from credentials
        tradeLogBackend:  'json',
        tradeLogPath:    './trades-' + id + '.json',
        tags:            tags,
        autoStart:       autoStart,
      };

      // If a saved account was selected, include accountId in payload
      if (_wizardAccountSelected) {
        base.accountId = _wizardAccountSelected;
      }

      // Attach credentials (skipped if account selected — resolved at submit time)
      if (!_wizardAccountSelected) {
      if (state.exchange === 'sodex') {
        base.apiKey    = val('wz-apiKey');
        base.apiSecret = val('wz-apiSecret');
        base.subaccount = val('wz-subaccount');
      } else if (state.exchange === 'decibel') {
        base.privateKey          = val('wz-privateKey');
        base.nodeApiKey          = val('wz-nodeApiKey');
        base.subaccount          = val('wz-decibelSubaccount');
      } else if (state.exchange === 'dango') {
        base.dangoPrivateKey = val('wz-dangoPrivateKey');
        base.userAddress     = val('wz-userAddress');
        base.network         = document.getElementById('wz-network').value;
      } else if (state.exchange === 'hibachi') {
        base.hibachiApiKey      = val('wz-hibachiApiKey');
        base.hibachiAccountId   = val('wz-hibachiAccountId');
        base.hibachiAccountType = document.getElementById('wz-hibachiAccountType').value;
        if (base.hibachiAccountType === 'trustless') {
          base.hibachiPrivateKey = val('wz-hibachiPrivateKey');
        } else {
          base.hibachiSecretKey = val('wz-hibachiSecretKey');
        }
      } else if (state.exchange === 'ondoperps') {
        base.apiKeyId     = val('wz-ondoperpsApiKeyId');
        base.apiKeySecret = val('wz-ondoperpsApiKeySecret');
        var baseUrl = val('wz-ondoperpsBaseUrl');
        if (baseUrl) base.baseUrl = baseUrl;
      } else if (state.exchange === 'perpl') {
        base.perplApiKey       = val('wz-perplApiKey');
        base.perplApiKeySecret = val('wz-perplApiKeySecret');
        var chainId = val('wz-perplChainId');
        if (chainId) base.perplChainId = chainId;
        var perplUrl = val('wz-perplBaseUrl');
        if (perplUrl) base.perplBaseUrl = perplUrl;
      }
      } // end if (!_wizardAccountSelected)

      if (state.botType === 'pair' || state.botType === 'hedge') {
        // Pair/Hedge bots now use DN-style config (same-exchange mode)
        var minHoldHrs = parseFloat(document.getElementById('wz-oi-minHoldHrs').value) || 0.5;
        var maxHoldHrs = parseFloat(document.getElementById('wz-oi-maxHoldHrs').value) || 1;
        return Object.assign({}, base, {
          botType:                'hedge',
          exchangeA:              state.exchange,
          exchangeB:              state.exchange,
          credentialKeyA:         base.credentialKey,
          credentialKeyB:         base.credentialKey,
          symbol:                 state.symbol,
          symbolA:                state.symbol,
          symbolB:                state.symbolB || state.symbol,
          legValueUsd:            parseFloat(document.getElementById('wz-oi-sizeMinUsd').value) || 150,
          orderSizeMinUsd:        parseFloat(document.getElementById('wz-oi-sizeMinUsd').value) || 150,
          orderSizeMaxUsd:        parseFloat(document.getElementById('wz-oi-sizeMaxUsd').value) || 200,
          primaryDirection:       document.getElementById('wz-oi-direction').value || 'long',
          minHoldSecs:            Math.round(minHoldHrs * 3600),
          maxHoldSecs:            Math.round(maxHoldHrs * 3600),
          maxLossUsd:             parseFloat(document.getElementById('wz-oi-maxLossUsd').value) || 15,
          takeProfitUsd:          parseFloat(document.getElementById('wz-oi-takeProfitUsd').value) || 0,
          maxDeltaDivergenceUsd:  parseFloat(document.getElementById('wz-oi-maxDelta').value) || 30,
          maxFundingRateThreshold: 0.01,
          autoFlipOnFunding:      false,
          tickIntervalSecs:       60,
          cooldownSecs:           30,
          entryMode:              document.getElementById('wz-oi-entryMode').value || 'taker',
          chunkSizeUsd:           parseFloat(document.getElementById('wz-oi-chunkSize').value) || 100,
        });
      }

      if (state.botType === 'delta-neutral' || state.botType === 'oi-farmer') {
        var hedgeExchange = document.getElementById('wz-oi-exchangeB').value;
        var oiSymbolB = document.getElementById('wz-oi-symbolB').value || state.symbol;
        var minHoldHrs = parseFloat(document.getElementById('wz-oi-minHoldHrs').value) || 4;
        var maxHoldHrs = parseFloat(document.getElementById('wz-oi-maxHoldHrs').value) || 48;
        // credentialKeyB uses the exchange name as env prefix (reads ONDOPERPS_API_KEY_ID etc from .env)
        var hedgeCredKey = hedgeExchange.toUpperCase();

        // Collect hedge exchange credentials from the inline form
        // If a saved account is selected, store its ID for credential fetch at submit time
        var hedgeCreds = {};
        if (_hedgeAccountSelected) {
          hedgeCreds._hedgeAccountId = _hedgeAccountSelected;
        } else if (hedgeExchange === 'ondoperps') {
          hedgeCreds.hedgeApiKeyId = val('wz-oi-ondoApiKeyId');
          hedgeCreds.hedgeApiKeySecret = val('wz-oi-ondoApiKeySecret');
        } else if (hedgeExchange === 'sodex') {
          hedgeCreds.hedgeApiKey = val('wz-oi-sodexApiKey');
          hedgeCreds.hedgeSubaccount = val('wz-oi-sodexSubaccount');
          hedgeCreds.hedgeApiSecret = val('wz-oi-sodexSecret');
        } else if (hedgeExchange === 'hibachi') {
          hedgeCreds.hedgeHibachiApiKey = val('wz-oi-hibachiApiKey');
          hedgeCreds.hedgeHibachiAccountId = val('wz-oi-hibachiAccountId');
          hedgeCreds.hedgeHibachiPrivateKey = val('wz-oi-hibachiPrivateKey');
          hedgeCreds.hedgeHibachiAccountType = 'trustless';
        } else if (hedgeExchange === 'decibel') {
          hedgeCreds.hedgePrivateKey = val('wz-oi-decibelKey');
        } else if (hedgeExchange === 'perpl') {
          hedgeCreds.hedgePerplApiKey = val('wz-oi-perplApiKey');
          hedgeCreds.hedgePerplApiKeySecret = val('wz-oi-perplSecret');
        }

        return Object.assign({}, base, hedgeCreds, {
          botType:                'delta-neutral',
          exchangeA:              state.exchange,
          credentialKeyA:         base.credentialKey,
          exchangeB:              hedgeExchange,
          credentialKeyB:         hedgeCredKey,
          symbol:                 state.symbol,
          symbolA:                state.symbol,
          symbolB:                oiSymbolB,
          legValueUsd:            parseFloat(document.getElementById('wz-oi-sizeMaxUsd').value) || 200,
          orderSizeMinUsd:        parseFloat(document.getElementById('wz-oi-sizeMinUsd').value) || 100,
          orderSizeMaxUsd:        parseFloat(document.getElementById('wz-oi-sizeMaxUsd').value) || 200,
          primaryDirection:       document.getElementById('wz-oi-direction').value,
          minHoldSecs:            Math.round(minHoldHrs * 3600),
          maxHoldSecs:            Math.round(maxHoldHrs * 3600),
          maxLossUsd:             parseFloat(document.getElementById('wz-oi-maxLossUsd').value) || 15,
          takeProfitUsd:          parseFloat(document.getElementById('wz-oi-takeProfitUsd').value) || 0,
          maxDeltaDivergenceUsd:  parseFloat(document.getElementById('wz-oi-maxDelta').value) || 30,
          maxFundingRateThreshold: 0.005,
          autoFlipOnFunding:      false,
          tickIntervalSecs:       60,
          cooldownSecs:           300,
          leverage:               leverage,
          entryMode:              document.getElementById('wz-oi-entryMode').value || 'taker',
          chunkSizeUsd:           parseFloat(document.getElementById('wz-oi-chunkSize').value) || 100,
        });
      }

      return Object.assign({}, base, {
        symbol:       state.symbol,
        mode:         mode,
        orderSizeMinUsd: sizeMinUsd,
        orderSizeMaxUsd: sizeMaxUsd,
        leverage:     leverage,
        marginMode:   marginMode,
      });
    }

  })();
  </script>

  <!-- ── Theme Toggle JS ── -->
  <script>
  (function () {
    function applyTheme(isLight) {
      document.body.classList.toggle('light', isLight);
      var moon = document.querySelector('.icon-moon');
      var sun  = document.querySelector('.icon-sun');
      if (moon) moon.style.display = isLight ? 'none'  : '';
      if (sun)  sun.style.display  = isLight ? ''      : 'none';
    }
    applyTheme(document.body.classList.contains('light'));
    window.toggleTheme = function () {
      var isLight = !document.body.classList.contains('light');
      localStorage.setItem('drift-theme', isLight ? 'light' : 'dark');
      applyTheme(isLight);
    };
  })();
  </script>

